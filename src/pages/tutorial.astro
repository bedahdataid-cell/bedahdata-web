---
// ============================================================================
// VIDEO TUTORIAL — daftar semua video di playlist YouTube, per kategori,
// dengan kotak pencarian. Klik gambar = video diputar di tempat (tanpa pindah
// halaman); tanpa JavaScript, gambar tetap menuju YouTube.
// Sumber data: src/data/tutorial.ts (tambah video di sana, halaman ikut).
// ============================================================================
import Layout from '../layouts/Layout.astro';
import CtaAkhir from '../components/CtaAkhir.astro';
import { SITE } from '../config';
import { KATEGORI, VIDEO, PLAYLIST_URL } from '../data/tutorial';

const title = 'Video Tutorial ERP Studio: Cara Pakai dari Nol | Bedah Data';
const description =
  'Daftar video tutorial ERP Studio yang bisa langsung diputar dan dicari: setup, produk, penjualan, pembelian, keuangan, sampai HRD. Gratis ditonton siapa saja.';

const jumlah = VIDEO.length;
const perKategori = KATEGORI.map((k) => ({ ...k, video: VIDEO.filter((v) => v.kat === k.id) })).filter(
  (k) => k.video.length > 0,
);
const tonton = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const gambar = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const cari = (v: (typeof VIDEO)[number]) => {
  const k = KATEGORI.find((x) => x.id === v.kat);
  return `${v.no} ${v.judul} ${v.ket} ${k ? k.nama : ''}`.toLowerCase();
};

const schema = {
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/tutorial#halaman`,
  name: 'Video Tutorial ERP Studio',
  description,
  url: `${SITE.url}/tutorial/`,
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---

<Layout title={title} description={description} schema={schema} adaTerjemahan={false}>
  <section class="dark-panel kepala">
    <div class="wrap-narrow">
      <span class="eyebrow terang">Video Tutorial</span>
      <h1>Belajar memakai ERP Studio lewat video</h1>
      <p>
        {jumlah} video singkat, urut dari pemasangan sampai pengelolaan tim. Cari topik yang Anda
        butuhkan, klik gambarnya, dan <mark class="stabilo">video langsung diputar di sini</mark>.
      </p>
      <p class="tombol-tengah">
        <a href="/beli/?paket=gratis" class="btn btn-primary" data-sumber="tutorial-hero-gratis">Coba Gratis 3 Hari</a>
      </p>
      <a class="tautan-playlist" href={PLAYLIST_URL} target="_blank" rel="noopener">
        Buka semua di YouTube
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="alat" id="alat-tutorial" hidden>
        <div class="kotak-cari">
          <label for="cari-tutorial" class="sr-only">Cari video tutorial</label>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <input id="cari-tutorial" type="search" placeholder="Cari: invoice, stok, karyawan, kasir" autocomplete="off" />
        </div>
        <div class="pil" role="group" aria-label="Kategori video">
          <button type="button" class="pil-btn aktif" data-kat="semua" aria-pressed="true">Semua <span>{jumlah}</span></button>
          {perKategori.map((k) => (
            <button type="button" class="pil-btn" data-kat={k.id} aria-pressed="false">{k.nama} <span>{k.video.length}</span></button>
          ))}
        </div>
        <p class="status" id="status-tutorial" role="status" aria-live="polite"></p>
      </div>

      {perKategori.map((k) => (
        <section class="grup" data-grup={k.id} aria-labelledby={`h-${k.id}`}>
          <div class="grup-kepala">
            <h2 id={`h-${k.id}`}>{k.nama}</h2>
            <p>{k.ringkas}</p>
          </div>
          <div class="grid-video">
            {k.video.map((v) => (
              <article class="card kartu" data-kat={v.kat} data-cari={cari(v)}>
                <a class="putar" href={tonton(v.id)} data-id={v.id} data-judul={v.judul} target="_blank" rel="noopener" aria-label={`Putar video: ${v.judul}`}>
                  <img src={gambar(v.id)} alt="" width="480" height="360" loading="lazy" decoding="async" />
                  <span class="tombol-putar" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
                  </span>
                  <span class="durasi">{v.durasi}</span>
                </a>
                <div class="isi">
                  <span class="nomor">{v.no}</span>
                  <h3>{v.judul}</h3>
                  <p>{v.ket}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

      <p class="kosong" id="kosong-tutorial" hidden>
        Tidak ada video yang cocok. Coba kata lain, atau <a href="/kontak/">tanyakan langsung ke kami</a>.
      </p>
    </div>
  </section>

  <CtaAkhir
    judul="Tidak menemukan yang Anda cari?"
    teks="Ceritakan apa yang ingin Anda lakukan di ERP, dan kami bantu tunjukkan caranya. Video baru terus ditambahkan."
    pesanWa="Halo Bedah Data, saya sudah lihat video tutorial tapi masih ada yang mau ditanyakan"
  />
</Layout>

<script>
  // Pencarian + filter kategori + putar di tempat. Sengaja ringan (±2 KB, tanpa pustaka).
  const alat = document.getElementById('alat-tutorial') as HTMLElement | null;
  if (alat) {
    alat.hidden = false;
    const input = document.getElementById('cari-tutorial') as HTMLInputElement;
    const status = document.getElementById('status-tutorial') as HTMLElement;
    const kosong = document.getElementById('kosong-tutorial') as HTMLElement;
    const tombol = Array.from(document.querySelectorAll<HTMLButtonElement>('.pil-btn'));
    const kartu = Array.from(document.querySelectorAll<HTMLElement>('.kartu'));
    const grup = Array.from(document.querySelectorAll<HTMLElement>('.grup'));
    let kat = 'semua';

    const terapkan = () => {
      const kata = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let tampil = 0;
      kartu.forEach((k) => {
        const cocokKat = kat === 'semua' || k.dataset.kat === kat;
        const teks = k.dataset.cari || '';
        const cocok = cocokKat && kata.every((w) => teks.includes(w));
        k.hidden = !cocok;
        if (cocok) tampil++;
      });
      grup.forEach((g) => {
        g.hidden = !g.querySelector('.kartu:not([hidden])');
      });
      kosong.hidden = tampil > 0;
      status.textContent =
        kata.length || kat !== 'semua' ? `${tampil} video ditemukan` : '';
    };

    input.addEventListener('input', terapkan);
    tombol.forEach((b) =>
      b.addEventListener('click', () => {
        kat = b.dataset.kat || 'semua';
        tombol.forEach((x) => {
          const aktif = x === b;
          x.classList.toggle('aktif', aktif);
          x.setAttribute('aria-pressed', aktif ? 'true' : 'false');
        });
        terapkan();
      }),
    );

    // dukungan tautan ?q=kata
    const q = new URLSearchParams(location.search).get('q');
    if (q) {
      input.value = q;
      terapkan();
    }

    // klik gambar = putar di tempat (klik dengan Ctrl/Cmd/tengah tetap membuka YouTube)
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.putar');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.id}?autoplay=1&rel=0`;
      f.title = a.dataset.judul || 'Video tutorial';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.className = 'bingkai';
      a.replaceWith(f);
    });
  }
</script>

<style>
  .kepala {
    padding: clamp(52px, 7vw, 82px) 0;
    text-align: center;
  }
  .kepala p {
    font-size: 17px;
    opacity: 0.93;
    margin-top: 16px;
    margin-bottom: 0;
  }
  .tombol-tengah { margin: 22px 0 0; }
  .tautan-playlist {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    color: var(--green-deep);
    font-weight: 600;
    font-size: 15px;
    border-bottom: 1.5px solid rgba(46, 204, 88, 0.55);
    padding-bottom: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .alat {
    margin-bottom: 36px;
  }
  .kotak-cari {
    position: relative;
    max-width: 560px;
    margin: 0 auto 20px;
  }
  .kotak-cari svg {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  .kotak-cari input {
    width: 100%;
    font-size: 16px; /* minimal 16px: iOS tidak memperbesar layar saat difokus */
    padding: 14px 18px 14px 46px;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    background: #fff;
    color: var(--heading);
    font-family: inherit;
  }
  .kotak-cari input:focus-visible {
    outline: 3px solid rgba(46, 204, 88, 0.35);
    border-color: var(--green-deep);
  }

  .pil {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    justify-content: center;
  }
  @media (max-width: 640px) {
    .pil {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }
    .pil-btn { flex: none; white-space: nowrap; min-height: 44px; scroll-snap-align: start; }
  }
  .pil-btn {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .pil-btn span {
    opacity: 0.65;
    margin-left: 4px;
    font-size: 12.5px;
  }
  .pil-btn:hover {
    border-color: var(--green-deep);
    color: var(--heading);
  }
  .pil-btn.aktif {
    background: var(--heading);
    border-color: var(--heading);
    color: #fff;
  }
  .status {
    text-align: center;
    margin-top: 14px;
    font-size: 14px;
    color: var(--text-muted);
    min-height: 1.4em;
  }

  /* <section> membawa padding atas-bawah global (±88px) — dinolkan supaya jarak antar kategori wajar */
  .grup {
    padding: 0;
    margin-bottom: 44px;
  }
  .grup[hidden],
  .kartu[hidden] {
    display: none;
  }
  .grup-kepala {
    margin-bottom: 18px;
  }
  .grup-kepala h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
    margin-bottom: 4px;
  }
  .grup-kepala p {
    color: var(--text-muted);
    font-size: 15px;
    margin: 0;
  }

  .grid-video {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 940px) {
    .grid-video {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .grid-video {
      grid-template-columns: 1fr;
    }
  }

  .kartu {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .putar,
  :global(.bingkai) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0e3d33;
    border: 0;
  }
  .putar {
    overflow: hidden;
  }
  .putar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tombol-putar {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(14, 61, 51, 0.82);
    color: #fff;
    transition: transform 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .putar:hover .tombol-putar,
  .putar:focus-visible .tombol-putar {
    transform: scale(1.08);
    background: var(--green-deep);
  }
  .putar:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: -3px;
  }
  .durasi {
    position: absolute;
    right: 8px;
    bottom: 8px;
    background: rgba(0, 0, 0, 0.78);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 6px;
  }
  .isi {
    padding: 16px 20px 20px;
  }
  .nomor {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--green-deep);
    background: rgba(46, 204, 88, 0.12);
    border-radius: 999px;
    padding: 4px 11px;
    margin-bottom: 10px;
  }
  .isi h3 {
    font-family: var(--font-display);
    font-size: 17.5px;
    line-height: 1.35;
    margin-bottom: 8px;
  }
  .isi p {
    font-size: 14.5px;
    color: var(--text-muted);
    margin: 0;
  }

  .kosong {
    text-align: center;
    font-size: 16.5px;
    color: var(--text-muted);
  }
  .kosong a {
    color: var(--green-deep);
    font-weight: 600;
    border-bottom: 1.5px solid rgba(46, 204, 88, 0.45);
  }
  @media (prefers-reduced-motion: reduce) {
    .tombol-putar,
    .pil-btn {
      transition: none;
    }
  }
</style>
