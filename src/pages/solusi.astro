---
// ============================================================================
// HALAMAN SOLUSI & MODUL
// Naskah modul & panel AI dipindahkan dari web/index.html lama (sudah lolos
// audit kejujuran). 🔴 Jangan menjanjikan integrasi marketplace otomatis —
// fitur itu TIDAK ADA (order tetap diinput manual).
// ============================================================================
import Layout from '../layouts/Layout.astro';
import CtaAkhir from '../components/CtaAkhir.astro';
import { SEGMEN, waLink } from '../config';

const title = 'Modul ERP Studio: Stok, Keuangan, Komisi, dan Penggajian | Bedah Data';
const description =
  'Delapan modul aplikasi pencatatan usaha ERP Studio: penjualan, pembelian, stok, keuangan, HRD dan penggajian, komisi, pelanggan (CRM), dan pesanan. Nyalakan yang perlu, lewati yang tidak.';

const modul = [
  {
    nama: 'Penjualan',
    isi: 'Dari kasir sampai faktur (invoice), semua penjualan tercatat sendiri. Anda tinggal melihat hasilnya.',
    addon: false,
  },
  {
    nama: 'Pembelian',
    isi: 'Pesanan ke pemasok dan pembayarannya jadi satu alur yang rapi. Tidak ada lagi nota tercecer.',
    addon: false,
  },
  {
    nama: 'Stok Barang (Inventaris)',
    isi: 'Tahu persis stok mana yang menipis dan mana yang lama tidak laku, lengkap dengan kartu stok dan riwayat keluar-masuknya.',
    addon: false,
  },
  {
    nama: 'Keuangan',
    isi: 'Transaksi dari modul lain otomatis masuk jurnal, jadi tidak perlu dicatat dobel. Cukup sekali mengatur akun keuangan (kami bantu), lalu laporan laba rugi dan neraca tersusun sendiri.',
    addon: false,
  },
  {
    nama: 'HRD dan Penggajian',
    isi: 'Absensi (termasuk lewat lokasi GPS), cuti, sampai gaji karyawan terhitung rapi. Tanggal gajian jadi tenang.',
    pro: true,
  },
  {
    nama: 'Pelanggan (CRM)',
    isi: 'Data pelanggan dan calon pembeli tersimpan rapi, sehingga tindak lanjut tidak lagi mengandalkan ingatan.',
    pro: true,
  },
  {
    nama: 'Komisi',
    isi: 'Komisi karyawan, reseller, dan agen terhitung sendiri, bebas dari rekap manual akhir bulan.',
    pro: true,
  },
  {
    nama: 'Pesanan',
    isi: 'Antrean pesanan terpantau dari masuk sampai selesai, untuk jasa maupun barang, dengan tahapan yang bisa disesuaikan dengan jenis usaha.',
    pro: false,
  },
];

const bidang = [
  'Toko dan Grosir',
  'Bengkel',
  'Salon dan Klinik',
  'Percetakan dan Studio',
  'Kedai Kopi',
  'Jualan Online',
  'Konveksi Rumahan',
  'Toko Roti',
  'Laundry',
  'Agensi',
  'Kursus',
];
---

<Layout title={title} description={description}>
  <section class="dark-panel kepala">
    <div class="wrap-narrow">
      <span class="eyebrow terang">Solusi</span>
      <h1>Nyalakan yang perlu, lewati yang tidak</h1>
      <p>
        ERP Studio adalah aplikasi pencatatan usaha dengan satu fondasi yang rapi. Anda tinggal
        menyalakan modul yang benar-benar dipakai. Mulai dari yang sederhana, lalu tambah seiring
        usaha tumbuh, tanpa harus mengganti aplikasi dari awal.
      </p>
    </div>
  </section>

  <!-- ===== DAFTAR MODUL ===== -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Delapan modul</span>
        <h2>Yang bisa dikerjakan ERP Studio</h2>
      </div>

      <div class="grid-modul">
        {
          modul.map((m, i) => (
            <article
              class={`card card-lift modul reveal ${m.pro ? 'pro' : ''}`}
              style={`--reveal-delay:${i * 55}ms`}
            >
              {m.pro && <span class="tanda-pro">Paket Pro</span>}
              <h3>{m.nama}</h3>
              <p>{m.isi}</p>
            </article>
          ))
        }
      </div>

      <p class="catatan reveal">
        Modul bertanda <strong>Paket Pro</strong> tersedia di paket Pro, sedangkan modul lainnya
        sudah ada di paket Standar. Modul yang tidak Anda pakai juga bisa dimatikan kapan saja,
        jadi menu yang tampil tetap ringkas sesuai cara kerja Anda.
      </p>
    </div>
  </section>

  <!-- ===== PANEL AI ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="panel-ai reveal">
        <div class="panel-teks">
          <span class="eyebrow terang">AI Decision Intelligence · Paket Pro</span>
          <h2>Usaha Anda punya teman diskusi soal angka, bukan cuma laporan yang diam</h2>
          <p>
            ERP Studio tidak berhenti di pencatatan, dan tidak berhenti di dasbor yang hanya
            bisa dilihat. Dengan AI Gemini dari Google, Anda bisa bertanya memakai bahasa
            sehari-hari, misalnya "kenapa untung bulan ini turun?" atau "produk apa yang paling
            untung?". Jawabannya disusun dari data usaha Anda sendiri, bukan jawaban umum dari
            internet. Makin sering Anda bertanya, makin paham pula Anda tentang kondisi usaha
            sendiri.
          </p>
        </div>
        <ul class="panel-daftar">
          <li>
            Tanyakan apa saja soal usaha Anda dengan bahasa sehari-hari, dan dapatkan jawaban
            langsung tanpa harus membuka laporan sendiri
          </li>
          <li>Memperkirakan penjualan bulan depan dari pola bulan-bulan sebelumnya</li>
          <li>Menandai angka yang janggal sebelum menjadi masalah besar</li>
          <li>Mengingatkan kapan dan berapa banyak barang perlu dibeli lagi</li>
          <li>Menunjukkan produk mana yang paling menguntungkan, dan mana yang hanya ramai pembeli</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== SEGMEN ===== -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Per jenis usaha</span>
        <h2>Bisa dipakai berbagai jenis usaha, juga yang masih dikerjakan sendiri</h2>
      </div>

      <ul class="pil-bidang reveal">
        {bidang.map((b) => <li>{b}</li>)}
      </ul>

      <div class="grid-segmen">
        {
          SEGMEN.map((s, i) => (
            <a
              href={`/${s.slug}/`}
              class="card card-lift segmen reveal"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <h3>{s.nama}</h3>
              <p>{s.ringkas}</p>
              <span class="tautan-panah">
                Lihat penjelasannya
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== BATAS JUJUR ===== -->
  <section class="tinted">
    <div class="wrap-narrow">
      <div class="batas reveal">
        <h2>Yang belum bisa dilakukan ERP Studio</h2>
        <p>
          Bagian ini jarang ditulis penyedia aplikasi, tapi menurut kami justru paling perlu Anda
          ketahui sebelum memutuskan.
        </p>
        <ul class="daftar-batas">
          <li>
            <strong>Belum tersambung otomatis ke marketplace.</strong> Pesanan dari Shopee atau
            Tokopedia tetap dimasukkan manual, karena aplikasi ini tidak menariknya sendiri. Kalau
            pesanan harian Anda dari marketplace sangat banyak, katakan sejak awal supaya kami bisa
            menilai dengan jujur apakah ini menolong atau justru menambah pekerjaan.
          </li>
          <li>
            <strong>Bukan untuk pabrik dengan banyak lokasi.</strong> Produksi berlapis di banyak
            lokasi pabrik masih di luar cakupan kami saat ini. Untuk produksi skala rumahan seperti
            konveksi, modul Produksi tersedia di paket Pro.
          </li>
          <li>
            <strong>Bukan pengganti akuntan.</strong> Aplikasi ini merapikan pencatatan dan
            menyusun laporannya. Untuk urusan pajak dan pemeriksaan keuangan, Anda tetap butuh
            orang yang ahli di bidang itu.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <CtaAkhir
    judul="Mau lihat modulnya bekerja langsung?"
    teks="Demo 30 menit memakai contoh alur usaha Anda sendiri, bukan presentasi umum. Gratis, dan kalau ternyata belum cocok, kami akan mengatakannya."
    pesanWa="Halo Bedah Data, saya mau lihat demo modul ERP Studio"
  />
</Layout>

<style>
  .kepala {
    padding: clamp(52px, 7vw, 82px) 0;
    text-align: center;
  }

  .kepala p {
    font-size: 17px;
    opacity: 0.93;
    margin-top: 16px;
    margin-bottom: 0;
  }

  .eyebrow.terang {
    color: #8ef0ab;
  }

  /* ---------- Modul ---------- */
  .grid-modul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  @media (max-width: 1000px) {
    .grid-modul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .grid-modul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .grid-modul {
      grid-template-columns: 1fr;
    }
  }

  .modul {
    position: relative;
  }

  .modul.pro {
    border-style: dashed;
    border-color: rgba(14, 61, 51, 0.24);
    background: var(--bg-warm);
  }

  .tanda-pro {
    position: absolute;
    top: -11px;
    right: 16px;
    background: var(--heading);
    color: #fff;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .modul h3 {
    font-size: 17px;
    margin-bottom: 7px;
  }

  .modul p {
    font-size: 14.6px;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .catatan {
    text-align: center;
    max-width: 700px;
    margin: 32px auto 0;
    font-size: 15px;
    color: var(--text-muted);
  }

  /* ---------- Panel AI ---------- */
  .panel-ai {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
    background: linear-gradient(140deg, #0e3d33, #1a6b54);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(30px, 4vw, 48px);
  }

  @media (max-width: 860px) {
    .panel-ai {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }

  .panel-ai h2 {
    color: #fff;
    font-size: clamp(22px, 2.8vw, 30px);
    margin-bottom: 14px;
  }

  .panel-ai p {
    font-size: 15.8px;
    opacity: 0.92;
    margin-bottom: 0;
  }

  .panel-daftar {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .panel-daftar li {
    position: relative;
    padding-left: 27px;
    font-size: 15px;
    opacity: 0.95;
  }

  .panel-daftar li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--green);
  }

  /* ---------- Pil bidang ---------- */
  .pil-bidang {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    list-style: none;
    margin-bottom: 40px;
  }

  .pil-bidang li {
    background: #fff;
    border: 1px solid rgba(46, 204, 88, 0.5);
    color: var(--heading);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 14.5px;
    font-weight: 500;
  }

  /* ---------- Segmen ---------- */
  .grid-segmen {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  @media (max-width: 940px) {
    .grid-segmen {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid-segmen {
      grid-template-columns: 1fr;
    }
  }

  .segmen {
    display: flex;
    flex-direction: column;
  }

  .segmen h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .segmen p {
    font-size: 14.8px;
    color: var(--text-muted);
    flex-grow: 1;
    margin-bottom: 14px;
  }

  .tautan-panah {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--green-deep);
  }

  .tautan-panah svg {
    transition: transform 0.28s var(--ease);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .segmen:hover .tautan-panah svg {
      transform: translateX(4px);
    }
  }

  /* ---------- Batas jujur ---------- */
  .batas {
    background: #fff;
    border: 1px solid var(--border);
    border-left: 4px solid var(--green);
    border-radius: var(--radius);
    padding: clamp(26px, 3.5vw, 38px);
  }

  .batas h2 {
    font-size: clamp(22px, 2.8vw, 28px);
    margin-bottom: 12px;
  }

  .batas > p {
    font-size: 15.8px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .daftar-batas {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .daftar-batas li {
    font-size: 15.5px;
    padding-left: 22px;
    position: relative;
  }

  .daftar-batas li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--green);
  }
</style>
