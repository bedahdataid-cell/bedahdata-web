---
// ============================================================================
// GENERATOR NOTA / INVOICE
// ----------------------------------------------------------------------------
// Berdiri sendiri (tidak memakai mesin Kalkulator.astro) karena bentuknya
// berbeda: daftar barang yang bisa ditambah-kurangi + pratinjau nota yang
// dicetak jadi PDF.
//
// 🔴 Seluruh proses berjalan DI BROWSER pengguna. Tidak ada data yang dikirim
//    ke server kami — ini dinyatakan terus terang di halaman, karena nota
//    berisi nama pelanggan dan angka penjualan.
//
// 🔵 Cetak PDF memakai window.print() + CSS @media print, bukan library PDF.
//    Alasannya: nol kilobyte tambahan, jalan di semua browser termasuk HP,
//    dan hasilnya teks sungguhan yang bisa dicari — bukan gambar.
// ============================================================================
import Layout from '../../../layouts/Layout.astro';
import Faq from '../../../components/Faq.astro';
import { NOTA, SEMUA_ALAT } from '../../../data/alat';
import { SITE, waLink } from '../../../config';

const urlHalaman = `${SITE.url}/alat/dokumen/nota/`;

const tautanLain = SEMUA_ALAT.filter((a) => a.slug !== NOTA.slug).slice(0, 4);

const schema = [
  {
    '@type': 'WebApplication',
    '@id': `${urlHalaman}#aplikasi`,
    name: NOTA.judul,
    url: urlHalaman,
    description: NOTA.deskripsi,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    inLanguage: 'id-ID',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'FAQPage',
    '@id': `${urlHalaman}#faq`,
    mainEntity: NOTA.faq.map((f) => ({
      '@type': 'Question',
      name: f.tanya,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.jawab.replace(/<[^>]+>/g, '').trim(),
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${urlHalaman}#remah`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Alat Gratis', item: `${SITE.url}/alat/` },
      { '@type': 'ListItem', position: 3, name: NOTA.judulPendek, item: urlHalaman },
    ],
  },
];
---

<Layout title={NOTA.judulSeo} description={NOTA.deskripsi} schema={schema}>
  <!-- ---------------- Kepala ---------------- -->
  <section class="dark-panel kepala no-print">
    <div class="wrap-narrow">
      <nav class="remah" aria-label="Anda di sini">
        <a href="/alat/">Alat Gratis</a>
        <span aria-hidden="true">›</span>
        <span>Dokumen Usaha</span>
      </nav>
      <h1>{NOTA.judul}</h1>
      <p>{NOTA.ringkas}</p>
    </div>
  </section>

  <!-- ---------------- Alat ---------------- -->
  <!-- 🔴 Section ini SENGAJA tanpa kelas `no-print`: kertas nota ada di
       dalamnya. Menandainya no-print membuat display:none menurun ke seluruh
       isinya, dan hasil cetaknya jadi halaman kosong (terbukti 5 Agu 2026).
       Bagian yang tidak boleh ikut tercetak ditandai satu per satu di dalam. -->
  <section class="blok-nota">
    <div class="wrap">
      <div class="tata" data-nota>
        <!-- ============ KOLOM ISIAN ============ -->
        <form class="isian" data-form novalidate>
          <h2 class="judul-kolom">Data toko Anda</h2>

          <div class="baris">
            <label for="toko">Nama toko / usaha</label>
            <input type="text" id="toko" data-f="toko" value="" placeholder="Toko Maju Jaya" />
          </div>

          <div class="baris">
            <label for="alamat">Alamat</label>
            <textarea id="alamat" data-f="alamat" rows="2" placeholder="Jl. Contoh No. 12, Bandung"></textarea>
          </div>

          <div class="dua">
            <div class="baris">
              <label for="telepon">Nomor yang bisa dihubungi</label>
              <input type="text" id="telepon" data-f="telepon" placeholder="0812 3456 7890" />
            </div>
            <div class="baris">
              <label for="logo">Logo <span class="opsional">opsional</span></label>
              <input type="file" id="logo" data-f="logo" accept="image/*" />
            </div>
          </div>

          <h2 class="judul-kolom pisah">Nota ini</h2>

          <div class="dua">
            <div class="baris">
              <label for="nomor">Nomor nota</label>
              <input type="text" id="nomor" data-f="nomor" placeholder="2026-08-001" />
            </div>
            <div class="baris">
              <label for="tanggal">Tanggal</label>
              <input type="date" id="tanggal" data-f="tanggal" />
            </div>
          </div>

          <div class="baris">
            <label for="pelanggan">Nama pelanggan</label>
            <input type="text" id="pelanggan" data-f="pelanggan" placeholder="Bapak Andi" />
          </div>

          <div class="baris">
            <label for="catatan">Catatan <span class="opsional">opsional</span></label>
            <textarea
              id="catatan"
              data-f="catatan"
              rows="2"
              placeholder="Terima kasih atas kepercayaan Anda."></textarea>
          </div>

          <h2 class="judul-kolom pisah">Daftar barang / jasa</h2>

          <div class="daftar-item" data-item-wadah></div>

          <button type="button" class="btn btn-ghost tombol-tambah" data-tambah>
            + Tambah baris
          </button>

          <h2 class="judul-kolom pisah">Diskon &amp; pajak</h2>

          <div class="dua">
            <div class="baris">
              <label for="diskon">Diskon (Rp)</label>
              <input type="text" inputmode="decimal" id="diskon" data-f="diskon" data-uang value="0" />
            </div>
            <div class="baris">
              <label for="pajak">Pajak (%)</label>
              <input type="text" inputmode="decimal" id="pajak" data-f="pajak" value="0" />
            </div>
          </div>
        </form>

        <!-- ============ KOLOM PRATINJAU ============ -->
        <div class="kolom-pratinjau">
          <div class="pratinjau-sticky">
            <div class="pratinjau-kepala no-print">
              <h2 class="judul-kolom">Pratinjau nota</h2>
              <button type="button" class="btn btn-primary tombol-cetak" data-cetak>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                  <path d="M6 14h12v8H6z" />
                </svg>
                Simpan / Cetak PDF
              </button>
            </div>

            <noscript>
              <p class="tanpa-js">
                Alat ini memerlukan JavaScript untuk menyusun notanya. Aktifkan JavaScript di
                browser Anda. Penjelasan tentang apa saja yang wajib ada di sebuah nota tetap
                bisa dibaca di bagian bawah halaman ini.
              </p>
            </noscript>

            <!-- 🔴 Bagian inilah yang ikut tercetak. Kelasnya dipakai CSS print. -->
            <div class="nota-kertas" data-kertas>
              <div class="nota-atas">
                <div class="nota-toko">
                  <img class="nota-logo" data-v="logo" alt="" hidden />
                  <p class="nota-nama" data-v="toko">Nama Toko</p>
                  <p class="nota-alamat" data-v="alamat"></p>
                  <p class="nota-telepon" data-v="telepon"></p>
                </div>
                <div class="nota-meta">
                  <p class="nota-judul">NOTA</p>
                  <p><span>No.</span> <strong data-v="nomor">—</strong></p>
                  <p><span>Tanggal</span> <strong data-v="tanggal">—</strong></p>
                </div>
              </div>

              <div class="nota-kepada">
                <span>Kepada</span>
                <strong data-v="pelanggan">—</strong>
              </div>

              <table class="nota-tabel">
                <thead>
                  <tr>
                    <th class="k-nama">Keterangan</th>
                    <th class="k-jml">Jml</th>
                    <th class="k-harga">Harga</th>
                    <th class="k-total">Jumlah</th>
                  </tr>
                </thead>
                <tbody data-baris-nota></tbody>
              </table>

              <div class="nota-jumlah" data-jumlah></div>

              <p class="nota-catatan" data-v="catatan"></p>

              <p class="nota-kaki">
                Nota ini dibuat dengan alat gratis di bedahdata.online
              </p>
            </div>

            <!-- 🟢 Tawaran bonus — bukan syarat memakai alatnya (spek §0). -->
            <div class="tawaran no-print">
              <p class="tawaran-teks">{NOTA.bonusWa}</p>
              <a
                href={waLink(NOTA.pesanWa)}
                class="btn btn-primary tombol-wa"
                target="_blank"
                rel="noopener"
                data-sumber="alat-nota">Tanya lewat WhatsApp</a
              >
              <p class="tawaran-catatan">
                Notanya bebas dibuat berapa pun tanpa menghubungi siapa pun. Tombol ini
                hanya kalau Anda mau bertanya.
              </p>
            </div>
          </div>
        </div>
      </div>

      <p class="catatan-privasi">
        🔒 Semua yang Anda ketik diproses di dalam browser Anda sendiri dan
        <strong>tidak dikirim ke server kami</strong>. Kami tidak bisa melihat nama toko,
        nama pelanggan, maupun angka apa pun di halaman ini. Menutup halaman akan
        menghapus isinya.
      </p>
    </div>
  </section>

  <!-- ---------------- Cara membuat nota yang benar ---------------- -->
  <section class="tinted no-print">
    <div class="wrap-narrow">
      <article class="prose penjelasan reveal" set:html={NOTA.penjelasan} />
    </div>
  </section>

  <!-- ---------------- FAQ ---------------- -->
  <section class="no-print">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Pertanyaan umum</span>
        <h2>Yang sering ditanyakan</h2>
      </div>
      <Faq items={NOTA.faq} />
    </div>
  </section>

  <!-- ---------------- Alat lain ---------------- -->
  <section class="tinted no-print">
    <div class="wrap">
      <div class="sec-head">
        <h2>Alat lain yang mungkin berguna</h2>
        <p>Semuanya bebas dipakai, tanpa perlu mendaftar.</p>
      </div>
      <div class="grid-lain">
        {
          tautanLain.map((a, i) => (
            <a href={a.href} class="card card-lift kartu-lain reveal" style={`--reveal-delay:${i * 60}ms`}>
              <h3>{a.judulPendek}</h3>
              <p>{a.ringkas}</p>
              <span class="buka">
                Buka
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------------- CTA halus ---------------- -->
  <section class="dark-panel cta-halus no-print">
    <div class="wrap-narrow isi reveal">
      <h2>Kalau notanya sudah puluhan per hari</h2>
      <p>
        Membuat nota satu per satu seperti ini cukup untuk beberapa transaksi sehari, dan
        silakan dipakai selamanya. Tapi kalau nomornya harus berurut sendiri, stok ikut
        berkurang saat barang terjual, dan piutang perlu tercatat tanpa dihitung manual —
        itu yang kami kerjakan di ERP Studio.
      </p>
      <div class="tombol">
        <a href="/solusi/" class="btn btn-primary">Lihat Cara Kerjanya</a>
        <a
          href={waLink(
            'Halo Bedah Data, saya habis pakai generator nota di website. Boleh tanya-tanya soal ERP Studio?',
          )}
          class="btn btn-onDark"
          target="_blank"
          rel="noopener"
          data-sumber="cta-alat-nota">Tanya Dulu via WhatsApp</a
        >
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // ==========================================================================
  // GENERATOR NOTA — seluruhnya berjalan di browser pengguna.
  // ==========================================================================
  (function () {
    const akar = document.querySelector('[data-nota]');
    if (!akar) return;

    const wadahItem = akar.querySelector('[data-item-wadah]');
    const barisNota = akar.querySelector('[data-baris-nota]');
    const wadahJumlah = akar.querySelector('[data-jumlah]');

    const fmtRupiah = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    });

    const keAngka = (teks) => {
      if (typeof teks !== 'string') return 0;
      const bersih = teks.replace(/[^\d,.-]/g, '').replace(/\./g, '').replace(',', '.');
      const n = parseFloat(bersih);
      return Number.isFinite(n) ? n : 0;
    };

    const rapikanRibuan = (teks) => {
      const angkaSaja = teks.replace(/[^\d]/g, '');
      if (!angkaSaja) return '';
      return angkaSaja.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    };

    const amanHtml = (teks) =>
      String(teks)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

    // --- Baris barang --------------------------------------------------------
    const buatBaris = (nama, jumlah, harga) => {
      const baris = document.createElement('div');
      baris.className = 'item';
      baris.innerHTML =
        '<input type="text" class="i-nama" placeholder="Nama barang / jasa" aria-label="Nama barang" value="' +
        (nama || '') +
        '">' +
        '<input type="text" inputmode="decimal" class="i-jml" placeholder="Jml" aria-label="Jumlah" value="' +
        (jumlah || '') +
        '">' +
        '<input type="text" inputmode="decimal" class="i-harga" placeholder="Harga" aria-label="Harga satuan" value="' +
        (harga || '') +
        '">' +
        '<button type="button" class="i-hapus" aria-label="Hapus baris ini">&times;</button>';

      baris.querySelector('.i-hapus').addEventListener('click', () => {
        baris.remove();
        // Selalu sisakan minimal satu baris supaya alatnya tidak terlihat rusak.
        if (!wadahItem.querySelector('.item')) tambahBaris();
        gambar();
      });

      baris.querySelectorAll('input').forEach((el) => {
        el.addEventListener('input', () => {
          if (el.classList.contains('i-harga')) {
            const rapi = rapikanRibuan(el.value);
            if (rapi !== el.value) el.value = rapi;
          }
          gambar();
        });
      });

      wadahItem.appendChild(baris);
      return baris;
    };

    const tambahBaris = () => buatBaris('', '', '');

    akar.querySelector('[data-tambah]').addEventListener('click', () => {
      const baris = tambahBaris();
      baris.querySelector('.i-nama').focus();
      gambar();
    });

    // --- Menggambar pratinjau ------------------------------------------------
    const isiTeks = (kunci, teks, kosong) => {
      const el = akar.querySelector('[data-v="' + kunci + '"]');
      if (!el) return;
      const nilai = String(teks || '').trim();
      el.textContent = nilai || kosong || '';
      if (!kosong) el.hidden = !nilai;
    };

    const gambar = () => {
      const ambil = (f) => {
        const el = akar.querySelector('[data-f="' + f + '"]');
        return el ? el.value : '';
      };

      isiTeks('toko', ambil('toko'), 'Nama Toko');
      isiTeks('alamat', ambil('alamat'));
      isiTeks('telepon', ambil('telepon'));
      isiTeks('nomor', ambil('nomor'), '—');
      isiTeks('pelanggan', ambil('pelanggan'), '—');
      isiTeks('catatan', ambil('catatan'));

      // Tanggal ditulis dalam format Indonesia yang mudah dibaca.
      const tgl = ambil('tanggal');
      let tglTampil = '—';
      if (tgl) {
        const d = new Date(tgl + 'T00:00:00');
        if (!isNaN(d.getTime())) {
          tglTampil = d.toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          });
        }
      }
      isiTeks('tanggal', tglTampil, '—');

      // --- Baris barang ---
      let subtotal = 0;
      const potongan = [];
      wadahItem.querySelectorAll('.item').forEach((baris) => {
        const nama = baris.querySelector('.i-nama').value.trim();
        const jml = keAngka(baris.querySelector('.i-jml').value);
        const harga = keAngka(baris.querySelector('.i-harga').value);
        if (!nama && !jml && !harga) return;

        const total = jml * harga;
        subtotal += total;
        potongan.push(
          '<tr><td class="k-nama">' +
            amanHtml(nama || '—') +
            '</td><td class="k-jml">' +
            (jml || 0) +
            '</td><td class="k-harga">' +
            fmtRupiah.format(Math.round(harga)) +
            '</td><td class="k-total">' +
            fmtRupiah.format(Math.round(total)) +
            '</td></tr>',
        );
      });

      barisNota.innerHTML =
        potongan.join('') ||
        '<tr class="kosong"><td colspan="4">Belum ada barang. Isi daftar di sebelah kiri.</td></tr>';

      // --- Jumlah ---
      const diskon = keAngka(ambil('diskon'));
      const persenPajak = keAngka(ambil('pajak'));
      const setelahDiskon = Math.max(0, subtotal - diskon);
      const nilaiPajak = setelahDiskon * (persenPajak / 100);
      const total = setelahDiskon + nilaiPajak;

      const barisJumlah = [
        '<div class="j-baris"><span>Subtotal</span><strong>' +
          fmtRupiah.format(Math.round(subtotal)) +
          '</strong></div>',
      ];
      if (diskon > 0) {
        barisJumlah.push(
          '<div class="j-baris"><span>Diskon</span><strong>−' +
            fmtRupiah.format(Math.round(diskon)) +
            '</strong></div>',
        );
      }
      if (persenPajak > 0) {
        barisJumlah.push(
          '<div class="j-baris"><span>Pajak ' +
            persenPajak +
            '%</span><strong>' +
            fmtRupiah.format(Math.round(nilaiPajak)) +
            '</strong></div>',
        );
      }
      barisJumlah.push(
        '<div class="j-baris j-total"><span>Total</span><strong>' +
          fmtRupiah.format(Math.round(total)) +
          '</strong></div>',
      );
      wadahJumlah.innerHTML = barisJumlah.join('');
    };

    // --- Logo: dibaca lokal, tidak diunggah ke mana pun ----------------------
    const inputLogo = akar.querySelector('[data-f="logo"]');
    const imgLogo = akar.querySelector('[data-v="logo"]');
    inputLogo.addEventListener('change', () => {
      const berkas = inputLogo.files && inputLogo.files[0];
      if (!berkas) {
        imgLogo.hidden = true;
        return;
      }
      const pembaca = new FileReader();
      pembaca.onload = (e) => {
        imgLogo.src = e.target.result;
        imgLogo.hidden = false;
      };
      pembaca.readAsDataURL(berkas);
    });

    // --- Pemasangan ----------------------------------------------------------
    akar.querySelectorAll('[data-f]').forEach((el) => {
      if (el.type === 'file') return;
      el.addEventListener('input', () => {
        if (el.hasAttribute('data-uang')) {
          const rapi = rapikanRibuan(el.value);
          if (rapi !== el.value) el.value = rapi;
        }
        gambar();
      });
      el.addEventListener('change', gambar);
    });

    // Tanggal hari ini sebagai nilai awal — paling sering itu yang dipakai.
    const elTanggal = akar.querySelector('[data-f="tanggal"]');
    const kini = new Date();
    elTanggal.value =
      kini.getFullYear() +
      '-' +
      String(kini.getMonth() + 1).padStart(2, '0') +
      '-' +
      String(kini.getDate()).padStart(2, '0');

    // Tiga baris kosong sebagai awalan — cukup untuk nota sederhana.
    tambahBaris();
    tambahBaris();
    tambahBaris();
    gambar();

    // --- Cetak ---------------------------------------------------------------
    // 🔴 Event `Lead` dikirim di sini, bukan saat mengetik: menekan cetak
    //    adalah tanda paling jelas bahwa alatnya benar-benar dipakai.
    akar.querySelector('[data-cetak]').addEventListener('click', () => {
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Lead', {
          content_name: 'Generator Nota',
          content_category: 'alat-gratis',
        });
      }
      window.print();
    });
  })();
</script>

<style>
  .kepala {
    padding: clamp(38px, 5vw, 60px) 0 clamp(38px, 5vw, 58px);
    text-align: center;
  }

  .remah {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 14px;
  }

  .remah a {
    color: #8ef0ab;
    font-weight: 600;
  }

  .kepala p {
    font-size: 17px;
    opacity: 0.93;
    margin-top: 15px;
    margin-bottom: 0;
    max-width: 620px;
    margin-inline: auto;
  }

  .blok-nota {
    padding-top: clamp(30px, 4vw, 44px);
  }

  .tata {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 26px;
    align-items: start;
  }

  @media (max-width: 980px) {
    .tata {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- Isian ---------------- */
  .isian {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(22px, 3vw, 30px);
  }

  .judul-kolom {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-deep);
    margin-bottom: 18px;
  }

  .judul-kolom.pisah {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }

  .baris {
    margin-bottom: 16px;
  }

  .dua {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  @media (max-width: 520px) {
    .dua {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  label {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--heading);
    margin-bottom: 7px;
