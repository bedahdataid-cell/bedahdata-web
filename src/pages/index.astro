---
// ============================================================================
// BERANDA
// 🔴 Naskah di halaman ini DIPINDAHKAN dari web/index.html lama yang sudah
//    lolos audit kejujuran (29 Jul 2026). Jangan ditulis ulang tanpa
//    persetujuan owner — perubahan kalimat adalah ranah Mbak Wulan.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import CtaAkhir from '../components/CtaAkhir.astro';
import Faq from '../components/Faq.astro';
import Harga from '../components/Harga.astro';
import GaleriFitur from '../components/GaleriFitur.astro';
import VideoFasad from '../components/VideoFasad.astro';
import { SITE, SEGMEN, PAKET, waLink, tautanBeli } from '../config';
import { FAQ_UMUM, faqSchema } from '../data/faq';

// 🔴 Harga dibaca dari config.ts (PAKET) — jangan menulis angka di halaman ini.
const standar = PAKET.find((p) => p.kunci === 'standar')!;
const pro = PAKET.find((p) => p.kunci === 'pro')!;
const angka = (h: string) => h.replace(/[^0-9]/g, '');

const title =
  'Sistem Pencatatan Stok, Keuangan & Komisi Karyawan — Bayar Sekali | Bedah Data';
// Deskripsi sengaja dijaga di bawah ±160 huruf — lebih dari itu dipotong Google.
const description = `Satu sistem untuk stok, penjualan, keuangan, dan komisi karyawan. Bayar sekali mulai ${standar.harga}, coba gratis 3 hari, data tersimpan di Google Drive usaha Anda sendiri.`;

// Hanya 5 pertanyaan teratas ditampilkan di beranda; selebihnya di /faq.
const faqBeranda = FAQ_UMUM.slice(0, 5);

const schema = [
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#software`,
    name: 'ERP Studio',
    alternateName: 'Bedah Data ERP Studio',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Enterprise Resource Planning',
    operatingSystem: 'Web (Google Workspace / Google Apps Script)',
    url: `${SITE.url}/`,
    description: `Sistem pencatatan usaha terpadu untuk usaha kecil di Indonesia — stok, penjualan, pembelian, keuangan, HRD, dan komisi karyawan dicatat sekali lalu ikut terbarui semua. Mendukung multi-pengguna dengan hak akses per peran. Lisensi bayar sekali mulai ${standar.harga}, bukan langganan bulanan. Data tersimpan di Google Drive milik pengguna sendiri.`,
    featureList: [
      'Pencatatan stok, mutasi barang, dan kartu stok',
      'Penjualan, invoice, dan POS/kasir',
      'Antrean pesanan dari masuk sampai selesai',
      'Pembelian dan pembayaran pemasok',
      'Pembukuan otomatis: jurnal, laba rugi, neraca',
      'HRD, absensi, dan penggajian (paket Pro)',
      'Perhitungan komisi teknisi, terapis, dan reseller (paket Pro)',
      'Multi-pengguna dengan hak akses per peran (RBAC)',
      'Data tersimpan di Google Drive milik pengguna',
    ],
    publisher: { '@id': `${SITE.url}/#organization` },
    offers: [
      {
        '@type': 'Offer',
        name: 'Free',
        price: '0',
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        url: `${SITE.url}/harga/`,
        description: 'Coba semua fitur gratis selama 3 hari dengan data Anda sendiri.',
      },
      {
        '@type': 'Offer',
        name: 'Standar',
        price: angka(standar.harga),
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        url: `${SITE.url}/harga/`,
        description:
          'Lisensi bayar sekali. Penjualan, Kasir, Pesanan, Pembelian, Inventaris, Keuangan, Biaya, dan Master Data. Maintenance tahun pertama gratis.',
      },
      {
        '@type': 'Offer',
        name: 'Pro',
        price: angka(pro.harga),
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        url: `${SITE.url}/harga/`,
        description:
          'Lisensi bayar sekali. Semua modul Standar ditambah HRD, Produksi, Komisi, CRM, Prospek, dan AI Decision Intelligence.',
      },
    ],
    areaServed: { '@type': 'Country', name: 'Indonesia' },
    inLanguage: 'id',
  },
  faqSchema(faqBeranda, `${SITE.url}/#faq`),
];

const masalah = [
  {
    judul: 'Stok di rak beda sama catatan',
    isi: 'Barang di rak tidak cocok dengan buku, uang di laci kurang dari seharusnya. Curiga ada yang bocor, tapi tidak ada catatan yang bisa dicek bersama.',
  },
  {
    judul: 'Komisi dihitung manual, gajian jadi telat',
    isi: 'Tiap akhir bulan menghitung komisi teknisi atau terapis dari nota dan foto WhatsApp. Lama, gampang salah, dan karyawan jadi bertanya-tanya.',
  },
  {
    judul: 'Bon pelanggan cuma ada di buku',
    isi: 'Piutang pemborong dan DP pesanan dicatat tangan. Begitu bukunya hilang atau lupa ditulis, uangnya ikut susah ditagih.',
  },
  {
    judul: 'Omzet terasa besar, yang dibawa pulang kok sedikit?',
    isi: 'Order masuk lewat WhatsApp, nota di laci, uang usaha bercampur uang pribadi. Untung yang sebenarnya tidak kelihatan sampai tutup buku, dan tutup buku jadi kerja lembur sendiri.',
  },
  {
    judul: 'Pernah pakai aplikasi, tapi ribet dan CS-nya menghilang',
    isi: 'Makin sering diperbarui makin ribet, tagihan langganan terus naik, dan saat ada masalah jawabannya cuma "tunggu 1x24 jam".',
  },
  {
    judul: 'Sudah terlanjur banyak data, mau pindah jadi berat',
    isi: 'Bertahun-tahun data dimasukkan ke aplikasi orang lain. Rasanya terkunci: berhenti langganan berarti mulai dari nol lagi.',
  },
];

const pilar = [
  {
    judul: 'Bayar sekali, jadi milik Anda',
    isi: 'Ini beli, bukan sewa. Tidak ada tagihan bulanan yang tetap datang saat toko sedang sepi. Perawatan dan pembaruan gratis di tahun pertama; sesudahnya boleh diperpanjang atau tidak, dan software tetap jalan.',
  },
  {
    judul: 'Data di Drive Anda — bukan di server kami',
    isi: 'Seluruh catatan bisnis tersimpan di Google Drive Anda sendiri, bukan server kami. Anda bisa mencadangkan, memeriksa, atau memindahkannya kapan saja tanpa minta izin siapa pun.',
  },
  {
    judul: 'Keuangan rapi sendiri, bisa ditanya pakai bahasa sehari-hari',
    isi: 'Tiap transaksi penjualan, stok, sampai penggajian otomatis masuk jurnal, jadi laba rugi dan neraca tersusun tanpa dicatat dobel (pengaturan akun keuangan cukup sekali di awal, kami bantu). Bingung membaca angkanya? Tanyakan ke AI pakai bahasa sehari-hari, dijawab berdasarkan data usaha Anda sendiri.',
  },
];

const langkah = [
  {
    judul: 'Coba gratis 3 hari',
    isi: 'Salin ERP ke Google Drive Anda sendiri dan coba dengan data Anda. Tutorial memandu langkah demi langkah, dan kalau ragu Anda bisa bertanya lewat WhatsApp. Kalau ternyata belum cocok — tidak apa-apa.',
  },
  {
    judul: 'Data lama tidak hangus',
    isi: 'Catatan dari Excel atau buku lama bisa ikut pindah ke sistem — tersedia layanan migrasi bila Anda ingin dibantu sampai benar-benar siap pakai. Anda tidak perlu mulai dari nol.',
  },
  {
    judul: 'Tidak jalan sendirian',
    isi: 'Anda langsung tergabung di grup WhatsApp pendampingan — bertanya kapan saja, dijawab orang nyata. Bila ingin lebih intensif, tersedia juga pelatihan tim sebagai layanan tambahan.',
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <!-- ===================== HERO ===================== -->
  <section class="dark-panel hero">
    <div class="wrap hero-grid">
      <div class="hero-teks">
        <span class="eyebrow terang">Aplikasi pencatatan usaha · ERP Studio</span>
        <h1>
          Stok, kas, dan komisi karyawan: <span class="aksen">catat sekali</span>, semua ikut
          terbarui.
        </h1>
        <p class="sub">
          Untuk usaha yang punya stok dan karyawan. Bayar sekali, bukan langganan. Datanya
          tersimpan di Google Drive usaha Anda sendiri, dan Anda didampingi orang nyata lewat
          WhatsApp sampai sistemnya benar-benar jalan.
        </p>
        <div class="tombol">
          <a href="/beli/?paket=gratis" class="btn btn-primary" data-sumber="hero-gratis"
            >Coba Gratis 3 Hari</a
          >
          <a
            href={waLink('Halo Bedah Data, saya mau tanya soal ERP Studio untuk usaha saya.')}
            class="btn btn-onDark"
            data-sumber="hero-wa"
            target="_blank"
            rel="noopener">Tanya lewat WhatsApp</a
          >
        </div>
        <ul class="trust-list">
          <li>Bayar sekali, bukan langganan</li>
          <li>Cukup akun Google (Gmail) yang Anda punya</li>
          <li>Data di Google Drive Anda sendiri</li>
        </ul>
      </div>
      <figure class="hero-layar">
        <img
          src="/assets/hero-dashboard.webp"
          alt="Tangkapan layar dashboard ERP Studio asli dengan data demo: ringkasan penjualan, pesanan, inventaris, keuangan, biaya, pembelian, dan pelanggan"
          width="1280"
          height="463"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>DATA DEMO · LAYAR ERP STUDIO ASLI</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== JENIS USAHA (chip) ===================== -->
  <nav class="chip-usaha" aria-label="Pilih jenis usaha">
    <div class="wrap chip-baris">
      <span class="chip-label">Usaha Anda:</span>
      {
        SEGMEN.map((sg) => (
          <a href={`/${sg.slug}/`} class="chip">
            {sg.nama}
          </a>
        ))
      }
      <a
        href={waLink('Halo Bedah Data, usaha saya jenisnya lain. Apakah ERP Studio cocok?')}
        class="chip chip-lain"
        data-sumber="chip-lain"
        target="_blank"
        rel="noopener">Usaha lain? Tanya kami</a
      >
    </div>
  </nav>

  <!-- ===================== VIDEO: KENALAN DENGAN ERP STUDIO ===================== -->
  <VideoFasad
    id="video"
    nama="beranda-erpstudio"
    judul="Kenalan dengan ERP Studio"
    durasi="1:00"
    eyebrow="Tonton dulu, 1 menit"
    heading="ERP Studio dalam satu menit"
    teks="Jualan, stok, keuangan, dan tim dalam satu sistem. Layar yang tampil adalah ERP Studio sungguhan dengan data demo."
  />

  <!-- ===================== MASALAH ===================== -->
  <section id="masalah">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Mungkin terasa familiar</span>
        <h2>Mungkin ini yang sedang Anda rasakan</h2>
      </div>

      <div class="grid-masalah">
        {
          masalah.map((m, i) => (
            <article class="card card-lift masalah reveal" style={`--reveal-delay:${i * 70}ms`}>
              <h3>{m.judul}</h3>
              <p>{m.isi}</p>
            </article>
          ))
        }
      </div>

      <p class="transisi reveal">
        Kalau ada satu saja yang terasa familiar, Anda tidak sendirian. Justru dari
        keluhan-keluhan inilah ERP Studio kami rancang.
      </p>
      <p class="transisi kecil reveal">
        Bukan karena Anda kurang teliti — tapi karena catatannya terpisah-pisah, dan tidak ada
        satu tempat yang bisa dipercaya.
      </p>
    </div>
  </section>

  <!-- ===================== FITUR UNGGULAN (layar asli) ===================== -->
  <GaleriFitur />

  <!-- ===================== PILAR / KEUNGGULAN ===================== -->
  <section class="tinted" id="keunggulan">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Yang membedakan</span>
        <h2>Tiga hal yang membedakan ERP Studio</h2>
      </div>

      <div class="grid-pilar">
        {
          pilar.map((p, i) => (
            <article class="card card-lift pilar reveal" style={`--reveal-delay:${i * 90}ms`}>
              <span class="nomor" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{p.judul}</h3>
              <p>{p.isi}</p>
            </article>
          ))
        }
      </div>

      <div class="tabel-bungkus reveal">
        <table class="banding">
          <caption class="visually-hidden">
            Perbandingan ERP langganan pada umumnya dengan ERP Studio
          </caption>
          <thead>
            <tr>
              <th scope="col">Aspek</th>
              <th scope="col">ERP Langganan pada Umumnya</th>
              <th scope="col">ERP Studio</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Model bayar</th>
              <td>Sewa — berhenti bayar, berhenti pakai</td>
              <td>Beli — sekali bayar, jadi milik Anda</td>
            </tr>
            <tr>
              <th scope="row">Lokasi data</th>
              <td>Server vendor</td>
              <td>Google Drive Anda sendiri</td>
            </tr>
            <tr>
              <th scope="row">Biaya tahun pertama</th>
              <td>Tagihan berulang tiap bulan atau tiap tahun</td>
              <td>{standar.harga} atau {pro.harga}, sekali saja</td>
            </tr>
            <tr>
              <th scope="row">Pendampingan</th>
              <td>Standar / mandiri</td>
              <td>Grup WhatsApp, dijawab orang nyata</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Visual pendukung: data tersimpan di Drive milik klien sendiri.
           Gambar ini ilustrasi metafora TANPA angka — sah menurut rules/brand.md.
           (Berbeda dari "Opsi 1"/"opsi 2" yang dicopot karena berisi angka karangan.) -->
      <div class="bukti reveal">
        <div class="bukti-gambar">
          <img
            src="/assets/drive-aman.jpg"
            alt="Ilustrasi folder Google Drive dengan dokumen data bisnis melayang keluar, disertai ikon gembok — melambangkan data bisnis tersimpan aman di Google Drive milik pengguna sendiri"
            width="900"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="bukti-teks">
          <h3>Bukan sekadar janji — begini cara kerjanya</h3>
          <p>
            Setiap catatan penjualan, stok, dan keuangan langsung tersimpan sebagai spreadsheet
            di Google Drive Anda sendiri. Bisa dibuka, dicadangkan, atau diperiksa kapan saja tanpa
            perlu minta izin ke kami — karena memang bukan kami yang menyimpannya.
          </p>
        </div>
      </div>

      <!-- Tangkapan layar ERP ASLI kini ada di galeri fitur (#fitur) — bukan rekaan.
           Kartu "cuplikan menyusul" (29 Jul 2026) dicabut 13 Nov 2026 karena sudah terpenuhi. -->
      <p class="placeholder reveal">
        <span class="ph-label">Layar asli, data demo</span>
        Ingin melihat sistemnya bekerja? Cuplikan layar ERP Studio sungguhan ada di bagian
        <a href="#fitur">Lihat sendiri</a>. Lebih yakin lagi kalau dicoba gratis 3 hari dengan data Anda.
      </p>
    </div>
  </section>

  <!-- ===================== VIDEO: TENTANG BEDAH DATA ===================== -->
  <VideoFasad
    id="tentang-kami"
    nama="beranda-tentang"
    judul="Tentang Bedah Data"
    durasi="0:58"
    eyebrow="Siapa di balik ERP Studio"
    heading="Kenapa kami membangun ini"
    teks="Cerita singkat Bedah Data: supaya pemilik usaha tahu angka usahanya sendiri, dibeli sekali, data di Drive Anda sendiri, dan didampingi orang nyata."
  />

  <!-- ===================== SEGMEN ===================== -->
  <section id="segmen">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Sesuai jenis usaha</span>
        <h2>Cari yang paling mirip usaha Anda</h2>
        <p>
          Tiap jenis usaha punya hal berbeda yang harus dicocokkan. Pilih yang paling dekat,
          nanti dijelaskan pakai bahasa usaha itu sendiri.
        </p>
      </div>

      <div class="grid-segmen">
        {
          SEGMEN.map((s, i) => (
            <a
              href={`/${s.slug}/`}
              class="card card-lift segmen reveal"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <h3>{s.nama}</h3>
              <p>{s.ringkas}</p>
              <span class="tautan-panah">
                Lihat penjelasannya
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== HARGA ===================== -->
  <section class="tinted" id="harga">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Harga</span>
        <h2>Harga terbuka, cukup bayar sekali</h2>
        <p>
          Sekali bayar, mulai {standar.harga}. Kenapa bisa segini? Sistemnya jalan di akun
          Google Anda sendiri, jadi kami tidak menyewa server untuk menyimpan data Anda. Perawatan
          tahun pertama gratis, dan software tetap jalan walau tidak diperpanjang.
        </p>
      </div>

      <Harga />

      <p class="harga-lanjut reveal">
        Butuh rincian paket, biaya maintenance, dan layanan pendamping?
        <a href="/harga/">Lihat halaman harga selengkapnya</a>.
      </p>
    </div>
  </section>

  <!-- ===================== CARA KERJA ===================== -->
  <section id="cara-kerja">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Cara mulai</span>
        <h2>Mulainya gampang, dan Anda tidak sendirian</h2>
      </div>

      <ol class="grid-langkah">
        {
          langkah.map((l, i) => (
            <li class="langkah reveal" style={`--reveal-delay:${i * 90}ms`}>
              <span class="nomor-bulat" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{l.judul}</h3>
              <p>{l.isi}</p>
            </li>
          ))
        }
      </ol>

      <ul class="poin-percaya reveal">
        <li>Berjalan di Google Workspace yang sudah Anda kenal dan percaya</li>
        <li>Didampingi langsung oleh orang nyata, bukan sekadar tiket bantuan otomatis</li>
      </ul>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="tinted" id="faq">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Pertanyaan umum</span>
        <h2>Pertanyaan yang paling sering masuk</h2>
        <p>
          Kalau yang Anda cari belum ada di sini, tanyakan saja langsung lewat WhatsApp —
          dijawab orang, bukan bot.
        </p>
      </div>

      <Faq items={faqBeranda} />

      <p class="harga-lanjut reveal">
        <a href="/faq/">Lihat semua pertanyaan &amp; jawabannya</a>
      </p>
    </div>
  </section>

  <CtaAkhir />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: clamp(56px, 8vw, 96px) 0 clamp(56px, 7vw, 88px);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(32px, 4.4vw, 54px);
    line-height: 1.12;
    margin: 14px 0 0;
  }

  .hero h1 .aksen {
    color: var(--green);
  }

  .hero .sub {
    font-size: clamp(15.8px, 1.6vw, 18px);
    opacity: 0.93;
    max-width: 560px;
    margin: 20px 0 28px;
  }

  .hero .tombol {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }

  .trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 14px;
    opacity: 0.9;
  }

  .trust-list li {
    position: relative;
    padding-left: 22px;
  }

  .trust-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--green);
    border-bottom: 2px solid var(--green);
    transform: rotate(-45deg);
  }

  .hero-layar {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.12);
    transform: perspective(1400px) rotateY(-9deg) rotateX(3deg);
    transform-origin: left center;
  }

  .hero-layar img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-layar figcaption {
    background: #0e3d33;
    color: #cfe9d8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.5px;
    padding: 8px 14px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-layar {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .hero .tombol {
      flex-direction: column;
    }
    .hero .tombol .btn {
      width: 100%;
    }
  }

  /* ---------- Chip jenis usaha ---------- */
  .chip-usaha {
    background: #fff;
    border-bottom: 1px solid var(--border);
  }

  .chip-baris {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    padding-bottom: 16px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .chip-baris::-webkit-scrollbar {
    display: none;
  }

  .chip-label {
    flex: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--heading);
  }

  .chip {
    flex: none;
    scroll-snap-align: start;
    padding: 9px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--heading);
    text-decoration: none;
    background: #fff;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }

