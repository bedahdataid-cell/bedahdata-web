---
// ============================================================================
// BERANDA
// 🔴 Naskah di halaman ini DIPINDAHKAN dari web/index.html lama yang sudah
//    lolos audit kejujuran (29 Jul 2026). Jangan ditulis ulang tanpa
//    persetujuan owner — perubahan kalimat adalah ranah Mbak Wulan.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import CtaAkhir from '../components/CtaAkhir.astro';
import Faq from '../components/Faq.astro';
import Harga from '../components/Harga.astro';
import GaleriFitur from '../components/GaleriFitur.astro';
import VideoFasad from '../components/VideoFasad.astro';
import IkonYoutube from '../components/IkonYoutube.astro';
import { SITE, SEGMEN, PAKET, PROMO, waLink, tautanBeli } from '../config';
import { FAQ_UMUM, faqSchema } from '../data/faq';
import { PERSEN_PERAWATAN, biayaPerawatan } from '../config';
const _std = PAKET.find((p) => p.kunci === 'standar')!.harga;
const _pro = PAKET.find((p) => p.kunci === 'pro')!.harga;


// 🔴 Harga dibaca dari config.ts (PAKET) — jangan menulis angka di halaman ini.
const standar = PAKET.find((p) => p.kunci === 'standar')!;
const pro = PAKET.find((p) => p.kunci === 'pro')!;
const angka = (h: string) => h.replace(/[^0-9]/g, '');

const title =
  'Aplikasi Pencatatan Stok, Keuangan, dan Komisi Karyawan: Bayar Sekali | Bedah Data';
// Deskripsi sengaja dijaga di bawah ±160 huruf — lebih dari itu dipotong Google.
const description = `Satu aplikasi pencatatan untuk stok, penjualan, keuangan, dan komisi karyawan. Bayar sekali mulai ${standar.harga}, coba gratis 3 hari, dan data tersimpan di Google Drive usaha Anda sendiri.`;

// Hanya 5 pertanyaan teratas ditampilkan di beranda; selebihnya di /faq.
const faqBeranda = FAQ_UMUM.slice(0, 6);

const schema = [
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#software`,
    name: 'ERP Studio',
    alternateName: 'Bedah Data ERP Studio',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Enterprise Resource Planning',
    operatingSystem: 'Web (Google Workspace / Google Apps Script)',
    url: `${SITE.url}/`,
    description: `Aplikasi pencatatan usaha untuk usaha kecil di Indonesia: stok, penjualan, pembelian, keuangan, HRD, dan komisi karyawan dicatat sekali lalu ikut terbarui semua. Bisa dipakai banyak pengguna dengan hak akses per peran. Lisensi bayar sekali mulai ${standar.harga}, bukan langganan bulanan. Data tersimpan di Google Drive milik pengguna sendiri.`,
    featureList: [
      'Pencatatan stok, keluar-masuk barang, dan kartu stok',
      'Penjualan, faktur (invoice), dan kasir (POS)',
      'Antrean pesanan dari masuk sampai selesai',
      'Pembelian dan pembayaran pemasok',
      'Pembukuan otomatis: jurnal, laba rugi, neraca',
      'HRD, absensi, dan penggajian (paket Pro)',
      'Perhitungan komisi teknisi, terapis, dan reseller (paket Pro)',
      'Banyak pengguna dengan hak akses per peran',
      'Data tersimpan di Google Drive milik pengguna',
    ],
    publisher: { '@id': `${SITE.url}/#organization` },
    offers: [
      {
        '@type': 'Offer',
        name: 'Free',
        price: '0',
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        url: `${SITE.url}/harga/`,
        description: 'Coba semua fitur gratis selama 3 hari dengan data Anda sendiri.',
      },
      {
        '@type': 'Offer',
        name: 'Standar',
        price: angka(standar.harga),
        priceValidUntil: PROMO.sampaiTanggal,
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        url: `${SITE.url}/harga/`,
        description:
          'Lisensi bayar sekali. Penjualan, kasir, pesanan, pembelian, stok barang, keuangan, biaya, dan data induk. Perawatan dan pembaruan tahun pertama gratis.',
      },
      {
        '@type': 'Offer',
        name: 'Pro',
        price: angka(pro.harga),
        priceValidUntil: PROMO.sampaiTanggal,
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
        url: `${SITE.url}/harga/`,
        description:
          'Lisensi bayar sekali. Semua modul Standar ditambah HRD, Produksi, Komisi, CRM, Prospek, dan AI Decision Intelligence.',
      },
    ],
    areaServed: { '@type': 'Country', name: 'Indonesia' },
    inLanguage: 'id',
  },
  faqSchema(faqBeranda, `${SITE.url}/#faq`),
];

const masalah = [
  {
    judul: 'Stok di rak berbeda dengan catatan',
    tanda: 'berbeda dengan catatan',
    isi: 'Barang di rak tidak cocok dengan buku, uang di laci kurang dari seharusnya. Curiga ada yang bocor, tapi tidak ada catatan yang bisa dicek bersama.',
  },
  {
    judul: 'Komisi dihitung manual, gajian jadi telat',
    tanda: 'gajian jadi telat',
    isi: 'Tiap akhir bulan menghitung komisi teknisi atau terapis dari nota dan foto WhatsApp. Lama, gampang salah, dan karyawan jadi bertanya-tanya.',
  },
  {
    judul: 'Bon pelanggan cuma ada di buku',
    tanda: 'cuma ada di buku',
    isi: 'Piutang pemborong dan uang muka (DP) pesanan dicatat tangan. Begitu bukunya hilang atau lupa ditulis, uangnya ikut sulit ditagih.',
  },
  {
    judul: 'Omzet terasa besar, yang dibawa pulang kok sedikit?',
    tanda: 'kok sedikit?',
    isi: 'Pesanan masuk lewat WhatsApp, nota di laci, uang usaha bercampur uang pribadi. Untung yang sebenarnya tidak kelihatan sampai tutup buku, dan tutup buku jadi kerja lembur sendiri.',
  },
  {
    judul: 'Pernah pakai aplikasi, tapi ribet dan CS-nya menghilang',
    tanda: 'CS-nya menghilang',
    isi: 'Makin sering diperbarui makin ribet, tagihan langganan terus naik, dan saat ada masalah jawabannya cuma "tunggu 1x24 jam".',
  },
  {
    judul: 'Sudah telanjur banyak data, mau pindah jadi berat',
    tanda: 'pindah jadi berat',
    isi: 'Bertahun-tahun data dimasukkan ke aplikasi orang lain. Rasanya terkunci: berhenti langganan berarti mulai dari nol lagi.',
  },
];

const pilar = [
  {
    judul: 'Bayar sekali, jadi milik Anda',
    isi: 'Anda membeli, bukan menyewa. Tidak ada tagihan bulanan yang tetap datang saat toko sedang sepi. Perawatan dan pembaruan gratis di tahun pertama. Sesudahnya boleh diperpanjang atau tidak, dan aplikasi tetap berjalan.',
  },
  {
    judul: 'Data di Drive Anda, bukan di server kami',
    isi: 'Setiap catatan penjualan, stok, dan keuangan tersimpan sebagai lembar kerja (spreadsheet) di Google Drive Anda sendiri. Semuanya bisa dibuka, dicadangkan, atau dipindahkan kapan saja tanpa meminta izin kepada kami, karena memang bukan kami yang menyimpannya.',
  },
  {
    judul: 'Keuangan rapi sendiri, bisa ditanya pakai bahasa sehari-hari',
    isi: 'Setiap transaksi penjualan, stok, sampai penggajian otomatis masuk jurnal, jadi laporan laba rugi dan neraca tersusun tanpa dicatat dobel. Pengaturan akun keuangan cukup sekali di awal, dan kami bantu. Bingung membaca angkanya? Tanyakan kepada AI dengan bahasa sehari-hari (paket Pro), dan jawabannya disusun dari data usaha Anda sendiri.',
  },
];

const langkah = [
  {
    judul: 'Coba gratis 3 hari',
    isi: 'Salin ERP Studio ke Google Drive Anda sendiri dan coba dengan data Anda. <a href="/tutorial/">Video panduan</a> memandu langkah demi langkah, dan kalau ragu Anda bisa bertanya lewat WhatsApp. Kalau ternyata belum cocok, tidak apa-apa.',
  },
  {
    judul: 'Data lama tidak hangus',
    isi: 'Catatan dari Excel atau buku lama bisa ikut dipindahkan ke aplikasi. Tersedia layanan pemindahan data berbayar bila Anda ingin dibantu sampai benar-benar siap pakai. Anda tidak perlu mulai dari nol.',
  },
  {
    judul: 'Ada yang mendampingi',
    isi: 'Anda langsung tergabung di grup WhatsApp pendampingan. Silakan bertanya kapan saja, dan pertanyaan dijawab orang sungguhan pada jam kerja. Bila ingin pendampingan lebih dalam, tersedia juga pelatihan tim sebagai layanan tambahan berbayar.',
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-teks">
        <p class="hero-kecil">Untuk bengkel, salon, toko, kedai kopi, jualan online, makanan rumahan, sampai konveksi. Dipakai sendiri atau bersama karyawan.</p>
        <h1>
          Stok, kas, dan komisi karyawan: <mark class="stabilo">catat sekali</mark>, semua ikut
          terbarui.
        </h1>
        <p class="sub">
          Bayar sekali, bukan langganan. Datanya tersimpan di Google Drive usaha Anda sendiri, dan
          Anda didampingi orang sungguhan lewat WhatsApp sampai semuanya berjalan.
        </p>
        <div class="tombol">
          <a href="/beli/?paket=gratis" class="btn btn-primary" data-sumber="hero-gratis"
            >Coba Gratis 3 Hari</a
          >
          <a
            href={waLink('Halo Bedah Data, saya mau tanya soal ERP Studio untuk usaha saya.')}
            class="btn btn-ghost"
            data-sumber="hero-wa"
            target="_blank"
            rel="noopener">Tanya lewat WhatsApp</a
          >
        </div>
        <ul class="trust-list">
          <li>Bayar sekali, bukan langganan</li>
          <li>Cukup akun Google (Gmail) yang Anda punya</li>
          <li>Data di Google Drive Anda sendiri</li>
        </ul>
      </div>

      <div class="hero-visual">
        <span class="stiker" aria-hidden="true">Bayar<br />sekali</span>
        <figure class="hero-layar" data-perbesar tabindex="0" aria-label="Perbesar tangkapan layar dasbor">
          <img
            src="/assets/hero-dashboard.webp"
            alt="Tangkapan layar dasbor ERP Studio asli dengan data demo: ringkasan penjualan, pesanan, stok, keuangan, biaya, pembelian, dan pelanggan"
            width="1280"
            height="463"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>Layar ERP Studio asli, berisi data demo</figcaption>
        </figure>
        <div class="nota-bungkus" role="img" aria-label="Contoh cara kerja: satu penjualan dicatat sekali, lalu stok, kas, dan komisi ikut terbarui">
          <div class="nota" aria-hidden="true">
            <p class="nota-judul">Nota penjualan</p>
            <p class="nota-baris">Ganti oli dan servis ringan</p>
            <p class="nota-baris redup">Dikerjakan teknisi bengkel</p>
            <span class="nota-cap">Dicatat</span>
          </div>
          <ul class="hasil" aria-hidden="true">
            <li style="--i:0">Stok oli berkurang</li>
            <li style="--i:1">Kas bertambah</li>
            <li style="--i:2">Komisi teknisi tercatat</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== JENIS USAHA (chip) ===================== -->
  <nav class="chip-usaha" aria-label="Pilih jenis usaha">
    <div class="wrap chip-baris">
      <span class="chip-label">Usaha Anda:</span>
      {
        SEGMEN.map((sg) => (
          <a href={`/${sg.slug}/`} class="chip">
            {sg.nama}
          </a>
        ))
      }
      <a
        href={waLink('Halo Bedah Data, usaha saya jenisnya lain. Apakah ERP Studio cocok?')}
        class="chip chip-lain"
        data-sumber="chip-lain"
        target="_blank"
        rel="noopener">Usaha lain? Tanya kami</a
      >
    </div>
  </nav>

  <!-- ===================== VIDEO: KENALAN DENGAN ERP STUDIO ===================== -->
  <VideoFasad
    id="video"
    nama="beranda-erpstudio"
    judul="Kenalan dengan ERP Studio"
    durasi="1:07"
    eyebrow="Tonton dulu, 1 menit"
    heading="ERP Studio dalam satu menit"
    teks="Jualan, stok, keuangan, dan tim dalam satu aplikasi. Layar yang tampil adalah ERP Studio sungguhan yang berisi data demo."
    tanda="ERP Studio sungguhan"
    sorot
    tautan={{ href: "/tutorial/", teks: "Mau lihat fiturnya satu per satu? Buka video tutorial lengkapnya" }}
  />

  <!-- ===================== MASALAH ===================== -->
  <section id="masalah">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>Mungkin ini yang sedang Anda rasakan</h2>
      </div>

      <ul class="buku-keluhan">
        {
          masalah.map((m) => (
            <li class="keluhan reveal">
              <h3>
                {m.judul.split(m.tanda)[0]}
                <mark class="stabilo">{m.tanda}</mark>
                {m.judul.split(m.tanda)[1]}
              </h3>
              <p>{m.isi}</p>
            </li>
          ))
        }
      </ul>

      <p class="transisi reveal">
        Kalau ada satu saja yang terasa familiar, Anda tidak sendirian. Justru dari
        keluhan-keluhan inilah ERP Studio kami rancang.
      </p>
      <p class="transisi kecil reveal">
        Bukan karena Anda kurang teliti, melainkan karena <mark class="stabilo">catatannya terpisah-pisah</mark>, dan tidak ada
        satu tempat yang bisa dipercaya.
      </p>
    </div>
  </section>

  <!-- ===================== FITUR UNGGULAN (layar asli) ===================== -->
  <GaleriFitur />

  <!-- ===================== PILAR / KEUNGGULAN ===================== -->
  <section class="tinted" id="keunggulan">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>Tiga hal yang <mark class="stabilo">membedakan</mark> ERP Studio</h2>
      </div>

      <div class="bento-pilar">
        {
          pilar.map((p, i) => (
            <article class={`pilar pilar-${i + 1} reveal`}>
              <h3>{p.judul}</h3>
              <p>{p.isi}</p>
              {i === 1 && (
                <img
                  src="/assets/drive-aman.jpg"
                  alt="Ilustrasi folder Google Drive dengan gembok: data usaha tersimpan di Drive milik Anda sendiri"
                  width="900"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </article>
          ))
        }
      </div>

      <div class="banding-judul reveal">
        <h3>Bandingkan sendiri: aplikasi langganan <span class="vs">vs</span> ERP Studio</h3>
        <p>Empat hal yang paling sering ditanyakan sebelum memilih aplikasi pencatatan usaha.</p>
      </div>

      <div class="tabel-bungkus reveal">
        <table class="banding">
          <caption class="visually-hidden">
            Perbandingan aplikasi langganan pada umumnya dengan ERP Studio
          </caption>
          <thead>
            <tr>
              <th scope="col">Aspek</th>
              <th scope="col">Aplikasi langganan pada umumnya</th>
              <th scope="col">ERP Studio</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Model bayar</th>
              <td data-label="Aplikasi langganan">Sewa: berhenti bayar, berhenti pakai</td>
              <td data-label="ERP Studio">Beli: bayar sekali, jadi milik Anda</td>
            </tr>
            <tr>
              <th scope="row">Lokasi data</th>
              <td data-label="Aplikasi langganan">Server penyedia aplikasi</td>
              <td data-label="ERP Studio">Google Drive Anda sendiri</td>
            </tr>
            <tr>
              <th scope="row">Biaya tahun pertama</th>
              <td data-label="Aplikasi langganan">Tagihan berulang tiap bulan atau tiap tahun</td>
              <td data-label="ERP Studio">{standar.harga} atau {pro.harga}, sekali saja</td>
            </tr>
            <tr>
              <th scope="row">Pendampingan</th>
              <td data-label="Aplikasi langganan">Tiket bantuan atau cari tahu sendiri</td>
              <td data-label="ERP Studio">Grup WhatsApp, dijawab orang sungguhan</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Tangkapan layar ERP ASLI kini ada di galeri fitur (#fitur) — bukan rekaan.
           Kartu "cuplikan menyusul" (29 Jul 2026) dicabut 13 Nov 2026 karena sudah terpenuhi. -->
      <figure class="dasbor reveal" data-perbesar tabindex="0" aria-label="Perbesar halaman dasbor">
        <img
          src="/assets/dasbor-erp.webp"
          alt="Halaman dasbor utama ERP Studio asli berisi data demo: ringkasan penjualan, pesanan, stok, keuangan, biaya, pembelian, dan pelanggan"
          width="1600"
          height="584"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span>Halaman dasbor utama ERP Studio, layar asli berisi data demo.</span>
          <a href="/tutorial/" data-sumber="beranda-tutorial"
            ><IkonYoutube />Lihat semua video tutorial</a
          >
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== VIDEO: TENTANG BEDAH DATA ===================== -->
  <VideoFasad
    id="tentang-kami"
    nama="beranda-tentang"
    judul="Tentang Bedah Data"
    durasi="0:59"
    eyebrow="Siapa di balik ERP Studio"
    heading="Kenapa kami membangun ini"
    teks="Cerita singkat Bedah Data: supaya pemilik usaha tahu angka usahanya sendiri, cukup membeli sekali, menyimpan data di Drive sendiri, dan didampingi orang sungguhan."
  />

  <!-- ===================== SEGMEN ===================== -->
  <section id="segmen">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Sesuai jenis usaha</span>
        <h2>Cari yang paling mirip usaha Anda</h2>
        <p>
          Tiap jenis usaha punya hal berbeda yang harus dicocokkan. Pilih yang paling mirip,
          dan penjelasannya memakai bahasa usaha itu sendiri.
        </p>
      </div>

      <div class="grid-segmen">
        {
          SEGMEN.map((s, i) => (
            <a
              href={`/${s.slug}/`}
              class="card card-lift segmen reveal"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <h3>{s.nama}</h3>
              <p>{s.ringkas}</p>
              <span class="tautan-panah">
                Lihat penjelasannya
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== HARGA ===================== -->
  <section class="tinted" id="harga">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>Harga terbuka, cukup bayar sekali</h2>
        <p>
          Bayar sekali, mulai {standar.harga}. Kenapa harganya segini? Aplikasinya berjalan di akun
          Google Anda sendiri, jadi kami tidak menyewa server untuk menyimpan data Anda. Perawatan
          tahun pertama gratis. Mulai tahun kedua, perpanjangan perawatan bersifat pilihan dengan biaya {PERSEN_PERAWATAN}% dari harga paket per tahun (Standar {biayaPerawatan(_std)}, Pro {biayaPerawatan(_pro)}). Aplikasi tetap berjalan walau perawatannya tidak diperpanjang.
        </p>
      </div>

      <Harga />

      <p class="harga-lanjut reveal">
        Butuh rincian paket, biaya perawatan, dan layanan pendampingan?
        <a href="/harga/">Lihat halaman harga selengkapnya</a>.
      </p>
    </div>
  </section>

  <!-- ===================== CARA KERJA ===================== -->
  <section id="cara-kerja">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Cara mulai</span>
        <h2>Mulainya mudah, dan Anda <mark class="stabilo">didampingi</mark></h2>
      </div>

      <ol class="grid-langkah">
        {
          langkah.map((l, i) => (
            <li class="langkah reveal" style={`--reveal-delay:${i * 90}ms`}>
              <span class="nomor-bulat" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{l.judul}</h3>
              <p set:html={l.isi} />
            </li>
          ))
        }
      </ol>

      <ul class="poin-percaya reveal">
        <li>Berjalan di layanan Google yang sudah Anda kenal, cukup dengan akun Gmail biasa</li>
        <li>Didampingi langsung oleh orang sungguhan, bukan sekadar tiket bantuan otomatis</li>
      </ul>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="tinted" id="faq">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>Pertanyaan yang paling sering masuk</h2>
        <p>
          Kalau yang Anda cari belum ada di sini, tanyakan saja langsung lewat WhatsApp.
          <mark class="stabilo">Dijawab orang sungguhan</mark>, bukan bot.
        </p>
      </div>

      <Faq items={faqBeranda} />

      <p class="harga-lanjut reveal">
        <a href="/faq/">Lihat semua pertanyaan dan jawabannya</a>
      </p>
    </div>
  </section>

  <CtaAkhir />
</Layout>

<style>
  /* ---------- Hero: terang, bergaris tipis seperti buku kas ---------- */
  .hero {
    position: relative;
    padding: clamp(48px, 7vw, 92px) 0 clamp(56px, 7vw, 96px);
    background:
      radial-gradient(900px 480px at 85% 10%, rgba(46, 204, 88, 0.14), transparent 70%),
      radial-gradient(700px 420px at 0% 100%, rgba(255, 107, 44, 0.12), transparent 70%),
      repeating-linear-gradient(to bottom, transparent 0 39px, rgba(14, 61, 51, 0.035) 39px 40px),
      var(--bg);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .hero-kecil {
    font-size: 15.5px;
    font-weight: 500;
    color: var(--green-deep);
    max-width: 520px;
    margin-bottom: 18px;
  }

  .hero h1 {
    font-size: clamp(34px, 4.6vw, 58px);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .hero .sub {
    font-size: clamp(16px, 1.6vw, 18.5px);
    color: var(--text);
    max-width: 540px;
