---
// ============================================================================
// HALAMAN SEGMEN — satu berkas ini menghasilkan SEMUA halaman jenis usaha
// (/bengkel, /salon, /percetakan, /toko-bangunan).
//
// Untuk menambah segmen baru: cukup tambahkan datanya di src/data/segmen.ts
// dan src/config.ts — halamannya terbuat sendiri. Tidak perlu menyentuh
// berkas ini.
// ============================================================================
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import CtaAkhir from '../components/CtaAkhir.astro';
import Harga from '../components/Harga.astro';
import { SITE, waLink } from '../config';
import { SEGMEN_ISI } from '../data/segmen';
import { faqSchema } from '../data/faq';
import { PAKET, PERSEN_PERAWATAN, biayaPerawatan } from '../config';
const _std = PAKET.find((p) => p.kunci === 'standar')!.harga;
const _pro = PAKET.find((p) => p.kunci === 'pro')!.harga;


export const getStaticPaths = (() => {
  return SEGMEN_ISI.map((isi) => ({
    params: { segmen: isi.slug },
    props: { isi },
  }));
}) satisfies GetStaticPaths;

const { isi } = Astro.props;

// Klip layar ERP ASLI (data demo) yang paling relevan per jenis usaha.
const KLIP: Record<string, { v: string; judul: string }> = {
  bengkel: { v: 'fitur-komisi', judul: 'Komisi teknisi dihitung otomatis' },
  salon: { v: 'fitur-komisi', judul: 'Komisi terapis dihitung otomatis' },
  percetakan: { v: 'fitur-pesanan', judul: 'Pesanan dipantau dari masuk sampai selesai' },
  'toko-bangunan': { v: 'fitur-stok', judul: 'Barang terjual, stok langsung berkurang' },
  'kedai-kopi': { v: 'fitur-stok', judul: 'Barang terjual, stok langsung berkurang' },
  'jualan-online': { v: 'fitur-pesanan', judul: 'Pesanan dipantau dari masuk sampai selesai' },
  konveksi: { v: 'fitur-pesanan', judul: 'Pesanan dipantau dari masuk sampai selesai' },
  'makanan-rumahan': { v: 'fitur-keuangan', judul: 'Penjualan tercatat sendiri, laba rugi tinggal klik' },
};
const klip = KLIP[isi.slug] ?? { v: 'fitur-keuangan', judul: 'Penjualan tercatat sendiri' };

// Segmen lain, untuk saling menautkan di bagian bawah halaman.
const lainnya = SEGMEN_ISI.filter((s) => s.slug !== isi.slug);

const schema = [
  faqSchema(isi.faq, `${SITE.url}/${isi.slug}#faq`),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Solusi', item: `${SITE.url}/solusi` },
      {
        '@type': 'ListItem',
        position: 3,
        name: isi.nama,
        item: `${SITE.url}/${isi.slug}`,
      },
    ],
  },
];
---

<Layout title={isi.title} description={isi.description} schema={schema}>
  <!-- ===== KEPALA ===== -->
  <section class="dark-panel kepala">
    <div class="wrap-narrow">
      <nav class="remah" aria-label="Anda di sini">
        <a href="/">Beranda</a>
        <span aria-hidden="true">›</span>
        <a href="/solusi/">Solusi</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{isi.nama}</span>
      </nav>
      <h1>{isi.h1}</h1>
      <p class="intro">{isi.intro}</p>
      <div class="tombol">
        <a href="/beli/?paket=gratis" class="btn btn-primary" data-sumber={`segmen-${isi.slug}-gratis`}>
          Coba Gratis 3 Hari
        </a>
        <a href={waLink(isi.pesanWa)} class="btn btn-onDark" target="_blank" rel="noopener" data-sumber={`segmen-${isi.slug}-wa`}>Tanya lewat WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ===== BUKTI: layar ERP asli ===== -->
  <section class="bukti-layar">
    <div class="wrap-narrow">
      <figure class="klip-bukti">
        <video muted loop playsinline autoplay preload="metadata" poster={`/video/${klip.v}.webp`} aria-label={`Cuplikan layar ERP Studio: ${klip.judul} (data demo)`}>
          <source src={`/video/${klip.v}.webm`} type="video/webm" />
          <source src={`/video/${klip.v}.mp4`} type="video/mp4" />
        </video>
        <figcaption><strong>{klip.judul}.</strong> DATA DEMO · layar ERP Studio asli</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== KELUHAN ===== -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Yang sering terjadi</span>
        <h2>Kalau ini terdengar familiar, Anda tidak sendirian</h2>
      </div>

      <div class="grid-dua">
        {
          isi.keluhan.map((k, i) => (
            <article class="card card-lift keluhan reveal" style={`--reveal-delay:${i * 70}ms`}>
              <h3>{k.judul}</h3>
              <p>{k.isi}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== PENANGANAN ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Cara ERP Studio membantu</span>
        <h2>Yang berubah setelah dicatat di satu tempat</h2>
      </div>

      <div class="grid-dua">
        {
          isi.penanganan.map((p, i) => (
            <article
              class="card card-lift penanganan reveal"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="nomor" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{p.judul}</h3>
              <p>{p.isi}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== SYARAT KECOCOKAN (penyaring jujur) =====
       🔴 Bagian ini SENGAJA ada untuk menyaring calon yang belum cocok
       sebelum memakan jam layanan. Jangan dihapus demi "menjaring lebih
       banyak" — justru inilah yang melindungi kapasitas owner. -->
  <section>
    <div class="wrap">
      <div class="kecocokan reveal">
        <div class="kolom cocok">
          <h2>Cocok kalau usaha Anda seperti ini</h2>
          <ul class="checklist">
            {isi.cocok.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div class="kolom belum">
          <h2>Kapan belum perlu</h2>
          <p>{isi.belumCocok}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HARGA ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Harga</span>
        <h2>Bayar sekali, bukan langganan bulanan</h2>
        <p>
          Harga yang sama untuk semua jenis usaha. Perawatan dan pembaruan tahun pertama gratis.
          Mulai tahun kedua, perpanjangan perawatan bersifat pilihan dengan biaya {PERSEN_PERAWATAN}% dari harga paket per tahun (Standar {biayaPerawatan(_std)}, Pro {biayaPerawatan(_pro)}). Aplikasi tetap berjalan walau perawatan tidak diperpanjang.
        </p>
      </div>
      <p class="catatan-paket reveal">
        <strong>Paket mana?</strong> Penjualan, stok, dan keuangan ada di <strong>Standar</strong>. Komisi karyawan, HRD,
        produksi, dan pengelolaan pelanggan ada di <strong>Pro</strong>. Coba gratis 3 hari membuka <em>semua</em> fitur,
        jadi cobalah dulu sebelum memilih.
      </p>
      <Harga />
      <p class="lanjut reveal">
        <a href="/harga/">Lihat rincian paket dan layanan pendampingan</a>
      </p>
    </div>
  </section>

  <!-- ===== FAQ SEGMEN ===== -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Pertanyaan khusus {isi.nama.toLowerCase()}</span>
        <h2>Yang sering ditanyakan</h2>
      </div>
      <Faq items={isi.faq} />
      <p class="lanjut reveal">
        <a href="/faq/">Lihat pertanyaan umum lainnya</a>
      </p>
    </div>
  </section>

  <!-- ===== SEGMEN LAIN ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>Usaha Anda bukan {isi.nama.toLowerCase()}?</h2>
        <p>Lihat penjelasan untuk jenis usaha yang lain.</p>
      </div>
      <div class="grid-lain">
        {
          lainnya.map((s, i) => (
            <a
              href={`/${s.slug}/`}
              class="card card-lift lain reveal"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <h3>{s.nama}</h3>
              <span class="tautan-panah">
                Lihat
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaAkhir
    judul={`Mau lihat cara kerjanya untuk ${isi.nama.toLowerCase()}?`}
    teks="Demo 30 menit memakai contoh alur usaha Anda sendiri. Gratis dan tanpa ikatan. Kalau ternyata belum cocok, kami akan mengatakannya terus terang."
    pesanWa={isi.pesanWa}
  />
</Layout>

<style>
  @media (max-width: 640px) {
    section:not(.kepala) { padding: 36px 0; }
    .sec-head { margin-bottom: 20px; }
  }

  .bukti-layar { padding: 28px 0 8px; }
  .klip-bukti { margin: 0; }
  .klip-bukti video { width: 100%; border-radius: 12px; border: 1px solid var(--border, #dfe7e3); background: #0e3d33; display: block; }
  .klip-bukti figcaption { font-size: 14px; color: var(--text-muted); text-align: center; margin-top: 10px; }

  .kepala {
    padding: clamp(46px, 6.5vw, 76px) 0;
  }

  .remah {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    opacity: 0.8;
    margin-bottom: 18px;
  }

  .remah a {
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
  }

  .remah a:hover {
    border-bottom-color: #fff;
  }

  .intro {
    font-size: 17px;
    opacity: 0.93;
    margin: 18px 0 28px;
    max-width: 660px;
  }

  .tombol {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .catatan-paket {
    max-width: 720px;
    margin: 0 auto 22px;
    text-align: center;
    font-size: 15px;
    color: var(--text-muted);
  }

  /* Android kecil: tombol naik ke bawah judul (audit UX 15 Nov 2026, T1) */
  @media (max-width: 480px) and (max-height: 760px) {
    .kepala .wrap-narrow { display: flex; flex-direction: column; }
    .kepala .remah { order: 0; }
    .kepala h1 { order: 1; }
    .kepala .tombol { order: 2; margin-top: 18px; }
    .kepala .intro { order: 3; margin: 22px 0 0; font-size: 16px; }
  }

  @media (max-width: 480px) {
    .tombol {
      flex-direction: column;
    }
    .tombol .btn {
      width: 100%;
    }
  }

  /* ---------- Grid dua kolom ---------- */
  .grid-dua {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 760px) {
    .grid-dua {
      grid-template-columns: 1fr;
    }
  }

  .keluhan {
    border-left: 4px solid var(--green);
  }

  .keluhan h3,
  .penanganan h3 {
    font-size: 17.5px;
    margin-bottom: 9px;
  }

  .keluhan p,
  .penanganan p {
    font-size: 15px;
    margin-bottom: 0;
  }

  .penanganan .nomor {
    display: block;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    color: rgba(46, 204, 88, 0.4);
    line-height: 1;
    margin-bottom: 10px;
  }

  .penanganan h3 {
    color: var(--green-deep);
  }

  /* ---------- Kecocokan ---------- */
  .kecocokan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 980px;
    margin-inline: auto;
  }

  @media (max-width: 820px) {
    .kecocokan {
      grid-template-columns: 1fr;
    }
  }

  .kolom {
    padding: 30px 28px;
    border-radius: var(--radius-lg);
  }

  .kolom h2 {
    font-size: clamp(19px, 2.4vw, 23px);
    margin-bottom: 16px;
  }

  .cocok {
    background: rgba(46, 204, 88, 0.08);
    border: 1px solid rgba(46, 204, 88, 0.35);
  }

  .belum {
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .belum p {
    font-size: 15.5px;
    margin-bottom: 0;
  }

  /* ---------- Penutup ---------- */
  .lanjut {
    text-align: center;
    margin-top: 32px;
    font-size: 16px;
  }

  .lanjut a {
    color: var(--green-deep);
    font-weight: 600;
    border-bottom: 1.5px solid rgba(46, 204, 88, 0.45);
  }

  .lanjut a:hover {
    color: var(--heading);
    border-bottom-color: var(--heading);
  }

  .grid-lain {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 760px) {
    .grid-lain {
      grid-template-columns: 1fr;
    }
  }

  .lain {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 20px 24px;
  }

  .lain h3 {
    font-size: 16.5px;
    margin: 0;
  }

  .tautan-panah {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--green-deep);
    white-space: nowrap;
  }

  .tautan-panah svg {
    transition: transform 0.28s var(--ease);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .lain:hover .tautan-panah svg {
      transform: translateX(4px);
    }
  }
</style>
