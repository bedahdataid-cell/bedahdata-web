---
// ============================================================================
// HALAMAN HARGA
// 🟢 Struktur resmi sejak 12 Nov 2026: Free (3 hari) / Standar / Pro, plus jalur
//    Custom lewat WhatsApp. Tanpa bundle & tanpa add-on satuan. Model 8 paket
//    per-industri SUDAH DIHAPUS — jangan dimunculkan lagi.
// 🔴 Harga dibaca dari config.ts (PAKET) — jangan menulis angka di halaman ini.
// 🔴 Angka Custom TIDAK dipublikasikan — arahkan ke WhatsApp.
// 🔴 Kata "terjangkau" sudah dicabut resmi — jangan dipakai di halaman ini.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import Harga from '../components/Harga.astro';
import CtaAkhir from '../components/CtaAkhir.astro';
import Faq from '../components/Faq.astro';
import { CUSTOM, PAKET, SITE, waLink } from '../config';
import { faqSchema } from '../data/faq';

const standar = PAKET.find((p) => p.kunci === 'standar')!;
const pro = PAKET.find((p) => p.kunci === 'pro')!;

const title = `Harga ERP Studio — Bayar Sekali Mulai ${standar.harga} | Bedah Data`;
const description = `Rincian harga ERP Studio: coba gratis 3 hari, paket Standar ${standar.harga} dan Pro ${pro.harga}, sekali bayar bukan langganan. Termasuk maintenance dan layanan pendamping.`;

const faqHarga = [
  {
    tanya: 'Apa yang terjadi kalau maintenance tidak diperpanjang?',
    jawab:
      '<p><strong>Software tetap berjalan.</strong> Maintenance mengurus pembaruan sistem, perbaikan, dan dukungan teknis dari kami — bukan saklar yang menyalakan aplikasi Anda. Kalau tidak diperpanjang, sistem yang sudah ada tetap bisa dipakai seperti biasa; yang berhenti hanyalah layanan perawatan dan pengembangan dari pihak kami.</p>',
  },
  {
    tanya: 'Kenapa ada biaya tambahan di luar harga paket?',
    jawab:
      '<p>Karena tidak semua orang membutuhkannya, dan kami tidak mau membebankan biaya jasa ke orang yang bisa mengerjakannya sendiri. Harga paket sudah mencakup software-nya. Yang terpisah adalah <strong>pekerjaan manusia</strong>: setup jarak jauh, memindahkan data lama dari Excel, dan pelatihan tim. Semuanya opsional, dan angkanya kami sampaikan terbuka di awal — bukan muncul di tengah jalan.</p>',
  },
  {
    tanya: 'Beda Standar dan Pro apa persisnya?',
    jawab:
      '<p>Paket <strong>Standar</strong> berisi modul inti: penjualan, kasir, pesanan, pembelian, inventory, keuangan, dan master data. Paket <strong>Pro</strong> berisi semuanya itu ditambah HRD (absensi dan penggajian), produksi, Komisi, CRM, Prospek, dan AI Decision Intelligence. Tidak ada fitur yang dijual satuan: kalau Anda butuh salah satunya, pilihannya naik ke Pro.</p>',
  },
  {
    tanya: 'Bisa mulai dari Standar lalu naik ke Pro nanti?',
    jawab:
      '<p>Bisa. Naik ke Pro cukup dengan membeli kode Pro lalu memasukkannya ke ERP Anda. Tidak perlu memasang ulang sistem dan data Anda tetap utuh. Kalau ragu, coba gratis 3 hari dulu, lalu pilih paket yang pas.</p>',
  },
  {
    tanya: 'Ada garansi uang kembali?',
    jawab:
      '<p>Kami tidak memasang skema garansi uang kembali. Sebagai gantinya, Anda bisa <strong>mencoba gratis 3 hari</strong> dengan data Anda sendiri sebelum membayar sepeser pun — supaya keputusannya diambil setelah mencoba, bukan setelah membaca janji.</p>',
  },
];

const schema = faqSchema(faqHarga, `${SITE.url}/harga#faq`);
---

<Layout title={title} description={description} schema={schema}>
  <section class="dark-panel kepala">
    <div class="wrap-narrow">
      <span class="eyebrow terang">Harga</span>
      <h1>Bayar sekali. Bukan sewa bulanan.</h1>
      <p>
        ERP Studio cukup sekali bayar, mulai {standar.harga}. Coba gratis 3 hari dulu. Kenapa bisa
        segini? Sistemnya jalan di akun Google Anda sendiri, jadi kami tidak menyewa server untuk
        menyimpan data Anda. Perawatan tahun pertama gratis, dan software tetap jalan walau tidak
        diperpanjang.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Harga />

      <p class="reveal" style="text-align:center;margin-top:24px">
        Belum tahu cara memasangnya? <a href="/mulai/">Lihat panduan mulai</a>.
      </p>

      <div class="hitungan reveal">
        <h2>Hitungan sederhananya begini</h2>
        <p>
          ERP langganan populer umumnya mulai sekitar Rp 3,6 juta per tahun — dalam 3 tahun
          sudah lebih dari Rp 10 juta, dan terus berjalan. Paket Pro: {pro.harga}, sekali.
        </p>
        <p>
          Semua harga bayar sekali, dan maintenance tahun pertama gratis. Bila dibutuhkan,
          tersedia juga layanan pendamping opsional (setup remote, migrasi data dari Excel, dan
          pelatihan tim) dengan biaya terpisah yang kami sampaikan terbuka di awal.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== JALUR CUSTOM & BATAS ERP ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="custom-blok card reveal">
        <span class="eyebrow">Jalur lain</span>
        <h2>{CUSTOM.judul}</h2>
        <p>{CUSTOM.teks}</p>
        <p class="tombol-tengah">
          <a href={waLink(CUSTOM.pesanWa)} class="btn btn-ghost" target="_blank" rel="noopener" data-sumber="harga-custom">{CUSTOM.cta}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== YANG PERLU DIKETAHUI SEBELUM MEMBELI ===== -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Terus terang</span>
        <h2>Sebelum Anda memutuskan membeli</h2>
        <p>
          Bagian ini sengaja kami tulis, walau isinya bisa membuat sebagian orang mengurungkan
          niat. Kami lebih suka begitu daripada Anda menyesal setelah membayar.
        </p>
      </div>

      <div class="grid-jujur">
        <div class="card jujur reveal">
          <h3>Sistem ini belum tentu untuk Anda</h3>
          <p>
            Kalau usaha masih Anda pegang sendiri dan tidak ada yang perlu dicocokkan antar
            orang, yang Anda butuhkan adalah catatan sederhana — bukan sistem 8 modul. Untuk
            itu, aplikasi pencatatan gratis sudah cukup baik, dan kami akan mengatakannya
            langsung saat demo.
          </p>
        </div>
        <div class="card jujur reveal" style="--reveal-delay:80ms">
          <h3>Yang kami janjikan, dan yang tidak</h3>
          <p>
            Kami tidak menjanjikan omzet Anda naik. Yang kami kerjakan adalah membuat angkanya
            jelas dan siap dipakai memutuskan — soal keputusannya, itu tetap milik Anda dan
            memang seharusnya begitu.
          </p>
        </div>
        <div class="card jujur reveal" style="--reveal-delay:160ms">
          <h3>Pindah sistem butuh usaha</h3>
          <p>
            Pindah dari buku atau Excel tidak selesai dalam satu sore. Ada data yang harus
            dirapikan dan tim yang harus terbiasa. Kami mendampingi prosesnya, tapi kami tidak
            akan berpura-pura bahwa ini instan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ HARGA ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Pertanyaan soal harga</span>
        <h2>Yang sering ditanyakan sebelum membeli</h2>
      </div>
      <Faq items={faqHarga} />

      <p class="lanjut reveal">
        Masih menimbang paket mana yang pas? Ceritakan dulu bisnis Anda lewat WhatsApp — nanti
        kami bantu hitungkan, gratis dan tanpa keharusan beli.
      </p>
      <p class="tombol-tengah reveal">
        <a
          href={waLink(
            'Halo Bedah Data, saya mau konsultasi paket yang pas untuk bisnis saya',
          )}
          class="btn btn-primary"
          target="_blank"
          rel="noopener">Konsultasi Gratis via WhatsApp</a
        >
      </p>
    </div>
  </section>

  <CtaAkhir
    judul="Belum yakin paket mana yang pas?"
    teks="Ceritakan dulu bisnis Anda 30 menit. Kami bantu hitung yang paling masuk akal — termasuk kalau jawabannya ternyata 'belum perlu sistem seperti ini'."
    pesanWa="Halo Bedah Data, saya mau konsultasi paket yang pas untuk bisnis saya"
  />
</Layout>

<style>
  .kepala {
    padding: clamp(52px, 7vw, 82px) 0;
    text-align: center;
  }

  .kepala p {
    font-size: 17px;
    opacity: 0.93;
    margin-top: 16px;
    margin-bottom: 0;
  }

  .eyebrow.terang {
    color: #8ef0ab;
  }

  .hitungan {
    max-width: 780px;
    margin: 52px auto 0;
    padding: 30px 32px;
    background: var(--bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .hitungan h2 {
    font-size: clamp(21px, 2.5vw, 26px);
    margin-bottom: 14px;
  }

  .hitungan p {
    font-size: 15.8px;
  }

  /* ---------- Jalur Custom ---------- */
  .custom-blok {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .custom-blok h2 {
    font-size: clamp(21px, 2.5vw, 26px);
    margin-bottom: 12px;
  }

  .custom-blok p {
    font-size: 15.8px;
  }

  /* ---------- Bagian jujur ---------- */
  .grid-jujur {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .grid-jujur {
      grid-template-columns: 1fr;
    }
  }

  .jujur {
    border-top: 4px solid var(--green);
  }

  .jujur h3 {
    font-size: 17.5px;
    margin-bottom: 10px;
  }

  .jujur p {
    font-size: 15px;
    margin-bottom: 0;
  }

  /* ---------- Penutup ---------- */
  .lanjut {
    text-align: center;
    max-width: 640px;
    margin: 40px auto 0;
    font-size: 16.5px;
    color: var(--heading);
  }

  .tombol-tengah {
    text-align: center;
    margin-top: 18px;
  }
</style>
