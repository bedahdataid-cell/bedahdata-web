---
// ============================================================================
// HALAMAN HARGA
// 🟢 Struktur resmi sejak 12 Nov 2026: Free (3 hari) / Standar / Pro, plus jalur
//    Custom lewat WhatsApp. Tanpa bundle & tanpa add-on satuan. Model 8 paket
//    per-industri SUDAH DIHAPUS — jangan dimunculkan lagi.
// 🔴 Harga dibaca dari config.ts (PAKET) — jangan menulis angka di halaman ini.
// 🔴 Angka Custom TIDAK dipublikasikan — arahkan ke WhatsApp.
// 🔴 Kata "terjangkau" sudah dicabut resmi — jangan dipakai di halaman ini.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import Harga from '../components/Harga.astro';
import CtaAkhir from '../components/CtaAkhir.astro';
import Faq from '../components/Faq.astro';
import { CUSTOM, PAKET, SITE, waLink } from '../config';
import { faqSchema } from '../data/faq';

const standar = PAKET.find((p) => p.kunci === 'standar')!;
const pro = PAKET.find((p) => p.kunci === 'pro')!;

const title = `Harga ERP Studio: Bayar Sekali Mulai ${standar.harga} | Bedah Data`;
const description = `Rincian harga ERP Studio: coba gratis 3 hari, paket Standar ${standar.harga} dan Pro ${pro.harga}, bayar sekali, bukan langganan. Termasuk perawatan dan pembaruan tahun pertama serta pendampingan.`;

const faqHarga = [
  {
    tanya: 'Apa yang terjadi kalau perawatan tidak diperpanjang?',
    jawab:
      '<p><strong>Aplikasi tetap berjalan.</strong> Layanan perawatan mencakup pembaruan, perbaikan, dan bantuan teknis dari kami. Layanan ini bukan sakelar yang menyalakan aplikasi Anda. Kalau tidak diperpanjang, aplikasi yang sudah terpasang tetap bisa dipakai seperti biasa. Yang berhenti hanyalah layanan perawatan dan pengembangan dari kami.</p>',
  },
  {
    tanya: 'Kenapa ada biaya tambahan di luar harga paket?',
    jawab:
      '<p>Karena tidak semua orang membutuhkannya, dan kami tidak mau membebankan biaya jasa ke orang yang bisa mengerjakannya sendiri. Harga paket sudah mencakup aplikasinya. Yang terpisah adalah <strong>pekerjaan manusia</strong>: pemasangan jarak jauh, pemindahan data lama dari Excel, dan pelatihan tim. Semuanya pilihan, dan biayanya kami sampaikan terbuka di awal, bukan muncul di tengah jalan.</p>',
  },
  {
    tanya: 'Apa persisnya beda Standar dan Pro?',
    jawab:
      '<p>Paket <strong>Standar</strong> berisi modul inti: penjualan, kasir, pesanan, pembelian, stok barang, keuangan, dan data induk (produk, pelanggan, pemasok). Paket <strong>Pro</strong> berisi semua itu, ditambah HRD (absensi dan penggajian), produksi, komisi, pengelolaan pelanggan (CRM), calon pelanggan (prospek), dan penasihat AI (AI Decision Intelligence). Tidak ada fitur yang dijual satuan. Kalau Anda butuh salah satunya, pilihannya naik ke Pro.</p>',
  },
  {
    tanya: 'Bisa mulai dari Standar lalu naik ke Pro nanti?',
    jawab:
      '<p>Bisa. Naik ke Pro cukup dengan membeli kode Pro lalu memasukkannya ke ERP Studio Anda. Anda tidak perlu memasang ulang aplikasi, dan data Anda tetap utuh. Kalau ragu, coba gratis 3 hari dulu, lalu pilih paket yang pas.</p>',
  },
  {
    tanya: 'Apakah ada garansi uang kembali?',
    jawab:
      '<p>Kami tidak memasang skema garansi uang kembali. Sebagai gantinya, Anda bisa <strong>mencoba gratis 3 hari</strong> dengan data Anda sendiri sebelum membayar sepeser pun. Dengan begitu, keputusan diambil setelah mencoba, bukan setelah membaca janji.</p>',
  },
];

const schema = faqSchema(faqHarga, `${SITE.url}/harga#faq`);
---

<Layout title={title} description={description} schema={schema}>
  <section class="dark-panel kepala">
    <div class="wrap-narrow">
      <span class="eyebrow terang">Harga</span>
      <h1>Bayar sekali. Bukan sewa bulanan.</h1>
      <p>
        ERP Studio, aplikasi pencatatan usaha kami, cukup dibayar sekali, mulai {standar.harga}.
        Coba gratis 3 hari dulu. Kenapa harganya segini? Aplikasinya berjalan di akun Google Anda
        sendiri, jadi kami tidak menyewa server untuk menyimpan data Anda. Perawatan tahun pertama
        gratis, dan aplikasi tetap berjalan walau perawatannya tidak diperpanjang.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Harga />

      <p class="reveal" style="text-align:center;margin-top:24px">
        Belum tahu cara memasangnya? <a href="/mulai/">Lihat panduan mulai</a>.
      </p>

      <div class="hitungan reveal">
        <h2>Hitungan sederhananya begini</h2>
        <p>
          Aplikasi berlangganan ditagih terus selama Anda memakainya, dan biayanya menumpuk
          dari tahun ke tahun. Paket Pro: {pro.harga}, dibayar sekali.
        </p>
        <p>
          Semua harga dibayar sekali, dan perawatan tahun pertama gratis. Bila dibutuhkan,
          tersedia juga layanan pendampingan pilihan (pemasangan jarak jauh, pemindahan data dari
          Excel, dan pelatihan tim) dengan biaya terpisah yang kami sampaikan terbuka di awal.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== JALUR CUSTOM & BATAS ERP ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="custom-blok card reveal">
        <span class="eyebrow">Jalur lain</span>
        <h2>{CUSTOM.judul}</h2>
        <p>{CUSTOM.teks}</p>
        <p class="tombol-tengah">
          <a href={waLink(CUSTOM.pesanWa)} class="btn btn-ghost" target="_blank" rel="noopener" data-sumber="harga-custom">{CUSTOM.cta}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== YANG PERLU DIKETAHUI SEBELUM MEMBELI ===== -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Terus terang</span>
        <h2>Sebelum Anda memutuskan membeli</h2>
        <p>
          Bagian ini sengaja kami tulis, walau isinya bisa membuat sebagian orang mengurungkan
          niat. Kami lebih suka begitu daripada Anda menyesal setelah membayar.
        </p>
      </div>

      <div class="grid-jujur">
        <div class="card jujur reveal">
          <h3>Tidak perlu langsung paket terlengkap</h3>
          <p>
            Kalau Anda masih bekerja sendiri atau timnya kecil, paket Standar (jualan, stok, dan
            keuangan) biasanya sudah cukup. Naik ke Pro bisa kapan saja tanpa memasang ulang.
            Kalau saat demo ternyata kebutuhan Anda belum cocok, kami akan mengatakannya terus
            terang.
          </p>
        </div>
        <div class="card jujur reveal" style="--reveal-delay:80ms">
          <h3>Yang kami janjikan, dan yang tidak</h3>
          <p>
            Kami tidak menjanjikan omzet Anda naik. Yang kami kerjakan adalah membuat angkanya
            jelas dan siap dipakai untuk memutuskan. Keputusannya tetap milik Anda, dan memang
            seharusnya begitu.
          </p>
        </div>
        <div class="card jujur reveal" style="--reveal-delay:160ms">
          <h3>Pindah cara mencatat butuh usaha</h3>
          <p>
            Pindah dari buku atau Excel tidak selesai dalam satu sore. Ada data yang harus
            dirapikan dan kebiasaan baru yang perlu dibangun. Kami mendampingi prosesnya, tapi kami
            tidak akan berpura-pura bahwa ini instan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ HARGA ===== -->
  <section class="tinted">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Pertanyaan soal harga</span>
        <h2>Yang sering ditanyakan sebelum membeli</h2>
      </div>
      <Faq items={faqHarga} />

      <p class="lanjut reveal">
        Masih menimbang paket mana yang pas? Ceritakan dulu usaha Anda lewat WhatsApp. Kami bantu
        menimbangnya, gratis dan tanpa kewajiban membeli.
      </p>
      <p class="tombol-tengah reveal">
        <a
          href={waLink(
            'Halo Bedah Data, saya mau konsultasi paket yang pas untuk bisnis saya',
          )}
          class="btn btn-primary"
          target="_blank"
          rel="noopener">Konsultasi Gratis lewat WhatsApp</a
        >
      </p>
    </div>
  </section>

  <CtaAkhir
    judul="Belum yakin paket mana yang pas?"
    teks="Ceritakan dulu usaha Anda selama 30 menit. Kami bantu menimbang pilihan yang paling masuk akal, termasuk kalau jawabannya ternyata 'belum perlu sekarang'."
    pesanWa="Halo Bedah Data, saya mau konsultasi paket yang pas untuk bisnis saya"
  />
</Layout>

<style>
  .kepala {
    padding: clamp(52px, 7vw, 82px) 0;
    text-align: center;
  }

  .kepala p {
    font-size: 17px;
    opacity: 0.93;
    margin-top: 16px;
    margin-bottom: 0;
  }

  .eyebrow.terang {
    color: #8ef0ab;
  }

  .hitungan {
    max-width: 780px;
    margin: 52px auto 0;
    padding: 30px 32px;
    background: var(--bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .hitungan h2 {
    font-size: clamp(21px, 2.5vw, 26px);
    margin-bottom: 14px;
  }

  .hitungan p {
    font-size: 15.8px;
  }

  /* ---------- Jalur Custom ---------- */
  .custom-blok {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .custom-blok h2 {
    font-size: clamp(21px, 2.5vw, 26px);
    margin-bottom: 12px;
  }

  .custom-blok p {
    font-size: 15.8px;
  }

  /* ---------- Bagian jujur ---------- */
  .grid-jujur {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .grid-jujur {
      grid-template-columns: 1fr;
    }
  }

  .jujur {
    border-top: 4px solid var(--green);
  }

  .jujur h3 {
    font-size: 17.5px;
    margin-bottom: 10px;
  }

  .jujur p {
    font-size: 15px;
    margin-bottom: 0;
  }

  /* ---------- Penutup ---------- */
  .lanjut {
    text-align: center;
    max-width: 640px;
    margin: 40px auto 0;
    font-size: 16.5px;
    color: var(--heading);
  }

  .tombol-tengah {
    text-align: center;
    margin-top: 18px;
  }
</style>
