---
// ============================================================================
// HALAMAN ARTIKEL — dibuat otomatis dari setiap file .md di
// src/content/panduan/. Tidak perlu menyentuh berkas ini saat menulis artikel.
// ============================================================================
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CtaAkhir from '../../components/CtaAkhir.astro';
import { SITE } from '../../config';

export const getStaticPaths = (async () => {
  const artikel = await getCollection('panduan', ({ data }) => data.draf !== true);
  return artikel.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const { Content, headings } = await render(item);
const d = item.data;

const fmtTanggal = (tanggal: Date) =>
  tanggal.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

// Daftar isi dibuat dari judul H2 di dalam artikel.
const daftarIsi = headings.filter((h) => h.depth === 2);

// Dua artikel lain sebagai bacaan lanjutan.
const semua = await getCollection('panduan', ({ data }) => data.draf !== true);
const lainnya = semua
  .filter((a) => a.id !== item.id)
  .sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf())
  .slice(0, 2);

const url = `${SITE.url}/panduan/${item.id}`;

const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: d.judul,
    description: d.deskripsi,
    datePublished: d.tanggal.toISOString(),
    dateModified: (d.diperbarui ?? d.tanggal).toISOString(),
    inLanguage: 'id-ID',
    articleSection: d.kategori,
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: `${SITE.url}/assets/logo-bedahdata.png`,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Panduan', item: `${SITE.url}/panduan` },
      { '@type': 'ListItem', position: 3, name: d.judul, item: url },
    ],
  },
];
---

<Layout title={`${d.judul} | Bedah Data`} description={d.deskripsi} ogType="article" schema={schema}>
  <article>
    <header class="kepala-artikel">
      <div class="wrap-narrow">
        <nav class="remah" aria-label="Anda di sini">
          <a href="/">Beranda</a>
          <span aria-hidden="true">›</span>
          <a href="/panduan">Panduan</a>
        </nav>
        <span class="kategori">{d.kategori}</span>
        <h1>{d.judul}</h1>
        <p class="ringkas">{d.deskripsi}</p>
        <p class="meta">
          <time datetime={d.tanggal.toISOString()}>Terbit {fmtTanggal(d.tanggal)}</time>
          {
            d.diperbarui && (
              <>
                <span aria-hidden="true"> · </span>
                <time datetime={d.diperbarui.toISOString()}>
                  Diperbarui {fmtTanggal(d.diperbarui)}
                </time>
              </>
            )
          }
        </p>
      </div>
    </header>

    <div class="badan">
      <div class="wrap-narrow">
        {
          daftarIsi.length > 2 && (
            <nav class="daftar-isi" aria-label="Daftar isi">
              <h2>Isi panduan ini</h2>
              <ol>
                {daftarIsi.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="prose">
          <Content />
        </div>

        <!-- Ajakan lembut di akhir artikel. Sengaja tidak agresif:
             artikel harus tetap berguna walau pembaca tidak membeli. -->
        <aside class="penutup">
          <h2>Butuh bantuan menerapkannya?</h2>
          <p>
            Semua yang ditulis di atas bisa Anda kerjakan sendiri — memang itu tujuannya. Tapi
            kalau ingin dibantu sampai pencatatannya benar-benar jalan, ceritakan saja kondisi
            usaha Anda lewat WhatsApp. Gratis, tanpa keharusan beli.
          </p>
          <a href="/kontak" class="btn btn-ghost">Lihat cara menghubungi kami</a>
        </aside>

        {
          lainnya.length > 0 && (
            <section class="lanjutan" aria-label="Artikel lainnya">
              <h2>Bacaan lain</h2>
              <div class="grid-lanjutan">
                {lainnya.map((a) => (
                  <a href={`/panduan/${a.id}`} class="card card-lift kartu-lanjutan">
                    <span class="kategori kecil">{a.data.kategori}</span>
                    <h3>{a.data.judul}</h3>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </article>

  <CtaAkhir
    judul="Angka usaha Anda sudah bisa dipercaya?"
    teks="Kalau masih banyak yang ditebak, kita bisa lihat bersama bagian mana yang paling cepat bisa dirapikan. Demo 30 menit, gratis."
    pesanWa="Halo Bedah Data, saya baca artikel panduan dan mau tanya lebih lanjut"
  />
</Layout>

<style>
  .kepala-artikel {
    padding: clamp(34px, 5vw, 56px) 0 clamp(26px, 3.5vw, 38px);
    border-bottom: 1px solid var(--border);
    background: var(--bg-warm);
  }

  .remah {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .remah a {
    border-bottom: 1px solid var(--border);
  }

  .remah a:hover {
    color: var(--green-deep);
    border-bottom-color: var(--green);
  }

  .kategori {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--green-deep);
    background: rgba(46, 204, 88, 0.13);
    border-radius: 999px;
    padding: 5px 13px;
    margin-bottom: 16px;
  }

  .kepala-artikel h1 {
    font-size: clamp(27px, 4.2vw, 42px);
    margin-bottom: 16px;
  }

  .ringkas {
    font-size: 17.5px;
    color: var(--text-muted);
    line-height: 1.72;
    margin-bottom: 16px;
  }

  .meta {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .badan {
    padding: clamp(34px, 5vw, 54px) 0 clamp(46px, 6vw, 72px);
  }

  /* ---------- Daftar isi ---------- */
  .daftar-isi {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px 26px;
    margin-bottom: 38px;
  }

  .daftar-isi h2 {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .daftar-isi ol {
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .daftar-isi li::marker {
    color: var(--green-deep);
    font-weight: 600;
  }

  .daftar-isi a {
    font-size: 15.5px;
    color: var(--heading);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .daftar-isi a:hover {
    color: var(--green-deep);
    border-bottom-color: var(--green);
  }

  /* ---------- Penutup ---------- */
  .penutup {
    margin-top: 52px;
    padding: 28px 30px;
    background: rgba(46, 204, 88, 0.07);
    border: 1px solid rgba(46, 204, 88, 0.32);
    border-radius: var(--radius-lg);
  }

  .penutup h2 {
    font-size: clamp(19px, 2.3vw, 23px);
    margin-bottom: 10px;
  }

  .penutup p {
    font-size: 15.8px;
    margin-bottom: 20px;
  }

  /* ---------- Bacaan lain ---------- */
  .lanjutan {
    margin-top: 52px;
  }

  .lanjutan > h2 {
    font-size: clamp(19px, 2.3vw, 23px);
    margin-bottom: 18px;
  }

  .grid-lanjutan {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  @media (max-width: 620px) {
    .grid-lanjutan {
      grid-template-columns: 1fr;
    }
  }

  .kartu-lanjutan {
    display: block;
    padding: 22px 24px;
  }

  .kategori.kecil {
    font-size: 10.5px;
    padding: 4px 11px;
    margin-bottom: 10px;
  }

  .kartu-lanjutan h3 {
    font-family: var(--font-display);
    font-size: 17.5px;
    line-height: 1.4;
    margin: 0;
  }

  .kartu-lanjutan:hover h3 {
    color: var(--green-deep);
  }
</style>
