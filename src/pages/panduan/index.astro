---
// ============================================================================
// DAFTAR ARTIKEL PANDUAN (blog)
// Semua artikel di src/content/panduan/ muncul di sini secara otomatis,
// terbaru di atas. Artikel bertanda draf: true tidak ikut tampil.
// ============================================================================
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CtaAkhir from '../../components/CtaAkhir.astro';
import { SITE } from '../../config';

const title = 'Panduan Mengelola Usaha Kecil — Keuangan, Stok & Tim | Bedah Data';
const description =
  'Panduan praktis mengelola usaha kecil: menghitung HPP jasa, membaca laporan laba rugi, merapikan stok, dan mengatur komisi karyawan. Gratis dibaca siapa saja.';

// Artikel draf disembunyikan; sisanya diurutkan dari yang terbaru.
const semua = (await getCollection('panduan', ({ data }) => data.draf !== true)).sort(
  (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf(),
);

const kategori = [...new Set(semua.map((a) => a.data.kategori))].sort();

const fmtTanggal = (d: Date) =>
  d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/panduan#halaman`,
  name: 'Panduan Mengelola Usaha Kecil',
  description,
  url: `${SITE.url}/panduan`,
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---

<Layout title={title} description={description} schema={schema}>
  <section class="dark-panel kepala">
    <div class="wrap-narrow">
      <span class="eyebrow terang">Panduan</span>
      <h1>Kelas manajemen usaha kecil</h1>
      <p>
        Cara menghitung, cara membaca angka, dan cara merapikan pencatatan — ditulis supaya
        berguna walau Anda tidak membeli apa pun dari kami.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      {
        semua.length === 0 ? (
          <p class="kosong">
            Artikel pertama sedang disiapkan. Sementara ini, silakan lihat{' '}
            <a href="/faq">pertanyaan umum</a>.
          </p>
        ) : (
          <>
            {kategori.length > 1 && (
              <ul class="pil-kategori reveal" aria-label="Kategori artikel">
                {kategori.map((k) => (
                  <li>{k}</li>
                ))}
              </ul>
            )}

            <div class="grid-artikel">
              {semua.map((artikel, i) => (
                <article class="card card-lift artikel reveal" style={`--reveal-delay:${i * 70}ms`}>
                  <span class="kategori">{artikel.data.kategori}</span>
                  <h2>
                    <a href={`/panduan/${artikel.id}`}>{artikel.data.judul}</a>
                  </h2>
                  <p>{artikel.data.deskripsi}</p>
                  <footer>
                    <time datetime={artikel.data.tanggal.toISOString()}>
                      {fmtTanggal(artikel.data.tanggal)}
                    </time>
                    <span class="baca">
                      Baca
                      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                        <path
                          d="M5 12h14M13 6l6 6-6 6"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </footer>
                </article>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <CtaAkhir
    judul="Kalau butuh bantuan merapikannya"
    teks="Artikel di atas bisa Anda kerjakan sendiri tanpa membeli apa pun. Tapi kalau ingin dibantu sampai sistemnya jalan, ceritakan saja kondisi usaha Anda."
    pesanWa="Halo Bedah Data, saya baca artikel panduan dan mau tanya lebih lanjut"
  />
</Layout>

<style>
  .kepala {
    padding: clamp(52px, 7vw, 82px) 0;
    text-align: center;
  }

  .kepala p {
    font-size: 17px;
    opacity: 0.93;
    margin-top: 16px;
    margin-bottom: 0;
  }

  .eyebrow.terang {
    color: #8ef0ab;
  }

  .kosong {
    text-align: center;
    font-size: 16.5px;
    color: var(--text-muted);
  }

  .kosong a {
    color: var(--green-deep);
    font-weight: 600;
    border-bottom: 1.5px solid rgba(46, 204, 88, 0.45);
  }

  .pil-kategori {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    justify-content: center;
    list-style: none;
    margin-bottom: 38px;
  }

  .pil-kategori li {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 13.5px;
    font-weight: 500;
  }

  .grid-artikel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 940px) {
    .grid-artikel {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .grid-artikel {
      grid-template-columns: 1fr;
    }
  }

  .artikel {
    display: flex;
    flex-direction: column;
    padding: 26px 24px;
  }

  .kategori {
    display: inline-block;
    align-self: flex-start;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--green-deep);
    background: rgba(46, 204, 88, 0.12);
    border-radius: 999px;
    padding: 5px 12px;
    margin-bottom: 14px;
  }

  .artikel h2 {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.35;
    margin-bottom: 10px;
  }

  /* Seluruh kartu bisa diklik, tapi tautan aslinya tetap ada di judul —
     jadi pembaca layar & mesin pencari tetap membaca strukturnya benar. */
  .artikel h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .artikel {
    position: relative;
  }

  .artikel h2 a:hover {
    color: var(--green-deep);
  }

  .artikel > p {
    font-size: 14.8px;
    color: var(--text-muted);
    flex-grow: 1;
    margin-bottom: 18px;
  }

  .artikel footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .baca {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--green-deep);
  }

  .baca svg {
    transition: transform 0.28s var(--ease);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .artikel:hover .baca svg {
      transform: translateX(4px);
    }
  }
</style>
