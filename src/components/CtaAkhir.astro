---
// ============================================================================
// BLOK AJAKAN AKHIR — dipasang di bawah setiap halaman panjang, supaya
// pembaca selalu punya jalan keluar ke WhatsApp dan tidak buntu.
// ============================================================================
import { waLink } from '../config';
import { t, type Bahasa } from '../i18n/ui';

interface Props {
  bahasa?: Bahasa;
  judul?: string;
  teks?: string;
  pesanWa?: string;
  /** Label tombol utama; bawaannya tawaran demo 30 menit. Wajib sesuai pesanWa bila diganti. */
  tombolUtama?: string;
}

const { bahasa = 'id', judul, teks, pesanWa, tombolUtama } = Astro.props;
const ui = t(bahasa);
const en = bahasa === 'en';

const bawaan = en
  ? {
      judul: 'Picture closing the month without a late night of manual tallying.',
      teks: 'It starts with a 30-minute chat — free, no commitment, and you do not need to be good with computers. If it fits we carry on; if not, that is perfectly fine.',
      pesanWa: 'Hello Bedah Data, I would like to schedule a free ERP Studio demo',
      tombolUtama: 'Book a Free 30-Minute Demo',
      pesanTanya: 'Hello Bedah Data, I would like to ask about ERP Studio first',
    }
  : {
      judul: 'Bayangkan tutup buku akhir bulan tanpa begadang merekap manual.',
      teks: 'Mulainya cukup dengan mengobrol 30 menit. Gratis, tanpa ikatan, dan Anda tidak perlu jago komputer. Kalau cocok, kita lanjut. Kalau belum, tidak apa-apa.',
      pesanWa: 'Halo Bedah Data, saya mau menjadwalkan demo gratis ERP Studio',
      tombolUtama: 'Jadwalkan Demo Gratis 30 Menit',
      pesanTanya: 'Halo Bedah Data, saya mau bertanya dulu soal ERP Studio',
    };

const judulAkhir = judul ?? bawaan.judul;
const teksAkhir = teks ?? bawaan.teks;
const pesanAkhir = pesanWa ?? bawaan.pesanWa;
---

<section class="dark-panel cta-akhir">
  <div class="wrap-narrow isi reveal">
    <h2>{judulAkhir}</h2>
    <p>{teksAkhir}</p>
    <div class="tombol">
      <a
        href={waLink(pesanAkhir)}
        class="btn btn-primary"
        target="_blank"
        rel="noopener"
        data-sumber="cta-akhir"
      >
        {tombolUtama ?? bawaan.tombolUtama}
      </a>
      <a
        href={waLink(bawaan.pesanTanya)}
        class="btn btn-onDark"
        target="_blank"
        rel="noopener"
        data-sumber="cta-akhir-tanya">{ui.ctaTanya}</a
      >
    </div>
  </div>
</section>

<style>
  .cta-akhir {
    padding: clamp(56px, 7vw, 88px) 0;
  }

  .isi {
    text-align: center;
  }

  .isi p {
    font-size: 17px;
    opacity: 0.93;
    max-width: 620px;
    margin: 14px auto 30px;
  }

  .tombol {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    /* Di layar sempit tombol dibuat selebar layar — lebih mudah disentuh
       dan urutannya jelas, tidak berdesakan. */
    .tombol {
      flex-direction: column;
    }
    .tombol .btn {
      width: 100%;
    }
  }
</style>
