---
// ============================================================================
// MESIN KALKULATOR — dipakai semua halaman alat gratis.
// ----------------------------------------------------------------------------
// 🔴 Syarat wajib dari SPEK_TOOLS_GRATIS_WEB §6:
//    1. HTML biasa yang bisa di-crawl — 🔴 BUKAN iframe.
//    2. Terbaca tanpa JavaScript: seluruh isian & penjelasan tetap tampil,
//       hanya angka hasilnya yang butuh JS (dan itu diberi tahu ke pengguna).
//    3. Event Pixel `Lead` menyala saat hasil keluar — inilah yang melatih
//       pixel tanpa belanja iklan.
//    4. Kalkulator TERBUKA. Tidak ada form penghalang. Bonus lewat WhatsApp.
//
// 🔵 Cara kerja rumus: fungsi `hitung` di data/alat.ts adalah fungsi
//    TypeScript yang hidup di server. Fungsi itu tidak bisa dikirim apa adanya
//    ke browser, jadi di sini diubah jadi teks sumbernya (Function.toString)
//    lalu dihidupkan kembali di browser. Dengan begitu rumusnya ditulis
//    SEKALI di satu tempat, dan tidak ada versi kedua yang bisa beda.
// ============================================================================
import type { Alat } from '../data/alat';
import { waLink } from '../config';

interface Props {
  alat: Alat;
}

const { alat } = Astro.props;

// Rumus & syarat tampil diubah jadi teks supaya bisa dijalankan di browser.
const hasilSerial = alat.hasil.map((h) => ({
  label: h.label,
  format: h.format,
  utama: h.utama ?? false,
  hitung: h.hitung.toString(),
  tampilBila: h.tampilBila ? h.tampilBila.toString() : null,
}));

const peringatanSerial = (alat.peringatan ?? []).map((p) => ({
  teks: p.teks,
  nada: p.nada ?? 'info',
  bila: p.bila.toString(),
}));

const konfigKlien = {
  slugAlat: alat.slug,
  namaAlat: alat.judulPendek,
  hasil: hasilSerial,
  peringatan: peringatanSerial,
};
---

<section class="kalkulator-blok">
  <div class="wrap">
    <div class="kalkulator" data-kalkulator>
      <!-- ---------------- KOLOM ISIAN ---------------- -->
      <form class="isian" data-form novalidate>
        <h2 class="judul-kolom">Isi angkanya</h2>

        {
          alat.isian.map((f) => (
            <div
              class="baris"
              data-baris={f.kunci}
              data-tampil-bila={f.tampilBila ? JSON.stringify(f.tampilBila) : undefined}
            >
              <label for={`f-${f.kunci}`}>
                {f.label}
                {f.opsional && <span class="opsional">opsional</span>}
              </label>

              {f.jenis === 'pilihan' ? (
                <select id={`f-${f.kunci}`} name={f.kunci} data-input data-jenis={f.jenis}>
                  {f.opsi?.map((o) => (
                    <option value={o.nilai} selected={o.nilai === f.awal}>
                      {o.label}
                    </option>
                  ))}
                </select>
              ) : f.jenis === 'teks' ? (
                <input
                  type="text"
                  id={`f-${f.kunci}`}
                  name={f.kunci}
                  data-input
                  data-jenis={f.jenis}
                  value={f.awal ?? ''}
                  autocomplete="off"
                />
              ) : (
                <div class="kotak-angka" data-jenis={f.jenis}>
                  {f.jenis === 'rupiah' && <span class="awalan" aria-hidden="true">Rp</span>}
                  <input
                    type="text"
                    inputmode="decimal"
                    id={`f-${f.kunci}`}
                    name={f.kunci}
                    data-input
                    data-jenis={f.jenis}
                    value={f.awal ?? ''}
                    autocomplete="off"
                  />
                  {f.jenis === 'persen' && <span class="akhiran" aria-hidden="true">%</span>}
                </div>
              )}

              {f.bantuan && <p class="bantuan">{f.bantuan}</p>}
            </div>
          ))
        }

        <!-- Tombol untuk pengguna yang lebih suka menekan daripada mengetik.
             Perhitungan sebenarnya jalan otomatis tiap angka berubah. -->
        <button type="submit" class="btn btn-primary tombol-hitung">Hitung</button>
      </form>

      <!-- ---------------- KOLOM HASIL ---------------- -->
      <div class="panel-hasil">
        <div class="hasil-isi">
          <h2 class="judul-kolom">Hasilnya</h2>

          <!-- Tanpa JavaScript, angka tidak bisa dihitung. Beri tahu terus
               terang — jangan biarkan kolom kosong tanpa penjelasan. -->
          <noscript>
            <p class="tanpa-js">
              Perhitungannya memerlukan JavaScript. Aktifkan JavaScript di browser Anda, atau
              ikuti rumusnya yang ditulis lengkap di bagian
              <strong>“Cara menghitungnya”</strong> di bawah — semua angkanya bisa dihitung
              manual.
            </p>
          </noscript>

          <div class="daftar-hasil" data-hasil aria-live="polite"></div>
          <div class="daftar-peringatan" data-peringatan></div>

          <!-- 🟢 TAWARAN BONUS — bukan syarat memakai kalkulator (spek §0). -->
          <div class="tawaran">
            <p class="tawaran-teks">{alat.bonusWa}</p>
            <a
              href={waLink(alat.pesanWa)}
              class="btn btn-primary tombol-wa"
              target="_blank"
              rel="noopener"
              data-sumber={`alat-${alat.slug}`}
            >
              <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="currentColor">
                <path
                  d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"
                />
                <path
                  d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.22-8.24 8.22Z"
                />
              </svg>
              Minta lewat WhatsApp
            </a>
            <p class="tawaran-catatan">
              Kalkulator di atas bebas dipakai tanpa menghubungi siapa pun. Tombol ini hanya
              kalau Anda mau tambahan rekapnya.
            </p>
          </div>
        </div>
      </div>
    </div>

    {
      alat.sumber && (
        <p class="catatan-sumber" set:html={alat.sumber} />
      )
    }
  </div>
</section>

<script is:inline define:vars={{ konfig: konfigKlien }}>
  // ==========================================================================
  // MESIN KALKULATOR — sisi browser.
  // is:inline + define:vars dipakai supaya konfigurasi tiap halaman (rumus,
  // label, peringatan) ikut tertanam di halaman itu sendiri.
  // ==========================================================================
  (function () {
    const akar = document.querySelector('[data-kalkulator]');
    if (!akar) return;

    const form = akar.querySelector('[data-form]');
    const wadahHasil = akar.querySelector('[data-hasil]');
    const wadahPeringatan = akar.querySelector('[data-peringatan]');
    const semuaInput = Array.from(akar.querySelectorAll('[data-input]'));

    // --- Menghidupkan kembali rumus dari teks -------------------------------
    // Rumus ditulis sekali di src/data/alat.ts. Di sini teksnya diubah
    // kembali jadi fungsi supaya tidak ada versi kedua yang bisa berbeda.
    //
    // 🔴 PENTING: rumus di alat.ts memakai fungsi bantu (`ang`, `upahSebulan`,
    //    dan beberapa fungsi hitung khusus). Fungsi itu hidup di server dan
    //    TIDAK ikut terbawa saat teksnya dihidupkan di sini. Jadi semuanya
    //    harus disediakan ulang di bawah, lalu disuntikkan sebagai parameter
    //    saat fungsi dibangun.
    //
    //    Terbukti perlu: tanpa ini, `ang is not defined` dilempar di dalam
    //    tiap rumus, tertangkap try/catch, dan SEMUA hasil diam-diam jadi
    //    kosong — kalkulatornya terlihat hidup tapi tidak menghitung apa pun.

    /** Sama persis dengan `ang` di src/data/alat.ts. */
    const ang = (v) => {
      const n = typeof v === 'number' ? v : parseFloat(String(v));
      return Number.isFinite(n) ? n : 0;
    };

    /** Upah sebulan = gaji pokok + tunjangan tetap (rumus resmi). */
    const upahSebulan = (n) => ang(n.gajipokok) + ang(n.tunjangan);

    /** Upah lembur satu hari, mengikuti tingkatan pengali resmi. */
    const hitungLemburSehari = (n) => {
      const perJam = upahSebulan(n) / 173;
      const jam = ang(n.jam);
      if (jam <= 0 || perJam <= 0) return 0;
      if (String(n.harilembur) === 'libur') {
        const j1 = Math.min(jam, 8);
        const j2 = Math.min(Math.max(jam - 8, 0), 1);
        const j3 = Math.max(jam - 9, 0);
        return perJam * (j1 * 2 + j2 * 3 + j3 * 4);
      }
      const j1 = Math.min(jam, 1);
      const j2 = Math.max(jam - 1, 0);
      return perJam * (j1 * 1.5 + j2 * 2);
    };

    const hitungThr = (n) => {
      const upah = upahSebulan(n);
      const masa = ang(n.masakerja);
      if (upah <= 0 || masa < 1) return 0;
      if (masa >= 12) return upah;
      return (masa / 12) * upah;
    };

    const BATAS_ADMIN = 650000;
    const biayaAdminMentah = (n) => ang(n.harga) * (ang(n.kategori) / 100);
    const biayaAdmin = (n) => Math.min(biayaAdminMentah(n), BATAS_ADMIN);

    const hargaJualMargin = (n) => {
      if (String(n.arah) === 'darimargin') {
        const m = ang(n.marginTarget);
        if (m >= 100) return 0;
        return ang(n.hpp) / (1 - m / 100);
      }
      return ang(n.hargajual);
    };

    const ambangMinimum = (n) => {
      const m = ang(n.margin) / 100;
      const sisa = ang(n.sisamargin) / 100;
      const beda = m - sisa;
      if (beda <= 0) return 0;
      return ang(n.ongkir) / beda;
    };

    // Nama-nama di atas disuntikkan sebagai parameter fungsi, sehingga rumus
    // yang dihidupkan bisa memanggilnya persis seperti di alat.ts.
    const NAMA_BANTU = [
      'ang',
      'upahSebulan',
      'hitungLemburSehari',
      'hitungThr',
      'biayaAdmin',
      'biayaAdminMentah',
      'hargaJualMargin',
      'ambangMinimum',
      'BATAS_ADMIN',
    ];
    const NILAI_BANTU = [
      ang,
      upahSebulan,
      hitungLemburSehari,
      hitungThr,
      biayaAdmin,
      biayaAdminMentah,
      hargaJualMargin,
      ambangMinimum,
      BATAS_ADMIN,
    ];

    const bangun = (teks) => {
      try {
        const pabrik = new Function(...NAMA_BANTU, 'return (' + teks + ')');
        return pabrik(...NILAI_BANTU);
      } catch (e) {
        // 🔴 Jangan diamkan — kalau rumus gagal dibangun, kalkulatornya
        //    terlihat hidup tapi hasilnya kosong. Harus terlihat di console.
        console.error('Rumus gagal dibangun:', e, teks);
        return null;
      }
    };

    const hasilDef = konfig.hasil.map((h) => ({
      label: h.label,
      format: h.format,
      utama: h.utama,
      hitung: bangun(h.hitung),
      tampilBila: h.tampilBila ? bangun(h.tampilBila) : null,
    }));

    const peringatanDef = konfig.peringatan.map((p) => ({
      teks: p.teks,
      nada: p.nada,
      bila: bangun(p.bila),
    }));

    // --- Format tampilan ----------------------------------------------------
    const fmtRupiah = new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    });
    const fmtAngka = new Intl.NumberFormat('id-ID', { maximumFractionDigits: 2 });

    const tampilkan = (nilai, format) => {
      if (format === 'teks') return String(nilai);
      const n = Number(nilai);
      if (!Number.isFinite(n)) return '—';
      if (format === 'rupiah') return fmtRupiah.format(Math.round(n));
      if (format === 'persen') return fmtAngka.format(n) + '%';
      return fmtAngka.format(n);
    };

    /** Membaca angka dari teks yang mungkin berisi titik/koma ala Indonesia. */
    const keAngka = (teks) => {
      if (typeof teks !== 'string') return 0;
      // Buang semua kecuali digit, koma, titik, dan minus.
      let bersih = teks.replace(/[^\d,.-]/g, '');
      // Titik dianggap pemisah ribuan (kebiasaan Indonesia), koma pemisah desimal.
      bersih = bersih.replace(/\./g, '').replace(',', '.');
      const n = parseFloat(bersih);
      return Number.isFinite(n) ? n : 0;
    };

    /** Menyisipkan titik ribuan saat pengguna mengetik angka rupiah. */
    const rapikanRibuan = (teks) => {
      const negatif = teks.trim().startsWith('-');
      const angkaSaja = teks.replace(/[^\d]/g, '');
      if (!angkaSaja) return '';
      const hasil = angkaSaja.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      return (negatif ? '-' : '') + hasil;
    };

    // --- Mengumpulkan nilai semua isian -------------------------------------
    const ambilNilai = () => {
      const nilai = {};
      semuaInput.forEach((el) => {
        const jenis = el.getAttribute('data-jenis');
        const nama = el.getAttribute('name');
        if (!nama) return;
        if (jenis === 'pilihan' || jenis === 'teks') {
          nilai[nama] = el.value;
        } else {
          nilai[nama] = keAngka(el.value);
        }
      });
      return nilai;
    };

    // --- Menampilkan/menyembunyikan isian bersyarat -------------------------
    const aturBarisTampil = (nilai) => {
      akar.querySelectorAll('[data-baris]').forEach((baris) => {
        const syaratTeks = baris.getAttribute('data-tampil-bila');
        if (!syaratTeks) return;
        let syarat;
        try {
          syarat = JSON.parse(syaratTeks);
        } catch (e) {
          return;
        }
        const cocok = syarat.nilai.indexOf(String(nilai[syarat.kunci])) !== -1;
        baris.hidden = !cocok;
        // Isian yang disembunyikan tidak boleh bisa difokus keyboard.
        baris.querySelectorAll('input, select').forEach((el) => {
          el.disabled = !cocok;
        });
      });
    };

    // --- Event `Lead` --------------------------------------------------------
    // 🔴 Inilah yang melatih pixel tanpa belanja iklan (spek §6).
    //    Dikirim SEKALI per kunjungan halaman, bukan tiap ketikan — kalau tiap
    //    ketikan, datanya jadi sampah dan pixel belajar dari sinyal palsu.
    let leadTerkirim = false;
    const kirimLead = () => {
      if (leadTerkirim) return;
      leadTerkirim = true;
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Lead', {
          content_name: konfig.namaAlat,
          content_category: 'alat-gratis',
        });
      }
    };

    // --- Menggambar hasil ----------------------------------------------------
    const hitungUlang = () => {
      const nilai = ambilNilai();
      aturBarisTampil(nilai);

      // Nilai dibaca ulang setelah baris disembunyikan, supaya isian yang
      // tidak relevan tidak ikut mempengaruhi rumus.
      const nilaiAktif = ambilNilai();

      let adaIsi = false;
      const potongan = [];

      hasilDef.forEach((h) => {
        if (!h.hitung) return;
        if (h.tampilBila) {
          let tampil = false;
          try {
            tampil = !!h.tampilBila(nilaiAktif);
          } catch (e) {
            tampil = false;
          }
          if (!tampil) return;
        }

        let nilaiHasil;
        try {
          nilaiHasil = h.hitung(nilaiAktif);
        } catch (e) {
          return;
        }

        if (h.format !== 'teks' && Number(nilaiHasil) !== 0) adaIsi = true;

        potongan.push(
          '<div class="baris-hasil' +
            (h.utama ? ' utama' : '') +
            '"><span class="label-hasil">' +
            h.label +
            '</span><span class="nilai-hasil">' +
            tampilkan(nilaiHasil, h.format) +
            '</span></div>',
        );
      });

      wadahHasil.innerHTML = potongan.join('');

      // --- Peringatan ---
      const pesan = [];
      peringatanDef.forEach((p) => {
        if (!p.bila) return;
        let aktif = false;
        try {
          aktif = !!p.bila(nilaiAktif);
        } catch (e) {
          aktif = false;
        }
        if (aktif) {
          pesan.push(
            '<p class="peringatan ' + p.nada + '" role="note">' + p.teks + '</p>',
          );
        }
      });
      wadahPeringatan.innerHTML = pesan.join('');

      if (adaIsi) kirimLead();
    };

    // --- Pemasangan ----------------------------------------------------------
    semuaInput.forEach((el) => {
      const jenis = el.getAttribute('data-jenis');

      el.addEventListener('input', () => {
        // Rupiah dirapikan dengan titik ribuan sambil diketik.
        if (jenis === 'rupiah') {
          const posisiAkhir = el.selectionStart === el.value.length;
          const rapi = rapikanRibuan(el.value);
          if (rapi !== el.value) {
            el.value = rapi;
            if (posisiAkhir) el.setSelectionRange(rapi.length, rapi.length);
          }
        }
        hitungUlang();
      });

      el.addEventListener('change', hitungUlang);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      hitungUlang();
      // Di HP, hasil ada di bawah isian — gulirkan supaya langsung terlihat.
      const panel = akar.querySelector('.panel-hasil');
      if (panel && window.innerWidth <= 900) {
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Rapikan nilai awal rupiah, lalu hitung sekali saat halaman dibuka
    // supaya hasil dasar LANGSUNG tampil tanpa perlu diklik (spek §0).
    semuaInput.forEach((el) => {
      if (el.getAttribute('data-jenis') === 'rupiah') {
        el.value = rapikanRibuan(el.value);
      }
    });
    hitungUlang();

    // 🔵 Lead pada muat awal sengaja TIDAK dikirim — angka contoh bawaan bukan
    //    tanda seseorang benar-benar memakai alatnya. Bendera dimatikan dulu,
    //    lalu dinyalakan pada interaksi nyata pertama.
    leadTerkirim = true;
    const nyalakanLead = () => {
      leadTerkirim = false;
      semuaInput.forEach((el) => {
        el.removeEventListener('input', nyalakanLead);
        el.removeEventListener('change', nyalakanLead);
      });
    };
    semuaInput.forEach((el) => {
      el.addEventListener('input', nyalakanLead);
      el.addEventListener('change', nyalakanLead);
    });
  })();
</script>

<style>
  .kalkulator-blok {
    padding-top: clamp(30px, 4vw, 44px);
    padding-bottom: clamp(30px, 4vw, 44px);
  }

  .kalkulator {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .kalkulator {
      grid-template-columns: 1fr;
    }
  }

  .judul-kolom {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-deep);
    margin-bottom: 22px;
  }

  /* ---------------- Isian ---------------- */
  .isian {
    padding: clamp(24px, 3.4vw, 36px);
  }

  .baris {
    margin-bottom: 20px;
  }

  .baris[hidden] {
    display: none;
  }

  label {
    display: block;
    font-size: 14.8px;
    font-weight: 600;
    color: var(--heading);
    margin-bottom: 8px;
    line-height: 1.45;
  }

  .opsional {
    display: inline-block;
    margin-left: 7px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg);
    border-radius: 999px;
    padding: 2px 9px;
    vertical-align: middle;
  }

  input,
  select {
    width: 100%;
    min-height: 50px; /* nyaman disentuh jempol */
    padding: 12px 15px;
    font-family: var(--font-body);
    font-size: 16px; /* 🔴 16px: mencegah iOS ikut memperbesar layar saat difokus */
    font-weight: 500;
    color: var(--heading);
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: 11px;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  input:hover,
  select:hover {
    border-color: rgba(14, 61, 51, 0.24);
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 0 3.5px rgba(46, 204, 88, 0.16);
  }

  select {
    appearance: none;
    -webkit-appearance: none;
    /* Panah dibuat dari SVG inline — tanpa file ikon tambahan. */
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'><path d='M1 1l6 6 6-6' fill='none' stroke='%230E3D33' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 15px center;
    padding-right: 42px;
  }

  /* Kolom angka dengan awalan "Rp" / akhiran "%" */
  .kotak-angka {
    position: relative;
  }

  .kotak-angka .awalan,
