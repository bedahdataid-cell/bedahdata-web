---
// ============================================================================
// HEADER — logo, menu navigasi, dan tombol WhatsApp.
// Di HP menu berubah jadi tombol hamburger yang membuka panel penuh.
// ============================================================================
import { NAV, tautanBeli } from '../config';
import { BAHASA, jalur, jalurNetral, t, type Bahasa } from '../i18n/ui';

interface Props {
  bahasa: Bahasa;
  /** Kalau false, tombol ganti bahasa disembunyikan (tidak ada pasangannya). */
  adaTerjemahan?: boolean;
}

const { bahasa, adaTerjemahan = true } = Astro.props;
const teks = t(bahasa);

// Menandai menu yang sedang dibuka, supaya pengunjung tahu posisinya.
// Garis miring di akhir dibuang dari KEDUA sisi sebelum dibandingkan —
// NAV menulis href dengan garis miring (syarat trailingSlash: 'always'),
// sementara pathname bisa datang dengan atau tanpa garis miring.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = jalur(href, bahasa).replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};

// --- Tombol ganti bahasa ---------------------------------------------------
// 🔴 Menunjuk ke halaman YANG SAMA dalam bahasa lain, bukan ke beranda.
//    Melempar pembaca ke beranda saat mengganti bahasa adalah cara tercepat
//    membuat mereka menyerah mencari halaman yang tadi dibaca.
const netral = jalurNetral(Astro.url.pathname);
const pilihanBahasa = (['id', 'en'] as const).map((b) => ({
  ...BAHASA[b],
  href: jalur(netral, b),
  aktif: b === bahasa,
}));
---

<header class="site-header">
  <div class="wrap bar">
    <a href={jalur('/', bahasa)} class="brand" aria-label={teks.kembaliBeranda}>
      <img
        src="/assets/logo-bedahdata.png"
        alt="Logo Bedah Data"
        width="150"
        height="38"
        fetchpriority="high"
      />
    </a>

    <nav id="nav-utama" class="nav" aria-label={teks.navUtama}>
      <ul>
        {
          NAV.map((item) => {
            const sub = 'sub' in item ? item.sub : null;
            const hrefSub = (x: { href: string; netral: boolean }) => (x.netral ? x.href : jalur(x.href, bahasa));
            const aktifSub = sub ? sub.some((x) => path === hrefSub(x).replace(/\/$/, '')) : false;
            return (
              <li class:list={[{ 'ada-sub': !!sub }]}>
                <a
                  href={jalur(item.href, bahasa)}
                  aria-current={isActive(item.href) || aktifSub ? 'page' : undefined}
                  aria-haspopup={sub ? 'true' : undefined}
                >
                  {teks[item.kunci]}
                  {sub && (
                    <svg class="panah-sub" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </a>
                {sub && (
                  <ul class="sub">
                    {sub.map((x) => (
                      <li>
                        <a href={hrefSub(x)} aria-current={path === hrefSub(x).replace(/\/$/, '') ? 'page' : undefined}>
                          {teks[x.kunci]}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>

      <!-- Pilih bahasa versi HP: ikut di dalam panel menu, di atas tombol WA -->
      {
        adaTerjemahan && (
          <div class="pilih-bahasa pilih-mobile" role="group" aria-label={teks.gantiBahasa}>
            {pilihanBahasa.map((b) => (
              <a
                href={b.href}
                hreflang={b.htmlLang}
                lang={b.htmlLang}
                aria-current={b.aktif ? 'true' : undefined}
                aria-label={b.nama}
              >
                {b.label}
              </a>
            ))}
          </div>
        )
      }

      <!-- Tombol WhatsApp versi HP: ikut di dalam panel menu -->
      <a
        href={bahasa === 'en' ? tautanBeli('gratis', true) : '/beli/?paket=gratis'}
        class="btn btn-primary cta-mobile"
        target={bahasa === 'en' ? '_blank' : undefined}
        rel={bahasa === 'en' ? 'noopener' : undefined}
        data-sumber="header-mobile">{teks.ctaDemo}</a
      >
    </nav>

    <!-- Pilih bahasa versi desktop -->
    {
      adaTerjemahan && (
        <div class="pilih-bahasa pilih-desktop" role="group" aria-label={teks.gantiBahasa}>
          {pilihanBahasa.map((b) => (
            <a
              href={b.href}
              hreflang={b.htmlLang}
              lang={b.htmlLang}
              aria-current={b.aktif ? 'true' : undefined}
              aria-label={b.nama}
            >
              {b.label}
            </a>
          ))}
        </div>
      )
    }

    <a
      href={bahasa === 'en' ? tautanBeli('gratis', true) : '/beli/?paket=gratis'}
      class="btn btn-primary cta-desktop"
      target={bahasa === 'en' ? '_blank' : undefined}
      rel={bahasa === 'en' ? 'noopener' : undefined}
      data-sumber="header">{teks.ctaDemo}</a
    >

    <button
      type="button"
      class="hamburger"
      id="tombol-menu"
      aria-label={teks.bukaMenu}
      data-label-buka={teks.bukaMenu}
      data-label-tutup={teks.tutupMenu}
      aria-expanded="false"
      aria-controls="nav-utama"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    height: 74px;
  }

  .brand img {
    height: 38px;
    width: auto;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
  }

  .nav a {
    position: relative;
    font-size: 15px;
    font-weight: 500;
    color: var(--heading);
    padding: 6px 0;
    transition: color 0.2s var(--ease);
  }

  /* Garis bawah tipis yang tumbuh saat disentuh — micro-interaction kalem. */
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s var(--ease);
  }

  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav a[aria-current='page'] {
    color: var(--green-deep);
    font-weight: 600;
  }

  /* --- Submenu (Panduan): muncul saat disorot atau difokus keyboard --- */
  .nav li {
    position: relative;
  }
  .nav li.ada-sub > a {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .panah-sub {
    flex: none;
    margin-left: 4px;
    transition: transform 0.2s var(--ease);
  }
  .nav .sub {
    position: absolute;
    top: 100%;
    left: -14px;
    min-width: 210px;
    display: none;
    flex-direction: column;
    gap: 0;
    padding: 8px;
    margin-top: 6px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    z-index: 30;
  }
  /* jembatan tak terlihat supaya submenu tidak menutup saat kursor melintasi celah */
  .nav .sub::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    height: 12px;
  }
  .nav li.ada-sub:hover > .sub,
  .nav li.ada-sub:focus-within > .sub {
    display: flex;
  }
  .nav li.ada-sub:hover .panah-sub,
  .nav li.ada-sub:focus-within .panah-sub {
    transform: rotate(180deg);
  }
  .nav .sub a {
    display: block;
    padding: 10px 12px;
    border-radius: 9px;
    white-space: nowrap;
    text-align: left;
  }
  .nav .sub a::after {
    display: none;
  }
  .nav .sub a:hover {
    background: rgba(46, 204, 88, 0.1);
  }

  .cta-desktop {
    min-height: 44px;
    padding: 10px 22px;
    font-size: 14.5px;
    white-space: nowrap;
  }

  .cta-mobile {
    display: none;
  }

  /* --- Pilih bahasa: IN | EN --------------------------------------------
     Dibuat sebagai dua tautan, bukan dropdown: cuma ada dua pilihan, dan
     tautan langsung bisa dibaca mesin pencari sekaligus dipakai keyboard.
     Garis pemisah "|" dibuat dari border, bukan karakter teks — supaya
     tidak ikut terbaca pembaca layar sebagai tulisan. */
  .pilih-bahasa {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .pilih-bahasa a {
    padding: 6px 9px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    border-radius: 7px;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }

  .pilih-bahasa a + a {
    border-left: 1px solid var(--border);
    margin-left: 2px;
    padding-left: 11px;
  }

  .pilih-bahasa a:hover {
    color: var(--heading);
  }

  /* Bahasa yang sedang aktif: hijau tua — kontras cukup di atas putih.
     🔴 Bukan --green (kontras ~2,1:1, gagal ambang 4,5:1). */
  .pilih-bahasa a[aria-current='true'] {
    color: var(--green-deep);
    background: rgba(46, 204, 88, 0.1);
  }

  .pilih-mobile {
    display: none;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 48px;
    height: 48px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2.5px;
    margin-inline: auto;
    border-radius: 2px;
    background: var(--heading);
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }

  /* Hamburger berubah jadi tanda silang saat menu terbuka. */
  .hamburger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* ---------- Tampilan HP & tablet ---------- */
  @media (max-width: 940px) {
    .cta-desktop {
      display: none;
    }

    /* Di HP, pilih bahasa pindah ke dalam panel menu — bar atas sudah penuh
       dengan logo & hamburger. */
    .pilih-desktop {
      display: none;
    }

    .pilih-mobile {
      display: flex;
      justify-content: center;
      gap: 4px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .pilih-mobile a {
      font-size: 15px;
      padding: 10px 18px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    .hamburger {
      display: flex;
    }

    .nav {
      position: fixed;
      inset: 74px 0 auto 0;
      max-height: calc(100dvh - 74px);
      overflow-y: auto;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: 0 18px 32px -18px rgba(14, 61, 51, 0.28);
      padding: 10px 22px 26px;
      /* Disembunyikan dengan visibility + opacity (bukan display:none)
         supaya bisa dianimasikan dan tetap tidak bisa difokus keyboard. */
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.28s var(--ease), transform 0.28s var(--ease),
        visibility 0.28s;
    }

    .nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav li + li {
      border-top: 1px solid var(--border);
    }

    /* di HP: submenu selalu terbuka, menjorok ke dalam */
    .nav .sub {
      position: static;
      display: flex;
      margin: 0 0 8px;
      padding: 0 0 0 16px;
      border: 0;
      box-shadow: none;
      background: transparent;
    }
    .nav .sub::before,
    .panah-sub {
      display: none;
    }
    .nav .sub li + li {
      border-top: 0;
    }
    .nav .sub a {
      padding: 10px 2px;
      font-size: 15.5px;
      color: var(--text-muted);
    }

    .nav a {
      display: block;
      padding: 15px 2px;
      font-size: 16.5px;
    }

    .nav a::after {
      display: none;
    }

    .cta-mobile {
      display: flex;
      width: 100%;
      margin-top: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>

<script>
  // ==========================================================================
  // MENU HP — buka/tutup + perilaku yang diharapkan pengguna:
  // tutup saat menekan Esc, saat menekan di luar, dan saat layar dilebarkan.
  // ==========================================================================
  const tombol = document.getElementById('tombol-menu');
  const nav = document.getElementById('nav-utama');

  if (tombol && nav) {
    // Label diambil dari atribut data-* supaya ikut bahasa halaman —
    // 🔴 jangan tulis "Buka menu"/"Tutup menu" langsung di sini.
    const labelBuka = tombol.dataset.labelBuka || 'Buka menu';
    const labelTutup = tombol.dataset.labelTutup || 'Tutup menu';

    const setMenu = (buka: boolean) => {
      nav.classList.toggle('is-open', buka);
      tombol.setAttribute('aria-expanded', String(buka));
      tombol.setAttribute('aria-label', buka ? labelTutup : labelBuka);
      // Kunci gulir halaman selama menu menutupi layar.
      document.body.style.overflow = buka ? 'hidden' : '';
    };

    tombol.addEventListener('click', () => {
      setMenu(!nav.classList.contains('is-open'));
    });

    // Esc menutup menu lalu mengembalikan fokus ke tombolnya.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        setMenu(false);
        tombol.focus();
      }
    });

    // Menekan di luar area menu ikut menutupnya.
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (
        nav.classList.contains('is-open') &&
        !nav.contains(target) &&
        !tombol.contains(target)
      ) {
        setMenu(false);
      }
    });

    // Kalau layar dilebarkan ke ukuran desktop, pastikan gulir tidak terkunci.
    const mq = window.matchMedia('(max-width: 940px)');
    mq.addEventListener('change', (e) => {
      if (!e.matches) setMenu(false);
    });
  }
</script>
