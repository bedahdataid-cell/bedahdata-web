---
// ============================================================================
// VIDEO FASAD — poster + tombol putar; <video> baru dibuat saat diklik, jadi
// halaman tidak memuat berkas video sebelum pengunjung memintanya (DESIGN.md §5).
// Berkas: public/video/<nama>.mp4 (+ poster <nama>.webp). Dengan suara & subtitle tertanam.
// ============================================================================
interface Props {
  nama: string;       // nama berkas tanpa ekstensi
  judul: string;      // teks tombol/aksesibilitas
  durasi: string;     // mis. "1:13"
  eyebrow?: string;
  heading?: string;
  teks?: string;
  id?: string;
  tinted?: boolean;
  /** Tarik perhatian: eyebrow distabilo + bingkai oranye berdenyut di sekeliling video. */
  sorot?: boolean;
  /** Frasa di dalam `teks` yang diberi stabilo oranye (maksimal satu). */
  tanda?: string;
}
const { nama, judul, durasi, eyebrow, heading, teks, id, tinted, sorot, tanda } = Astro.props;
const potongTeks = teks && tanda && teks.includes(tanda) ? teks.split(tanda) : null;
---

<section class:list={["vf-sec", { tinted }]} id={id}>
  <div class="wrap">
    {heading && (
      <div class="sec-head reveal">
        {eyebrow && <span class:list={["eyebrow", { "eyebrow-besar": sorot }]}>{sorot ? <mark class="stabilo">{eyebrow}</mark> : eyebrow}</span>}
        <h2>{heading}</h2>
        {teks && (potongTeks
          ? <p>{potongTeks[0]}<mark class="stabilo">{tanda}</mark>{potongTeks.slice(1).join(tanda)}</p>
          : <p>{teks}</p>)}
      </div>
    )}
    <div class:list={["vf", "reveal", { "vf-sorot": sorot }]} data-vf data-src={`/video/${nama}.mp4`} data-poster={`/video/${nama}.webp`}>
      <button type="button" class="vf-tombol" aria-label={`Putar video: ${judul}`}>
        <img src={`/video/${nama}.webp`} alt={judul} width="1280" height="720" loading="lazy" decoding="async" />
        <span class="vf-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="38" height="38"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
        </span>
        <span class="vf-label"><strong>{judul}</strong><small>{durasi} · bersuara</small></span>
      </button>
    </div>
  </div>
</section>

<script>
  // Putar otomatis TANPA suara saat video terlihat (browser melarang autoplay bersuara),
  // tombol "Nyalakan suara" untuk mendengar narasi, jeda saat keluar layar.
  // Tidak otomatis bila pengguna memilih "kurangi gerakan" atau mode hemat data.
  const hemat = (navigator as any).connection?.saveData === true;
  const kurangiGerak = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bolehOtomatis = !hemat && !kurangiGerak && 'IntersectionObserver' in window;

  function pasang(w: HTMLElement, bersuara: boolean) {
    let v = w.querySelector('video');
    if (!v) {
      v = document.createElement('video');
      v.src = w.dataset.src!;
      v.poster = w.dataset.poster!;
      v.playsInline = true;
      v.setAttribute('preload', 'auto');
      v.controls = bersuara;
      v.muted = !bersuara;
      const suara = document.createElement('button');
      suara.type = 'button';
      suara.className = 'vf-suara';
      suara.textContent = '🔊 Ketuk untuk menyalakan suara';
      suara.addEventListener('click', () => {
        v!.muted = false;
        v!.controls = true;
        v!.currentTime = 0;
        v!.play().catch(() => {});
        suara.remove();
      });
      w.replaceChildren(v);
      if (!bersuara) w.append(suara);
    } else if (bersuara) {
      v.muted = false;
      v.controls = true;
      w.querySelector('.vf-suara')?.remove();
    }
    v.play().catch(() => {});
    return v;
  }

  // Coba langsung bersuara; bila browser menolak (belum ada interaksi), putar bisu.
  function otomatis(w: HTMLElement) {
    const v = pasang(w, true);
    v.play().catch(() => {
      v.muted = true;
      v.controls = false;
      v.dataset.bisuOtomatis = '1';
      if (!w.querySelector('.vf-suara')) {
        const suara = document.createElement('button');
        suara.type = 'button';
        suara.className = 'vf-suara';
        suara.textContent = '🔊 Ketuk untuk menyalakan suara';
        suara.addEventListener('click', () => nyalakan(v, w));
        w.append(suara);
      }
      v.play().catch(() => {});
    });
  }
  function nyalakan(v: HTMLVideoElement, w: HTMLElement) {
    v.muted = false;
    v.controls = true;
    v.currentTime = 0;
    delete v.dataset.bisuOtomatis;
    v.play().catch(() => {});
    w.querySelector('.vf-suara')?.remove();
  }
  // Ketukan/klik pertama di mana saja: video yang sedang berputar bisu langsung bersuara dari awal.
  const sekali = () => {
    document.querySelectorAll<HTMLVideoElement>('[data-vf] video[data-bisu-otomatis]').forEach((v) => {
      if (!v.paused) nyalakan(v, v.closest('[data-vf]') as HTMLElement);
    });
  };
  ['pointerdown', 'keydown'].forEach((ev) => document.addEventListener(ev, sekali, { capture: true }));

  document.querySelectorAll<HTMLElement>('[data-vf]').forEach((w) => {
    w.querySelector('button')?.addEventListener('click', () => pasang(w, true));
    if (!bolehOtomatis) return;
    new IntersectionObserver(
      (es) => {
        es.forEach((e) => {
          const v = w.querySelector('video');
          if (e.isIntersecting && e.intersectionRatio >= 0.6) {
            if (!v) otomatis(w);
            else if (v.paused && !v.ended) v.play().catch(() => {});
          } else if (v && !v.paused) {
            v.pause();
          }
        });
      },
      { threshold: [0, 0.6] }
    ).observe(w);
  });
</script>

<style>
  .vf {
    max-width: 960px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: #0e3d33;
    aspect-ratio: 16 / 9;
  }
  .vf {
    position: relative;
  }
  /* Bingkai oranye: tanda "tonton ini dulu". Denyut hanya bila gerak diizinkan. */
  .vf-sorot {
    overflow: visible;
    box-shadow: 0 0 0 4px rgba(255, 107, 44, 0.85), var(--shadow-lg);
  }
  .vf-sorot .vf-tombol,
  .vf-sorot video {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .vf-sec .eyebrow-besar {
    font-size: 17px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vf-sorot {
      animation: bingkai-denyut 2.4s var(--ease-out) infinite;
    }
  }
  @keyframes bingkai-denyut {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255, 107, 44, 0.85), 0 0 0 4px rgba(255, 107, 44, 0.35), var(--shadow-lg); }
    50% { box-shadow: 0 0 0 4px rgba(255, 107, 44, 0.85), 0 0 0 14px rgba(255, 107, 44, 0), var(--shadow-lg); }
  }
  :global(.vf-suara) {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 18px !important;
    padding: 16px 28px !important;
    border: 0;
    border-radius: 999px;
    padding: 11px 20px;
    font: 600 15px/1 var(--font-body);
    color: #fff;
    background: var(--oranye-deep);
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }
  :global(.vf-suara) {
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    :global(.vf-suara) {
      font-size: 14px !important;
      padding: 12px 18px !important;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.vf-suara) {
      animation: suara-denyut 1.8s var(--ease-out) infinite;
    }
  }
  @keyframes suara-denyut {
    0%, 100% { box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.5), 0 0 0 0 rgba(255, 107, 44, 0.55); }
    50% { box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.5), 0 0 0 12px rgba(255, 107, 44, 0); }
  }
  .vf video {
    width: 100%;
    height: 100%;
    display: block;
  }
  .vf-tombol {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #0e3d33;
    cursor: pointer;
    color: #fff;
    font-family: inherit;
  }
  .vf-tombol::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    background: linear-gradient(to top, rgba(6, 26, 21, 0.85), rgba(6, 26, 21, 0));
    pointer-events: none;
  }
  .vf-label,
  .vf-play {
    z-index: 1;
  }
  .vf-tombol img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
    transition: transform 0.6s var(--ease), opacity 0.4s var(--ease);
  }
  .vf-play {
    position: absolute;
    right: 22px;
    bottom: 18px;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--green);
    display: grid;
    place-items: center;
    box-shadow: 0 10px 30px rgba(46, 204, 88, 0.45);
    transition: transform 0.3s var(--ease);
  }
  .vf-label {
    position: absolute;
    left: 24px;
    bottom: 20px;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
  }
  .vf-label strong {
    display: block;
    color: #fff;
    font-size: 18px;
  }
  .vf-label small {
    color: rgba(255, 255, 255, 0.85);
    font-size: 13.5px;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .vf-tombol:hover img {
      transform: scale(1.03);
      opacity: 1;
    }
    .vf-tombol:hover .vf-play {
      transform: scale(1.08);
    }
  }
  @media (max-width: 600px) {
    .vf-play {
      right: 14px;
      bottom: 12px;
      width: 56px;
      height: 56px;
    }
    .vf-label {
      left: 16px;
      bottom: 14px;
      right: 84px;
    }
    .vf-label strong {
      font-size: 15px;
    }
  }
</style>
