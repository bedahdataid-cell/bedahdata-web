---
// ============================================================================
// FOOTER — kontak, peta halaman, dan media sosial.
// Selalu menyediakan jalan keluar ke WhatsApp supaya pembaca tidak buntu.
// ============================================================================
import { SITE, SOCIALS, SEGMEN, WA_DISPLAY, WA_NUMBER, PRIVACY_URL, TERMS_URL } from '../config';
import IkonYoutube from './IkonYoutube.astro';
import { jalur, type Bahasa } from '../i18n/ui';

interface Props {
  bahasa: Bahasa;
}

const { bahasa } = Astro.props;
const en = bahasa === 'en';
const tahun = new Date().getFullYear();

// Teks footer ditulis di sini (bukan di kamus UI) karena hanya dipakai
// di komponen ini — kamus disediakan untuk teks yang berulang di banyak tempat.
const F = en
  ? {
      ringkas:
        'One system for stock, finance, and staff commission for small businesses in Indonesia. Pay once, your data stays in your own Drive, guided by real people.',
      halaman: 'Pages',
      untukUsaha: 'For Your Business',
      hubungi: 'Contact Us',
      ikuti: 'Follow Us',
      solusi: 'Solution & Modules',
      harga: 'Pricing',
      panduan: 'Guides & Articles',
      faq: 'Common Questions',
      tentang: 'About Us',
      kontak: 'Contact',
      alat: 'Free Tools',
      tutorial: 'Video Tutorials',
      hakCipta: 'Business management system for small businesses in Indonesia.',
      privasi: 'Privacy Policy',
      syaratKetentuan: 'Terms of Service',
    }
  : {
      ringkas:
        'Satu aplikasi pencatatan untuk stok, keuangan, dan komisi karyawan usaha kecil di Indonesia. Bayar sekali, data tersimpan di Google Drive milik Anda sendiri, dan didampingi orang sungguhan.',
      halaman: 'Halaman',
      untukUsaha: 'Untuk Usaha',
      hubungi: 'Hubungi Kami',
      ikuti: 'Ikuti Kami',
      solusi: 'Solusi dan Modul',
      harga: 'Harga',
      panduan: 'Panduan dan Artikel',
      faq: 'Pertanyaan Umum',
      tentang: 'Tentang Kami',
      kontak: 'Kontak',
      alat: 'Alat Gratis',
      tutorial: 'Video Tutorial',
      hakCipta: 'Aplikasi pencatatan usaha untuk usaha kecil di Indonesia.',
      privasi: 'Kebijakan Privasi',
      syaratKetentuan: 'Syarat dan Ketentuan',
    };
---

<footer class="site-footer">
  <div class="wrap">
    <div class="grid">
      <div class="kolom-brand">
        <img
          src="/assets/logo-bedahdata-putih.png"
          alt="Logo Bedah Data versi putih"
          width="160"
          height="42"
          loading="lazy"
        />
        <p>{F.ringkas}</p>
      </div>

      <div>
        <h2 class="judul-kolom">{F.halaman}</h2>
        <ul>
          <li><a href={jalur('/solusi/', bahasa)}>{F.solusi}</a></li>
          <li><a href={jalur('/alat/', bahasa)}>{F.alat}</a></li>
          <li><a href="/tutorial/">{F.tutorial}</a></li>
          <li><a href={jalur('/harga/', bahasa)}>{F.harga}</a></li>
          {!en && <li><a href="/cara-bayar/">Cara bayar lewat Lynk</a></li>}
          <li><a href={jalur('/panduan/', bahasa)}>{F.panduan}</a></li>
          <li><a href={jalur('/faq/', bahasa)}>{F.faq}</a></li>
          <li><a href={jalur('/tentang/', bahasa)}>{F.tentang}</a></li>
          <li><a href={jalur('/kontak/', bahasa)}>{F.kontak}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="judul-kolom">{F.untukUsaha}</h2>
        <ul>
          {
            SEGMEN.map((s) => (
              <li>
                <a href={jalur(`/${s.slug}/`, bahasa)}>{en ? s.namaEn : s.nama}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="judul-kolom">{F.hubungi}</h2>
        <ul class="daftar-kontak">
          <li>
            <a href={`https://wa.me/${WA_NUMBER}`} target="_blank" rel="noopener">
              <span class="ikon-kontak" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3L3 21z"></path><path d="M9 8.8c0 3.3 2.9 6.2 6.2 6.2l1.2-1.3-1.9-1-.9.7c-.9-.4-1.9-1.4-2.3-2.3l.7-.9-1-1.9L9 8.8z"></path></svg>
              </span>
              <span>WhatsApp: {WA_DISPLAY}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`}>
              <span class="ikon-kontak" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M3.5 7.5l8.5 6 8.5-6"></path></svg>
              </span>
              <span>{SITE.email}</span>
            </a>
          </li>
        </ul>
        <h2 class="judul-kolom" style="margin-top:22px">{F.ikuti}</h2>
        <div class="ikon-sosmed">
          {
            SOCIALS.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.nama} title={s.nama}>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {s.nama.startsWith('Instagram') && <><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></>}
                  {s.nama.startsWith('Facebook') && <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z"></path>}
                  {s.nama.startsWith('TikTok') && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.4 5 4.6"></path>}
                  {s.nama.startsWith('YouTube') && <><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"></path></>}
                </svg>
              </a>
            ))
          }
        </div>
        <ul>
          <li>
            <a href="https://www.youtube.com/playlist?list=PLJt7HHo40rRE" target="_blank" rel="noopener" data-sumber="footer-playlist">
              <IkonYoutube size={14} />{en ? 'Video tutorials (YouTube)' : 'Video panduan (YouTube)'}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="bawah">
      <span>© {tahun} {SITE.legalName}. {F.hakCipta}</span>
      <span class="tautan-legal">
        <a href={PRIVACY_URL}>{F.privasi}</a>
        <a href={TERMS_URL}>{F.syaratKetentuan}</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--heading);
    color: #fff;
    padding: 56px 0 26px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 36px;
    margin-bottom: 38px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    .kolom-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .kolom-brand img {
    height: 42px;
    width: auto;
    margin-bottom: 14px;
  }

  .kolom-brand p {
    font-size: 14.5px;
    opacity: 0.82;
    max-width: 330px;
    line-height: 1.7;
  }

  /* Dipakai <h2> supaya urutan judul halaman tetap masuk akal bagi pembaca
     layar, tapi ukurannya tetap kecil seperti label footer biasa. */
  .judul-kolom {
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    margin-bottom: 14px;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  ul a {
    font-size: 14.5px;
    opacity: 0.82;
    transition: opacity 0.2s var(--ease), color 0.2s var(--ease);
  }

  ul a:hover {
    opacity: 1;
    color: var(--green);
  }

  .bawah {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    opacity: 0.75;
  }

  .tautan-legal {
    display: flex;
    gap: 18px;
  }

  .bawah a {
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
  }
  .daftar-kontak a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .ikon-kontak {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.1);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .daftar-kontak a:hover .ikon-kontak {
    background: var(--green);
    color: var(--heading);
  }
  .ikon-sosmed {
    display: flex;
    gap: 10px;
    margin: 4px 0 14px;
  }
  .ikon-sosmed a {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transition: background-color 0.2s, transform 0.2s;
  }
  .ikon-sosmed a:hover {
    background: var(--green);
    color: var(--heading);
    transform: translateY(-2px);
  }
</style>
