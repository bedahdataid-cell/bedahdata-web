---
import IkonYoutube from './IkonYoutube.astro';
// ============================================================================
// GALERI FITUR UNGGULAN — tab + klip layar ERP ASLI (bukan GIF, bukan mockup).
// Tahap corong: MENJELAJAH (DESIGN.md §6 butir 4). Klip: public/video/fitur-*.mp4|webm
// direkam dari ERP dengan DATA DEMO; diputar tanpa suara saat terlihat.
// Tanpa JavaScript: ketiga panel tampil bertumpuk, tetap terbaca.
// ============================================================================
const PLAYLIST = 'https://www.youtube.com/playlist?list=PLJt7HHo40rRE';

const fitur = [
  {
    id: 'keuangan',
    tab: 'Keuangan ikut sendiri',
    judul: 'Penjualan tercatat sendiri, laba rugi tinggal klik Hitung',
    poin: [
      'Setiap penjualan, pembelian, dan pembayaran langsung masuk pembukuan (jurnal)',
      'Mau tahu untung bulan ini? Buka Laba Rugi, pilih tanggal, klik Hitung',
      'Pengaturan akun keuangan cukup sekali di awal, dan kami bantu',
    ],
    video: 'fitur-keuangan',
    tutorial: PLAYLIST,
  },
  {
    id: 'stok',
    tab: 'Stok berkurang sendiri',
    judul: 'Barang terjual, stok langsung berkurang',
    poin: [
      'Setiap penjualan mengurangi stok, setiap barang masuk menambahnya',
      'Riwayatnya lengkap: kapan, berapa, dan karena transaksi apa',
      'Stok menipis langsung diberi tanda supaya tidak kehabisan',
    ],
    video: 'fitur-stok',
    tutorial: PLAYLIST,
  },
  {
    id: 'komisi',
    tab: 'Komisi karyawan',
    judul: 'Komisi teknisi, terapis, atau tenaga penjual dihitung otomatis',
    poin: [
      'Aturan komisi diatur per produk, per peran, atau per orang',
      'Setiap penjualan yang kena komisi langsung masuk rekap karyawan yang berhak',
      'Rekap bulanan siap dibayarkan, tanpa menghitung ulang di buku',
    ],
    video: 'fitur-komisi',
    tutorial: PLAYLIST,
  },
  {
    id: 'hrd',
    tab: 'Absensi dan gaji',
    judul: 'Data karyawan, cuti, dan gaji di satu tempat',
    poin: [
      'Daftar karyawan lengkap dengan jabatan dan gaji pokok',
      'Pengajuan cuti dan izin tercatat, tinggal disetujui',
      'Gaji diproses sekali klik, slip gaji siap dicetak (paket Pro)',
    ],
    video: 'fitur-hrd',
    tutorial: PLAYLIST,
  },
  {
    id: 'pesanan',
    tab: 'Pengelolaan pesanan',
    judul: 'Pesanan dipantau dari masuk sampai selesai',
    poin: [
      'Papan pesanan: geser kartu dari antre, diproses, sampai selesai',
      'Begitu faktur (invoice) dibuat, pesanan terbentuk sendiri dan statusnya terlihat oleh tim',
      'Tabel dan laporan untuk melihat pesanan mana yang tertahan',
    ],
    video: 'fitur-pesanan',
    tutorial: PLAYLIST,
  },
];
---

<section id="fitur" class="galeri">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Lihat sendiri</span>
      <h2>Lima hal yang paling sering membuat pemilik usaha lega</h2>
      <p>Layar di bawah ini adalah <mark class="stabilo">ERP Studio sungguhan</mark> yang berisi data demo, bukan gambar rekaan.</p>
    </div>

    <div class="galeri-isi reveal" data-galeri>
      <p class="tabs-petunjuk">
        <span class="pet-lebar">Klik salah satu untuk melihat layarnya</span>
        <span class="pet-hp">Geser dan ketuk untuk melihat layar lainnya</span>
      </p>
      <div class="tabs-bungkus">
      <div class="tabs" role="tablist" aria-label="Fitur unggulan">
        {
          fitur.map((f, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${f.id}`}
              aria-controls={`panel-${f.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
            >
              <span class="tab-teks">{f.tab}</span>
              <span class="tab-aksi" aria-hidden="true">
                <span class="ta-lihat">Lihat ▸</span>
                <span class="ta-aktif">Sedang tampil</span>
              </span>
            </button>
          ))
        }
      </div>
      <span class="geser" aria-hidden="true">Geser →</span>
      </div>

      {
        fitur.map((f, i) => (
          <div
            role="tabpanel"
            id={`panel-${f.id}`}
            aria-labelledby={`tab-${f.id}`}
            class="panel"
            hidden={i !== 0}
          >
            <div class="teks">
              <h3>{f.judul}</h3>
              <ul class="checklist">
                {f.poin.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <a href={f.tutorial} class="tautan-panah" target="_blank" rel="noopener" data-sumber={`galeri-${f.id}-youtube`}>
                <IkonYoutube />Tonton tutorialnya di YouTube
              </a>
            </div>
            <figure class="layar" data-perbesar tabindex="0" aria-label="Perbesar klip layar">
              <video muted loop playsinline preload="none" poster={`/video/${f.video}.webp`} aria-label={`Cuplikan layar ERP Studio: ${f.tab} (data demo)`}>
                <source src={`/video/${f.video}.webm`} type="video/webm" />
                <source src={`/video/${f.video}.mp4`} type="video/mp4" />
              </video>
              <figcaption>DATA DEMO · layar ERP Studio asli</figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Tab + putar klip hanya saat terlihat. Tanpa JS: semua panel tampil (lihat CSS .no-js).
  document.querySelectorAll<HTMLElement>('[data-galeri]').forEach((g) => {
    const tabs = [...g.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...g.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const videos = [...g.querySelectorAll<HTMLVideoElement>('video')];
    const kurangiGerak = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const baris = g.querySelector<HTMLElement>('.tabs');
    baris?.addEventListener('scroll', () => { if (baris.scrollLeft > 24) g.querySelector('.tabs-bungkus')?.classList.add('sudah-geser'); }, { passive: true });

    const putar = (v: HTMLVideoElement | undefined) => {
      videos.forEach((x) => x !== v && x.pause());
      if (v && !kurangiGerak && !v.closest('[hidden]')) v.play().catch(() => {});
    };

    const pilih = (i: number, fokus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (fokus) tabs[i].focus();
      putar(videos[i]);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pilih(i));
      t.addEventListener('keydown', (e) => {
        const arah = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (arah) {
          e.preventDefault();
          pilih((i + arah + tabs.length) % tabs.length, true);
        }
      });
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (ents) =>
          ents.forEach((e) => {
            const v = videos[tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')];
            e.isIntersecting ? putar(v) : v?.pause();
          }),
        { threshold: 0.35 },
      ).observe(g);
    }
  });
</script>

<style>
  .galeri {
    background: var(--white);
  }
  .galeri-isi {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .galeri-isi {
      gap: 18px;
    }
  }

  /* Tab berjajar di atas supaya layar ERP di bawahnya mendapat lebar penuh (terbaca). */
  .tabs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  @media (max-width: 900px) {
    .tabs {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(200px, 1fr);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 6px;
      scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar {
      display: none;
    }
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
    padding: 16px 18px;
    border-radius: var(--radius);
    border: 1.5px solid var(--border);
    background: #fff;
    font: 600 15.5px/1.3 var(--font-body);
    color: var(--heading);
    cursor: pointer;
    scroll-snap-align: start;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  /* Petunjuk tab: ajak mengeklik; di HP beri tanda bisa digeser */
  .tabs-petunjuk {
    text-align: center;
    font-size: 14.5px;
    color: var(--text-muted);
    margin: 0 0 12px;
  }
  .pet-hp {
    display: none;
  }
  .tabs-bungkus {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }
  .tab {
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 6px;
  }
  .tab-aksi {
    font-size: 12.5px;
    font-weight: 600;
  }
  .ta-lihat {
    color: var(--green-deep);
  }
  .ta-aktif {
    display: none;
    color: var(--heading);
    background: var(--green);
    border-radius: 999px;
    padding: 2px 9px;
  }
  .tab[aria-selected='true'] .ta-lihat {
    display: none;
  }
  .tab[aria-selected='true'] .ta-aktif {
    display: inline-block;
  }
  .geser {
    display: none;
  }
  .sudah-geser .geser {
    visibility: hidden;
  }
  @media (max-width: 900px) {
    .pet-lebar {
      display: none;
    }
    .pet-hp {
      display: inline;
    }
    .tabs-bungkus::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 6px;
      width: 64px;
      pointer-events: none;
      background: linear-gradient(to right, rgba(255, 255, 255, 0), #fff 85%);
    }
    .geser {
      display: block;
      position: absolute;
      right: 6px;
      top: 50%;
      z-index: 1;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 12.5px;
      font-weight: 700;
      color: #fff;
      background: var(--oranye-deep);
      border-radius: 999px;
      padding: 5px 10px;
      box-shadow: 0 6px 14px -6px rgba(194, 65, 12, 0.6);
    }
  }
  @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
    .geser {
      animation: geser-colek 1.6s var(--ease-out) infinite;
    }
  }
  @keyframes geser-colek {
    0%, 60%, 100% {
      transform: translate(0, -50%);
    }
    30% {
      transform: translate(-8px, -50%);
    }
  }
  .tab-no {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--green-deep);
    min-width: 30px;
  }
  .tab[aria-selected='true'] {
    border-color: var(--green);
    background: rgba(46, 204, 88, 0.08);
    box-shadow: inset 4px 0 0 var(--green);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tab:hover {
      transform: translateX(3px);
      border-color: rgba(46, 204, 88, 0.5);
    }
  }

  .panel {
    display: grid;
    grid-template-columns: 0.8fr 1.9fr;
    gap: 30px;
    align-items: center;
  }
  .panel[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .panel {
      grid-template-columns: 1fr;
    }
    .panel .layar {
      order: -1;
    }
  }
  .teks h3 {
    margin-bottom: 14px;
  }
  .teks .checklist {
    margin-bottom: 18px;
  }
  .tautan-panah {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--green-deep);
    font-weight: 600;
    font-size: 15px;
  }

  .layar {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    background: #0e3d33;
  }
  .layar video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .layar figcaption {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #cfe9d8;
    background: #0e3d33;
    padding: 8px 14px;
  }

  /* Tanpa JavaScript: tab tidak bekerja, jadi tampilkan semua panel bertumpuk. */
  :global(.no-js) .panel[hidden] {
    display: grid;
  }
  :global(.no-js) .tabs {
    display: none;
  }
</style>
