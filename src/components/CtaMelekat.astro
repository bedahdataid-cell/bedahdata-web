---
// ============================================================================
// CTA MELEKAT (HP saja, < 768 px) — tahap corong: Membeli/mencoba.
// Muncul setelah pengunjung menggulir melewati layar pertama (CSS scroll-driven,
// tanpa JS). Browser lama: langsung tampil. Tidak dipasang di /beli/.
// ============================================================================
import { waLink } from '../config';
---

<div class="cta-melekat" role="region" aria-label="Mulai coba">
  <a href="/beli/?paket=gratis" class="cm-utama" data-sumber="melekat-gratis">Coba Gratis 3 Hari</a>
  <a
    href={waLink('Halo Bedah Data, saya mau tanya soal ERP Studio.')}
    class="cm-wa"
    data-sumber="melekat-wa"
    target="_blank"
    rel="noopener"
    aria-label="Tanya lewat WhatsApp">WhatsApp</a
  >
</div>

<script>
  // Sembunyikan tombol melekat saat kartu harga / tombol utama halaman sedang terlihat (audit UX 15 Nov 2026, T3):
  // sebelumnya menutup ±73 px dan menggandakan tombol di kartu Free.
  const bar = document.querySelector<HTMLElement>('.cta-melekat');
  // Kartu paket (tinggi) dan tombol hero diamati terpisah dengan margin akar, bukan rasio tampil: kartu setinggi >1 layar
  // tak pernah mencapai ambang rasio.
  const target = document.querySelectorAll('.grid-harga .kartu, .grid-paket .paket, .kepala .btn, .tombol .btn');
  if (bar && target.length && 'IntersectionObserver' in window) {
    const kelihatan = new Set<Element>();
    const io = new IntersectionObserver((daftar) => {
      daftar.forEach((e) => (e.isIntersecting ? kelihatan.add(e.target) : kelihatan.delete(e.target)));
      bar.classList.toggle('sembunyi', kelihatan.size > 0);
    }, { rootMargin: '-20% 0px -20% 0px', threshold: 0 });
    target.forEach((t) => io.observe(t));
  }
</script>

<style>
  .cta-melekat {
    display: none;
  }

  @media (max-width: 767px) {
    .cta-melekat {
      display: flex;
      gap: 10px;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid var(--border);
      box-shadow: 0 -10px 30px -18px rgba(14, 61, 51, 0.35);
    }
    .cta-melekat a {
      flex: 1;
      text-align: center;
      padding: 12px 10px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 15px;
      text-decoration: none;
    }
    .cm-utama {
      background: var(--green);
      color: #0e3d33;
    }
    .cm-wa {
      flex: 0 0 40% !important;
      border: 1.5px solid var(--heading);
      color: var(--heading);
    }
    .cta-melekat.sembunyi {
      animation: none;
      transform: translateY(110%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.2s, opacity 0.2s;
    }
    :global(body) {
      padding-bottom: 72px;
    }

    @supports (animation-timeline: scroll()) {
      @media (prefers-reduced-motion: no-preference) {
        .cta-melekat {
          animation: cm-muncul linear both;
          animation-timeline: scroll(root);
          animation-range: 0 420px;
        }
      }
    }
  }

  @keyframes cm-muncul {
    0%,
    60% {
      transform: translateY(110%);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }
</style>
