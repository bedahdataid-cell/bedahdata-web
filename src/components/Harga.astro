---
// ============================================================================
// KARTU HARGA — dipakai di beranda & halaman /harga.
// 🔴 Angka diambil dari src/config.ts. Jangan menulis harga langsung di sini,
//    supaya tidak ada dua versi harga yang berbeda di situs yang sama.
// ============================================================================
import { PAKET, tautanBeli } from '../config';
import type { Bahasa } from '../i18n/ui';

interface Props {
  bahasa?: Bahasa;
}

const { bahasa = 'id' } = Astro.props;
const en = bahasa === 'en';
const labelRekomendasi = en ? 'Our Recommendation' : 'Rekomendasi kami';
---

<div class="grid-harga">
  {
    PAKET.map((paket) => (
      <div class={`kartu reveal ${paket.populer ? 'populer' : ''}`}>
        {paket.populer && <span class="badge">{labelRekomendasi}</span>}
        <h3>{paket.nama}</h3>
        <p class="harga">
          {/* 🔴 Harga TETAP Rupiah di kedua bahasa — pembacanya tetap di
              Indonesia. Hanya "Hubungi Kami" pada paket Custom yang punya
              padanan Inggris. */}
          {en && 'hargaEn' in paket ? paket.hargaEn : paket.harga}
          <small>{en ? paket.satuanEn : paket.satuan}</small>
        </p>
        <p class="untuk">{en ? paket.untukEn : paket.untuk}</p>
        <ul class="checklist">
          {(en ? paket.fiturEn : paket.fitur).map((f) => (
            <li>{f}</li>
          ))}
        </ul>
        <a
          href={en ? tautanBeli(paket.kunci, en) : `/beli/?paket=${paket.kunci}`}
          class={`btn ${paket.populer ? 'btn-primary' : 'btn-ghost'}`}
          target={en ? '_blank' : undefined}
          rel={en ? 'noopener' : undefined}
          data-sumber={`harga-${paket.kunci}`}
        >
          {en ? paket.ctaEn : paket.cta}
        </a>
      </div>
    ))
  }
</div>

<style>
  .grid-harga {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .grid-harga {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-inline: auto;
    }
  }

  .kartu {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .kartu.populer {
    border-color: var(--green);
    box-shadow: 0 14px 36px -16px rgba(46, 204, 88, 0.4);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .kartu:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
    }
  }

  .badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--oranye);
    color: var(--heading);
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 18px;
    border-radius: 999px;
    white-space: nowrap;
  }

  h3 {
    font-family: var(--font-body);
    font-size: 21px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .harga {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 34px);
    font-weight: 600;
    color: var(--green-deep);
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .harga small {
    display: block;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 400;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .untuk {
    font-size: 14.5px;
    color: var(--text-muted);
    margin-bottom: 20px;
    min-height: 3.6em; /* menyamakan tinggi antar kartu di layar lebar */
  }

  @media (max-width: 900px) {
    .untuk {
      min-height: 0;
    }
  }

  .checklist {
    margin-bottom: 26px;
    flex-grow: 1;
  }

  .kartu .btn {
    width: 100%;
  }
</style>
