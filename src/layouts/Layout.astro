---
// ============================================================================
// LAYOUT DASAR — dipakai SEMUA halaman.
// Berisi: meta SEO, Open Graph, data terstruktur, header, footer, dan
// animasi masuk saat digulir.
// ============================================================================
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Gambar untuk pratinjau saat dibagikan di WhatsApp/Facebook. */
  ogImage?: string;
  /** Jenis konten — 'article' khusus untuk halaman artikel panduan. */
  ogType?: 'website' | 'article';
  /** Data terstruktur tambahan (JSON-LD) khusus halaman ini. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Setel true untuk menyembunyikan halaman dari hasil pencarian. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/assets/logo-bedahdata.png',
  ogType = 'website',
  schema,
  noindex = false,
} = Astro.props;

// Alamat halaman ini, dihitung dari `site` di astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || SITE.url;
const ogImageAbs = new URL(ogImage, Astro.site).href;

// --- Data terstruktur yang selalu ada di setiap halaman ---------------------
// 🔴 SENGAJA tidak ada "aggregateRating"/"review": klien komersial masih nol,
//    dan rating karangan melanggar pedoman Google sekaligus aturan kejujuran.
const baseSchema = [
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    legalName: SITE.legalName,
    url: `${SITE.url}/`,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.url}/assets/logo-bedahdata.png`,
      width: 512,
      height: 512,
    },
    description: SITE.description,
    email: SITE.email,
    foundingDate: '2026',
    knowsLanguage: 'id',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+62-851-8824-4786',
      contactType: 'customer service',
      areaServed: 'ID',
      availableLanguage: ['Indonesian'],
    },
    areaServed: { '@type': 'Country', name: 'Indonesia' },
    sameAs: [
      'https://instagram.com/bedahdata.id',
      'https://facebook.com/Bedahdata.id',
      'https://tiktok.com/@bedahdata',
      'https://youtube.com/@bedahdata_id',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    inLanguage: 'id-ID',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = { '@context': 'https://schema.org', '@graph': [...baseSchema, ...extra] };
---

<!doctype html>
<html lang="id" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0E3D33" />
    <meta name="geo.region" content="ID" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }

    <!-- Pratinjau saat dibagikan (WhatsApp, Facebook, Instagram) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={`${SITE.name} — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />

    <!-- Font: Poppins (badan teks & UI) + Fraunces (judul besar).
         display=swap supaya teks langsung terbaca walau font belum selesai
         diunduh — penting di jaringan lambat. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a href="#konten" class="skip-link">Lompat ke isi halaman</a>
    <Header />
    <main id="konten">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Tandai bahwa JavaScript aktif. Kalau baris ini tidak jalan, aturan
      // .no-js di CSS memastikan semua konten tetap terlihat.
      document.documentElement.classList.remove('no-js');
    </script>

    <script>
      // ======================================================================
      // ANIMASI MASUK SAAT DIGULIR
      // Memakai Intersection Observer bawaan browser — tanpa library, tanpa
      // unduhan tambahan. Cukup untuk fade-up halus yang kita butuhkan.
      // ======================================================================
      const kurangiGerak = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (kurangiGerak || !('IntersectionObserver' in window)) {
        // Pengguna minta gerakan dikurangi, atau browser terlalu lama:
        // tampilkan semuanya langsung tanpa animasi.
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target); // animasi cukup sekali
              }
            });
          },
          // rootMargin bawah negatif: animasi mulai saat elemen benar-benar
          // masuk pandangan, bukan saat masih jauh di bawah layar.
          { threshold: 0, rootMargin: '0px 0px -12% 0px' },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
