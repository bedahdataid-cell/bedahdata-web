---
// ============================================================================
// LAYOUT DASAR — dipakai SEMUA halaman.
// Berisi: meta SEO, Open Graph, data terstruktur, header, footer, dan
// animasi masuk saat digulir.
// ============================================================================
import { SITE, META_PIXEL_ID, GA_ID } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaMelekat from '../components/CtaMelekat.astro';
import { BAHASA, bahasaDari, jalur, jalurNetral, t } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Gambar untuk pratinjau saat dibagikan di WhatsApp/Facebook. */
  ogImage?: string;
  /** Jenis konten — 'article' khusus untuk halaman artikel panduan. */
  ogType?: 'website' | 'article';
  /** Data terstruktur tambahan (JSON-LD) khusus halaman ini. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Setel true untuk menyembunyikan halaman dari hasil pencarian. */
  noindex?: boolean;
  /**
   * Setel false kalau halaman ini TIDAK punya pasangan di bahasa lain.
   * Kalau false: tombol ganti bahasa disembunyikan dan hreflang tidak
   * ditulis — 🔴 menunjuk hreflang ke halaman yang 404 lebih buruk
   * daripada tidak menulisnya sama sekali.
   */
  adaTerjemahan?: boolean;
}

const {
  title,
  description,
  ogImage = '/assets/logo-bedahdata.png',
  ogType = 'website',
  schema,
  noindex = false,
  // 13 Nov 2026: default false — pages/en belum ada, pengalih bahasa menuju /en/ = 404 di situs live.
  // Ubah ke true (atau kirim adaTerjemahan={true}) hanya setelah halaman Inggrisnya benar-benar ada.
  adaTerjemahan = false,
} = Astro.props;

// --- Bahasa halaman ini, dibaca dari alamatnya -----------------------------
const bahasa = bahasaDari(Astro.url.pathname);
const info = BAHASA[bahasa];
const teks = t(bahasa);

// Jalur tanpa awalan bahasa — dipakai untuk membuat pasangan hreflang.
const netral = jalurNetral(Astro.url.pathname);
const urlId = new URL(jalur(netral, 'id'), Astro.site).href;
const urlEn = new URL(jalur(netral, 'en'), Astro.site).href;

// Alamat halaman ini, dihitung dari `site` di astro.config.mjs.
// 🔴 JANGAN tambahkan .replace(/\/$/, '') di sini — garis miring di akhir
//    harus DIPERTAHANKAN. Cloudflare menyajikan /harga/index.html di alamat
//    /harga/ dan memaksa redirect 307 dari /harga. Kalau canonical menulis
//    /harga (tanpa garis miring), Google menerima dua sinyal bertabrakan:
//    sitemap menunjuk /harga/, canonical menunjuk /harga, server menjawab 307.
//    Selaras dengan trailingSlash: 'always' di astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;

// --- Data terstruktur yang selalu ada di setiap halaman ---------------------
// 🔴 SENGAJA tidak ada "aggregateRating"/"review": klien komersial masih nol,
//    dan rating karangan melanggar pedoman Google sekaligus aturan kejujuran.
const baseSchema = [
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    legalName: SITE.legalName,
    url: `${SITE.url}/`,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.url}/assets/logo-bedahdata.png`,
      width: 512,
      height: 512,
    },
    description: bahasa === 'en' ? SITE.descriptionEn : SITE.description,
    email: SITE.email,
    foundingDate: '2026',
    knowsLanguage: 'id',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+62-851-8824-4786',
      contactType: 'customer service',
      areaServed: 'ID',
      availableLanguage: ['Indonesian'],
    },
    areaServed: { '@type': 'Country', name: 'Indonesia' },
    sameAs: [
      'https://instagram.com/bedahdata.id',
      'https://facebook.com/Bedahdata.id',
      'https://tiktok.com/@bedahdata',
      'https://youtube.com/@bedahdata_id',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    inLanguage: info.ogLocale.replace('_', '-'),
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = { '@context': 'https://schema.org', '@graph': [...baseSchema, ...extra] };
---

<!doctype html>
<html lang={info.htmlLang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      /* --- hreflang: memberi tahu Google kedua versi bahasa ini bersaudara.
         🔴 Ditulis DUA ARAH — halaman ID menunjuk EN dan sebaliknya. Kalau
            hanya satu arah, Google mengabaikannya.
         🔴 Hanya ditulis kalau halaman ini memang punya pasangan; menunjuk
            ke alamat yang 404 lebih buruk daripada tidak menulis apa pun.
         x-default menunjuk versi Indonesia — pembaca utama kami. */
      adaTerjemahan && (
        <>
          <link rel="alternate" hreflang="id" href={urlId} />
          <link rel="alternate" hreflang="en" href={urlEn} />
          <link rel="alternate" hreflang="x-default" href={urlId} />
        </>
      )
    }

    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0E3D33" />
    <meta name="geo.region" content="ID" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }

    <!-- Pratinjau saat dibagikan (WhatsApp, Facebook, Instagram) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={info.ogLocale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={`${SITE.name} — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />

    <!-- Font: Poppins (badan teks & UI) + Fraunces (judul besar).
         display=swap supaya teks langsung terbaca walau font belum selesai
         diunduh — penting di jaringan lambat. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      /* GOOGLE ANALYTICS 4 — dimuat hanya bila GA_ID terisi (config.ts). 🔴 Skrip inline TIDAK boleh memakai
         `define:vars` bersama `is:inline` (JavaScript rusak diam-diam); ID disuntik langsung lewat set:html. */
      GA_ID && (
        <Fragment>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}
          />
        </Fragment>
      )
    }

    {
      /* ====================================================================
         META PIXEL — hanya dimuat kalau META_PIXEL_ID sudah diisi di
         config.ts. Selama kosong, blok ini tidak ikut ter-render sama sekali:
         nol permintaan jaringan, nol error.

         🔴 Event yang dipakai (SPEK_TOOLS_GRATIS_WEB §6):
            PageView  — otomatis di sini
            Lead      — saat hasil kalkulator keluar  (dipicu Kalkulator.astro)
            Contact   — saat tombol WhatsApp diklik   (dipicu tautan .lacak-wa)
         ==================================================================== */
      META_PIXEL_ID && (
        <Fragment>
          <script
            is:inline
            set:html={`
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${META_PIXEL_ID}');
fbq('track', 'PageView');`}
          />
          <noscript>
            <img
              height="1"
              width="1"
              style="display:none"
              alt=""
              src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
            />
          </noscript>
        </Fragment>
      )
    }
  </head>

  <body>
    <a href="#konten" class="skip-link">{teks.lompatKonten}</a>
    <Header bahasa={bahasa} adaTerjemahan={adaTerjemahan} />
    <main id="konten">
      <slot />
    </main>
    <Footer bahasa={bahasa} />
    {bahasa === 'id' && !Astro.url.pathname.startsWith('/beli') && <CtaMelekat />}

    <script is:inline>
      // Tandai bahwa JavaScript aktif. Kalau baris ini tidak jalan, aturan
      // .no-js di CSS memastikan semua konten tetap terlihat.
      document.documentElement.classList.remove('no-js');
    </script>

    <script>
      // ======================================================================
      // EVENT `Contact` — setiap tautan WhatsApp di seluruh situs.
      // Dipasang sekali di sini (event delegation), bukan satu per satu di
      // tiap tombol — jadi tombol WA baru otomatis ikut terlacak tanpa perlu
      // diingat. Kalau pixel belum dipasang, fbq tidak ada dan blok ini
      // diam saja tanpa error.
      // ======================================================================
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const tautan = target?.closest?.('a[href*="wa.me"]');
        if (!tautan) return;

        const fbq = (window as any).fbq;
        if (typeof fbq !== 'function') return;

        // `sumber` diisi manual di halaman alat supaya di Events Manager
        // terlihat tombol WA mana yang diklik.
        // `Contact` adalah event BAKU Meta (bukan custom) — dipakai apa
        // adanya supaya bisa dijadikan tujuan optimasi kampanye nanti.
        fbq('track', 'Contact', {
          content_name: tautan.getAttribute('data-sumber') || 'umum',
        });
      });
    </script>

    <script>
      // ======================================================================
      // FUNNEL GA4 — satu pendengar klik untuk seluruh situs (event delegation). Tidak melacak isi ketikan,
      // hanya jenis tautan yang diklik. Tanpa gtag (GA_ID kosong / diblokir) blok ini diam saja.
      //   klik_wa          tombol/tautan WhatsApp                (param: sumber, halaman)
      //   ke_halaman_beli  menuju /beli/                          (param: paket, sumber)
      //   ke_checkout      menuju checkout Lynk                   (param: paket, sumber)  ← KEY EVENT
      //   video_klik       tautan YouTube                         (param: judul, id)
      //   video_putar      putar-di-tempat di /tutorial/          (param: judul, id)
      //   cta_klik         tautan apa pun ber-`data-sumber`       (param: sumber)
      // Event dari halaman lain memakai window.lacakBD(nama, param) — mis. /belajar/.
      // ======================================================================
      const kirim = (nama: string, param: Record<string, unknown> = {}) => {
        const g = (window as any).gtag;
        if (typeof g === 'function') g('event', nama, { halaman: location.pathname, ...param });
      };
      (window as any).lacakBD = kirim;
      const paketDari = (sumber: string, href: string) => {
        const dariSumber = sumber.match(/(gratis|standar|pro)$/);
        if (dariSumber) return dariSumber[1];
        try { return new URL(href, location.href).searchParams.get('paket') || ''; } catch { return ''; }
      };
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement | null)?.closest?.('a') as HTMLAnchorElement | null;
        if (!a) return;
        const href = a.getAttribute('href') || '';
        const sumber = a.getAttribute('data-sumber') || '';
        if (a.classList.contains('putar')) kirim('video_putar', { judul: a.dataset.judul || '', id: a.dataset.id || '' });
        else if (/youtube\.com|youtu\.be/.test(href)) kirim('video_klik', { judul: a.textContent?.trim().slice(0, 80) || '', id: (href.match(/(?:v=|youtu\.be\/)([\w-]{11})/) || [])[1] || '' });
        if (href.includes('wa.me')) kirim('klik_wa', { sumber });
        if (/^\/beli\//.test(href)) kirim('ke_halaman_beli', { paket: paketDari(sumber, href), sumber });
        if (href.includes('lynk.id')) kirim('ke_checkout', { paket: paketDari(sumber, href), sumber });
        if (sumber) kirim('cta_klik', { sumber });
      });
    </script>

    <script>
      // ======================================================================
      // KARTU MIRING + SOROTAN KURSOR (DESIGN.md §4) — desktop saja.
      // Hanya mengisi variabel CSS; gerak & tampilannya diatur di global.css.
      // ======================================================================
      const pointerHalus = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const gerakBoleh = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (pointerHalus && gerakBoleh) {
        document.addEventListener(
          'pointermove',
          (e) => {
            const el = (e.target as HTMLElement | null)?.closest?.('.card-lift') as HTMLElement | null;
            if (!el) return;
            const r = el.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width;
            const py = (e.clientY - r.top) / r.height;
            el.style.setProperty('--mx', `${px * 100}%`);
            el.style.setProperty('--my', `${py * 100}%`);
            el.style.setProperty('--ry', `${(px - 0.5) * 6}deg`);
            el.style.setProperty('--rx', `${(0.5 - py) * 6}deg`);
          },
          { passive: true },
        );
        document.addEventListener(
          'pointerout',
          (e) => {
            const el = (e.target as HTMLElement | null)?.closest?.('.card-lift') as HTMLElement | null;
            if (el) ['--rx', '--ry'].forEach((v) => el.style.removeProperty(v));
          },
          { passive: true },
        );
      }
    </script>

    <script>
      // ======================================================================
      // ANIMASI MASUK SAAT DIGULIR
      // Memakai Intersection Observer bawaan browser — tanpa library, tanpa
      // unduhan tambahan. Cukup untuk fade-up halus yang kita butuhkan.
      // ======================================================================
      const kurangiGerak = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (kurangiGerak || !('IntersectionObserver' in window)) {
        // Pengguna minta gerakan dikurangi, atau browser terlalu lama:
        // tampilkan semuanya langsung tanpa animasi.
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target); // animasi cukup sekali
              }
            });
          },
          // rootMargin bawah negatif: animasi mulai saat elemen benar-benar
          // masuk pandangan, bukan saat masih jauh di bawah layar.
          { threshold: 0, rootMargin: '0px 0px -12% 0px' },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
    <!-- Penampil perbesar: klik gambar/klip ber-[data-perbesar] untuk melihat besar -->
    <dialog id="perbesar" class="perbesar" aria-label="Tampilan diperbesar">
      <button type="button" class="perbesar-tutup" aria-label="Tutup">✕</button>
      <div class="perbesar-isi"></div>
      <p class="perbesar-ket"><span class="pk-lebar">Klik di mana saja atau tekan Esc untuk menutup</span><span class="pk-hp">Geser ke samping untuk melihat semua. Ketuk ✕ untuk menutup.</span></p>
    </dialog>
    <script>
      const d = document.getElementById('perbesar') as HTMLDialogElement | null;
      const isi = d?.querySelector('.perbesar-isi');
      const buka = (el: HTMLElement) => {
        if (!d || !isi || typeof d.showModal !== 'function') return;
        const v = el.querySelector('video');
        const img = el.querySelector('img');
        let baru: HTMLElement | null = null;
        if (v) {
          const nv = document.createElement('video');
          nv.src = v.currentSrc || v.querySelector('source')?.getAttribute('src') || '';
          nv.muted = true; nv.loop = true; nv.autoplay = true; nv.playsInline = true; nv.controls = true;
          baru = nv;
        } else if (img) {
          const ni = document.createElement('img');
          ni.src = img.currentSrc || img.src; ni.alt = img.alt;
          baru = ni;
        }
        if (!baru) return;
        isi.replaceChildren(baru);
        d.showModal();
        if (baru instanceof HTMLVideoElement) baru.play().catch(() => {});
      };
      document.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest<HTMLElement>('[data-perbesar]');
        if (t && !(e.target as HTMLElement).closest('a')) { e.preventDefault(); buka(t); }
      });
      document.addEventListener('keydown', (e) => {
        const t = (e.target as HTMLElement).closest?.<HTMLElement>('[data-perbesar]');
        if (t && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); buka(t); }
      });
      d?.addEventListener('click', (e) => {
        const hp = matchMedia('(max-width: 700px)').matches;
        if (!hp || !(e.target as HTMLElement).closest('.perbesar-isi')) d.close();
      });
      d?.addEventListener('close', () => isi?.replaceChildren());
    </script>
  </body>
</html>
